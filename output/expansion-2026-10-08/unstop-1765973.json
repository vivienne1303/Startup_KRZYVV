{"data":{"status":true,"competition":{"id":1765973,"visibility":"public","theme_colour":"amber-dark_un","paid":0,"title":"Agnirakshak - Autonomous Fire Fighting Bot Challenge.","festival_id":521740,"organization_id":17467,"web_url":null,"start_date":"2026-10-08T00:00:00+05:30","end_date":"2026-10-29T15:45:00+05:30","location":null,"type":"competitions","public_url":"competitions\/agnirakshak-autonomous-fire-extinguisher-bot-challenge-crescendo-robix-frcrce-1765973","region":"offline","details":"<p><strong>AGNIRAKSHAK<\/strong> is an autonomous firefighting robotics competition that challenges participants to design and build a robot capable of independently navigating a specially designed obstacle arena, detecting and extinguishing four candle-based fire sources, and reaching the designated finish zone in the shortest possible time.<\/p>\n<p>The competition tests participants on robotics, autonomous navigation, sensing, control systems, and problem-solving. The robot must operate completely autonomously once the run begins, without any manual control or physical assistance from the team.<\/p>\n<p><strong>Eligibility &amp; Team Formation<\/strong><\/p>\n<ul>\n<li>The competition is open to students with an interest in robotics, automation, and engineering.<\/li>\n<li>Teams must consist of 2-3 members<\/li>\n<li>Each team must register with a unique team name and designated team members.<\/li>\n<li>Participants must carry a valid college\/institution ID for verification.<\/li>\n<\/ul>\n<p><strong>Competition Format<\/strong><\/p>\n<ul>\n<li>The competition will be conducted in two rounds:<\/li>\n<\/ul>\n<p><strong>Round 1 &ndash; Qualifying Round<\/strong><\/p>\n<ul>\n<li>16 teams will compete.<\/li>\n<li>Each team gets one run.<\/li>\n<li>The robot must navigate the arena, locate and extinguish the fire sources, and reach the finish zone.<\/li>\n<li>The top 8 teams will qualify for the final round based on the competition ranking criteria.<\/li>\n<\/ul>\n<p><strong>Round 2 &ndash; Final Round<\/strong><\/p>\n<ul>\n<li>The top 8 teams will compete.<\/li>\n<li>Each finalist gets up to two valid runs.<\/li>\n<li>A team's better run will be considered for the final ranking.<\/li>\n<li>Teams will be ranked primarily on the number of candles extinguished, followed by total time and number of penalties.<\/li>\n<\/ul>\n<p><strong>Objective<\/strong><\/p>\n<ul>\n<li>The robot must:<\/li>\n<li>Navigate the arena autonomously.<\/li>\n<li>Detect and locate the designated candle-based fire sources.<\/li>\n<li>Extinguish up to four candles.<\/li>\n<li>Successfully reach the finish zone.<\/li>\n<li>Complete the challenge within the prescribed time limit<\/li>\n<\/ul>\n<p><strong>Scoring &amp; Penalties<\/strong><\/p>\n<ul>\n<li>Ranking priority will be:<\/li>\n<li>Number of candles extinguished &ndash; Higher is better.<\/li>\n<li>Total time taken &ndash; Lower is better.<\/li>\n<li>Number of penalties &ndash; Lower is better.<\/li>\n<\/ul>","overall_prizes":"","regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":33503862,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-05T12:45:49+05:30","updated_at":"2026-10-08T08:20:02+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"innovation_challenge","combined_leaderboard":null,"source":null,"short_id":"kc042OQ","hashtags":null,"participation_certificate":1,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":2,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":0,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-06 14:26:25","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":