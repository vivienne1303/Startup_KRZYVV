{"data":{"status":true,"competition":{"id":1766915,"visibility":"public","theme_colour":"light-blue_un","paid":0,"title":"Entrexpo 5.0","festival_id":null,"organization_id":534,"web_url":null,"start_date":"2026-10-07T19:30:56+05:30","end_date":"2026-11-02T18:30:26+05:30","location":null,"type":"competitions","public_url":"competitions\/entrexpo-50-ibs-hyderabad-1766915","region":"hybrid","details":"<p><strong>Entrexpo 5.0 | The Ultimate Startup &amp; Innovation Exhibition<\/strong><\/p>\n<p><strong data-path-to-node=\"1\" data-index-in-node=\"0\">Entrexpo 5.0<\/strong> is the flagship one-day exhibition platform designed to showcase ground-breaking student ventures, early-stage startups, and innovative products\/services. Present your vision, demonstrate live prototypes, pitch to investors, and gain direct market validation.<\/p>\n<p><strong>Guidelines &amp; Team Composition<\/strong><\/p>\n<p><strong>Eligibility<\/strong><\/p>\n<ul data-path-to-node=\"5\">\n<li><strong data-path-to-node=\"5,0,0\" data-index-in-node=\"0\">Student Startups:<\/strong> Open to undergraduate, postgraduate, and diploma students with an active startup idea, prototype, or launched product.<\/li>\n<li><strong data-path-to-node=\"5,1,0\" data-index-in-node=\"0\">Early-Stage &amp; Independent Entrepreneurs:<\/strong> Open to early-stage founders, innovators, and registered or unregistered startups looking to showcase their offerings.<\/li>\n<li><strong data-path-to-node=\"5,2,0\" data-index-in-node=\"0\">Specialization:<\/strong> Open to all academic domains (Engineering, Management, Design, Sciences, Arts, etc.).<\/li>\n<\/ul>\n<p><strong>Team Rules<\/strong><\/p>\n<ul data-path-to-node=\"7\">\n<li><strong data-path-to-node=\"7,0,0\" data-index-in-node=\"0\">Team Size:<\/strong> 1 to 4 members per startup<\/li>\n<li><strong data-path-to-node=\"7,3,0\" data-index-in-node=\"0\">Multiple Submissions:<\/strong> A participant cannot be part of more than one team pitching different startups.<\/li>\n<\/ul>\n<p>Event Format &amp; Round Details<\/p>\n<table style=\"width: 92.6601%; height: 291px;\" data-path-to-node=\"9\">\n<thead>\n<tr style=\"height: 36px;\">\n<td style=\"width: 13.2701%; text-align: center; height: 41px;\"><strong>Round<\/strong><\/td>\n<td style=\"width: 10.5884%; text-align: center; height: 41px;\"><strong>Stage Name<\/strong><\/td>\n<td style=\"width: 12.4266%; text-align: center; height: 41px;\"><strong>Format<\/strong><\/td>\n<td style=\"width: 25.3762%; text-align: center; height: 41px;\"><strong>Duration \/ Details<\/strong><\/td>\n<td style=\"width: 35.8658%; text-align: center; height: 41px;\"><strong>Description<\/strong><\/td>\n<\/tr>\n<\/thead>\n<tbody>\n<tr style=\"height: 125px;\">\n<td style=\"width: 13.2701%; text-align: center; height: 125px;\"><span data-path-to-node=\"9,1,0,0\"><strong data-path-to-node=\"9,1,0,0\" data-index-in-node=\"0\">&nbsp;1<\/strong><\/span><\/td>\n<td style=\"width: 10.5884%; text-align: center; height: 125px;\"><span data-path-to-node=\"9,1,1,0\">Online Pitch Deck Screening<\/span><\/td>\n<td style=\"width: 12.4266%; text-align: center; height: 125px;\"><span data-path-to-node=\"9,1,2,0\">Online Submission<\/span><\/td>\n<td style=\"width: 25.3762%; text-align: center; height: 125px;\"><span data-path-to-node=\"9,1,3,0\">Submission Closes: <strong data-path-to-node=\"9,1,3,0\" data-index-in-node=\"19\">October 25, 2026<\/strong><\/span><\/td>\n<td style=\"width: 35.8658%; text-align: center; height: 125px;\"><span data-path-to-node=\"9,1,4,0\">Screening round where teams submit a concise <strong data-path-to-node=\"9,1,4,0\" data-index-in-node=\"45\">Pitch Deck<\/strong>.<\/span><\/td>\n<\/tr>\n<tr style=\"height: 125px;\">\n<td style=\"width: 13.2701%; text-align: center; height: 125px;\"><span data-path-to-node=\"9,2,0,0\"><strong data-path-to-node=\"9,2,0,0\" data-index-in-node=\"0\">&nbsp;2<\/strong><\/span><\/td>\n<td style=\"width: 10.5884%; text-align: center; height: 125px;\"><span data-path-to-node=\"9,2,1,0\">On-Campus Startup Exhibition<\/span><\/td>\n<td style=\"width: 12.4266%; text-align: center; height: 125px;\"><span data-path-to-node=\"9,2,2,0\">In-Person Exhibition<\/span><\/td>\n<td style=\"width: 25.3762%; text-align: center; height: 125px;\"><span data-path-to-node=\"9,2,3,0\"><strong data-path-to-node=\"9,2,3,0\" data-index-in-node=\"0\">November 2, 2026<\/strong> (1-Day Event)<\/span><\/td>\n<td style=\"width: 35.8658%; text-align: center; height: 125px;\"><span data-path-to-node=\"9,2,4,0\">Shortlisted startups set up display booths to showcase products, deliver live demos, interact with visitors, and pitch to visiting VCs and investors.<\/span><\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<p><strong>Rules &amp; Regulations<\/strong><\/p>\n<p>Screening &amp; Pitch Deck Submission<\/p>\n<ul data-path-to-node=\"13\">\n<li>All teams must submit a <strong data-path-to-node=\"13,0,0\" data-index-in-node=\"24\">Pitch Deck <\/strong>(in PDF format).<\/li>\n<li>Suggested 5-Slide Structure:\n<ol start=\"1\" data-path-to-node=\"13,1,1\">\n<li>Problem Statement and Proposed Solution<\/li>\n<li>Market Analysis and Target Audience<\/li>\n<li>Business Model and Revenue Generation<\/li>\n<li>Marketing and Growth Strategy<\/li>\n<li>Financial Projections and Funding Requirements<\/li>\n<\/ol>\n<\/li>\n<li><strong>Pitch deck submissions submitted after the deadline will not be evaluated.<\/strong><\/li>\n<\/ul>\n<p><strong>Exhibition &amp; Booth Operations<\/strong><\/p>\n<ul data-path-to-node=\"15\">\n<li>Shortlisted teams will be allocated a standard stall on <strong>November 2<\/strong><strong data-path-to-node=\"15,0,0\" data-index-in-node=\"73\">, 2026<\/strong>.<\/li>\n<li>Teams are responsible for bringing their own prototypes, laptops, banners, and promotional merchandise (brochures, standees, flyers).<\/li>\n<li>Power outlets and basic display infrastructure will be provided. Any extra technical requirements must be requested in advance.<\/li>\n<li>Live demonstrations are strongly encouraged.<\/li>\n<\/ul>\n<p><strong>Code of Conduct &amp; Integrity<\/strong><\/p>\n<ul data-path-to-node=\"17\">\n<li>All submitted concepts and products must be authentic and original work of the registering team. Plagiarism or misrepresentation of intellectual property will lead to immediate disqualification.<\/li>\n<li>Participating teams must maintain decorum throughout the exhibition day and adhere to the venue guidelines.<\/li>\n<li>Direct safety hazards, flammable materials, or illegal substances are strictly prohibited inside the campus<\/li>\n<\/ul>\n<p><strong>Rewards &amp; Opportunities<\/strong><\/p>\n<ul data-path-to-node=\"20\">\n<li><strong data-path-to-node=\"20,0,0\" data-index-in-node=\"0\">Investor Funding &amp; Investment:<\/strong> Venture Capitalists (VCs), Angel Investors, and Industry Leaders will attend the exhibition to evaluate participating startups. Exceptional startups may receive <strong data-path-to-node=\"20,0,0\" data-index-in-node=\"192\">cash investment, equity funding, or subsidiary support<\/strong> directly from interested investors.<\/li>\n<li><strong data-path-to-node=\"20,1,0\" data-index-in-node=\"0\">Certificates:<\/strong> Official Participation Certificates issued by the organizing committee to all exhibiting teams.<\/li>\n<li><strong data-path-to-node=\"20,2,0\" data-index-in-node=\"0\">Networking &amp; Ecosystem Access:<\/strong> Direct access to ecosystem mentors, industry experts, potential co-founders, and early adopters.<\/li>\n<li><strong data-path-to-node=\"20,3,0\" data-index-in-node=\"0\">Media Visibility:<\/strong> Featured spots across our official social media channels, event brochures, and media releases.<\/li>\n<\/ul>\n<p><strong>Timeline &amp; Important Dates<\/strong><\/p>\n<ul>\n<li><strong data-path-to-node=\"23,0,0\" data-index-in-node=\"0\">Registration Opens:<\/strong>&nbsp;October 7, 2026<\/li>\n<li><strong data-path-to-node=\"23,1,0\" data-index-in-node=\"0\">Pitch Deck Submission Deadline: <\/strong>October 25 2026<\/li>\n<li><strong data-path-to-node=\"23,2,0\" data-index-in-node=\"0\">Shortlist Announcement:<\/strong> October 26, 2026<\/li>\n<li><strong data-path-to-node=\"23,3,0\" data-index-in-node=\"0\">Exhibition Setup &amp; Briefing:<\/strong> November 1, 2026 \/ Morning of November 2, 2026<\/li>\n<li><strong data-path-to-node=\"23,4,0\" data-index-in-node=\"0\">Main Event (Entrexpo 5.0 Exhibition):<\/strong> <strong data-path-to-node=\"23,4,0\" data-index-in-node=\"38\">November 2, 2026<\/strong><\/li>\n<\/ul>","overall_prizes":"","regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":23403013,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-06T22:42:25+05:30","updated_at":"2026-10-06T23:45:37+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"IQw5mTE","hashtags":null,"participation_certificate":1,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":1,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":16,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-06 22:42:25","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":false,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/6ac53ab323328_","logoUrl2":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/150x150\/6ac53ab323328_","regnRequirements":{"id":2498592,"opportunity_id":1766915,"festival_id":null,"max_team_size":4,"min_team_size":1,"