{"data":{"status":true,"competition":{"id":1767347,"visibility":"public","theme_colour":"amber-dark_un","paid":0,"title":"AI Arena by Udaan | Concetto '26","festival_id":519255,"organization_id":13183,"web_url":"www.concetto.in\/","start_date":"2026-10-07T00:00:00+05:30","end_date":"2026-10-10T17:00:00+05:30","location":null,"type":"quizzes","public_url":"quiz\/ai-arena-concetto-26-indian-institute-of-technology-indian-school-of-mines-iit-ism-dhanbad-1767347","region":"offline","details":"<div id=\"model-response-message-contentr_29da85927917f9ad\" class=\"markdown markdown-main-panel md-content enable-luminous-fast-follows enable-updated-hr-color tutor-markdown-rendering\" dir=\"ltr\" aria-busy=\"false\" aria-live=\"polite\">\n<div><strong data-path-to-node=\"2\" data-index-in-node=\"0\">Welcome to the \"AI Arena by Udaan\"<\/strong><\/div>\n<br \/>\n<div>Think you can outsmart AI? Brought to you by <strong data-path-to-node=\"3\" data-index-in-node=\"45\">Udaan &mdash; the official Career Club of IIT (ISM) Dhanbad<\/strong>, this is the ultimate 60-minute rapid sprint happening as part of Concetto '26.<\/div>\n<br \/>\n<div>Here&rsquo;s the best part: <strong data-path-to-node=\"4\" data-index-in-node=\"22\">You don't need to know how to code!<\/strong> Whether you're an AI enthusiast or just love solving logical puzzles, this arena is open for you. We are testing your real-world AI awareness, critical thinking, and eye for detail.<\/div>\n<br \/>\n<div><strong data-path-to-node=\"5\" data-index-in-node=\"0\">What&rsquo;s waiting for you inside the Arena?<\/strong><\/div>\n<br \/>\n<ul data-path-to-node=\"6\">\n<li>\n<div>\ufe0f&zwj;\ufe0f<strong data-path-to-node=\"6,0,0\" data-index-in-node=\"7\">Spot the Deepfake:<\/strong> Can your eyes catch what&rsquo;s real and what&rsquo;s an AI clone?<\/div>\n<\/li>\n<li>\n<div><strong data-path-to-node=\"6,1,0\" data-index-in-node=\"3\">Catch the Hallucination:<\/strong> AI lies sometimes. Can you spot the hidden factual errors in generated text?<\/div>\n<\/li>\n<li>\n<div>\ufe0f <strong data-path-to-node=\"6,2,0\" data-index-in-node=\"3\">The Alignment Test:<\/strong> Play the AI Safety Researcher and rank responses based on honesty and helpfulness.<\/div>\n<\/li>\n<\/ul>\n<div><strong data-path-to-node=\"7\" data-index-in-node=\"0\">The Ground Rules:<\/strong><\/div>\n<br \/>\n<ul data-path-to-node=\"8\">\n<li>\n<div><strong data-path-to-node=\"8,0,0\" data-index-in-node=\"0\">Registration Fee:<\/strong> \u20b90 (Yes, it's absolutely FREE!)<\/div>\n<\/li>\n<li>\n<div><strong data-path-to-node=\"8,1,0\" data-index-in-node=\"0\">Eligibility:<\/strong> Open to all college students. (Solo participation only).<\/div>\n<\/li>\n<li>\n<div><strong data-path-to-node=\"8,2,0\" data-index-in-node=\"0\">Venue:<\/strong> NLHC, IIT (ISM) Dhanbad.<\/div>\n<\/li>\n<li>\n<div><strong data-path-to-node=\"8,3,0\" data-index-in-node=\"0\">Format:<\/strong> A fast-paced online quiz hosted right here on Unstop.<\/div>\n<\/li>\n<li>\n<div><strong data-path-to-node=\"8,4,0\" data-index-in-node=\"0\">Pro Tip:<\/strong> Speed matters! If there's a tie, the one who finishes first takes the crown.<\/div>\n<\/li>\n<\/ul>\n<div><strong data-path-to-node=\"9\" data-index-in-node=\"0\">Prizes &amp; Perks (The Good Stuff) :<\/strong><\/div>\n<br \/>\n<ul data-path-to-node=\"10\">\n<li>\n<div><strong data-path-to-node=\"10,0,0\" data-index-in-node=\"3\">Cash Prizes:<\/strong> A massive prize pool of <strong data-path-to-node=\"10,0,0\" data-index-in-node=\"40\">\u20b920,000<\/strong> is up for grabs!<\/div>\n<\/li>\n<li>\n<div><strong data-path-to-node=\"10,1,0\" data-index-in-node=\"3\">Certificates:<\/strong> Verified Unstop E-Certificates for <em data-path-to-node=\"10,1,0\" data-index-in-node=\"52\">everyone<\/em> who participates, plus special Merit Certificates for our top performers.<\/div>\n<\/li>\n<\/ul>\n<div><strong data-path-to-node=\"11\" data-index-in-node=\"0\">For any queries, drop a message on WhatsApp:<\/strong><\/div>\n<br \/>\n<ul data-path-to-node=\"12\">\n<li>\n<div><strong><em>Pranjul Sahu: +91 73900 44857<\/em><\/strong><\/div>\n<\/li>\n<li>\n<div><span data-path-to-node=\"12,1,0,0\"><strong><em>Abhirup Sarkar: +91 96414 72357<\/em><\/strong><br \/><\/span><\/div>\n<\/li>\n<\/ul>\n<p><strong>Join group for further updates :-<\/strong><br \/>https:\/\/chat.whatsapp.com\/G8sHoO3ZYYg7SPaFFwiLlQ<br \/><br \/>All the best!<\/p>\n<\/div>","overall_prizes":"\u20b920K Cash Prize Pool + E-certificates for everyone!","regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":33552634,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-07T17:41:28+05:30","updated_at":"2026-10-08T11:58:03+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"","combined_leaderboard":null,"source":null,"short_id":"ghDeb90","hashtags":null,"participation_certificate":1,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":60,"checked":null,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":37,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-07 18:17:04","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":false,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/uploadedManual-6ac658acebbdc_images.jpg","logoUrl2":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/150x150\/uploadedManual-6ac658acebbdc_images.jpg","regnRequirements":{"id":2499032,"opportunity_id":1767347,"festival_id":null,"max_team_size":1,"min_team_size":1,"start_regn_dt":"2026-10-07T0