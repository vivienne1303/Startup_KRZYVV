{"data":{"status":true,"competition":{"id":1764121,"visibility":"public","theme_colour":"blue_un","paid":0,"title":"Binary Battles","festival_id":520881,"organization_id":943045,"web_url":null,"start_date":"2026-10-01T00:00:00+05:30","end_date":"2026-10-22T16:00:00+05:30","location":null,"type":"competitions","public_url":"competitions\/binary-battles-bharati-vidyapeeths-college-of-engineering-1764121","region":"offline","details":"<div id=\"model-response-message-contentr_147c949e364f0755\" class=\"markdown markdown-main-panel md-content enable-luminous-fast-follows enable-updated-hr-color stronger tutor-markdown-rendering\" dir=\"ltr\" aria-busy=\"false\" aria-live=\"polite\">\n<p data-path-to-node=\"0\"><strong>About the Event:<\/strong><\/p>\n<p data-path-to-node=\"0\"><strong data-path-to-node=\"1\" data-index-in-node=\"0\">Binary Battles<\/strong> is a premier two-round technical debate competition designed to evaluate participants on technical mastery, critical thinking, ethical reasoning, and high-stakes decision-making. Centered around <strong data-path-to-node=\"1\" data-index-in-node=\"210\">SDG 10 (Reduced Inequalities)<\/strong> and <strong data-path-to-node=\"1\" data-index-in-node=\"244\">SDG 16 (Peace, Justice, and Strong Institutions)<\/strong>, the event moves beyond pure technical theory to examine how technology shapes accessibility, governance, societal equality, and digital rights.<\/p>\n<p data-path-to-node=\"3\"><strong>Round-wise Details:<\/strong><\/p>\n<h3 data-path-to-node=\"4\">Round 1: The Technical Face-Off (1v1 Debate)<\/h3>\n<ul data-path-to-node=\"5\">\n<li>\n<div><strong data-path-to-node=\"5,0,0\" data-index-in-node=\"0\">Format:<\/strong> Individual Lincoln-Douglas style debate.<\/div>\n<\/li>\n<li>\n<div><strong data-path-to-node=\"5,1,0\" data-index-in-node=\"0\">Mechanism:<\/strong> Participants are randomly assigned as Affirmative or Negative on a contemporary techno-societal topic.<\/div>\n<\/li>\n<li>\n<div><strong data-path-to-node=\"5,2,0\" data-index-in-node=\"0\">Structure:<\/strong> Includes constructive speeches, cross-examination, and direct rebuttals within set time limits.<\/div>\n<\/li>\n<li>\n<div><strong data-path-to-node=\"5,3,0\" data-index-in-node=\"0\">Selection:<\/strong> Top individual performers advance to Round 2 based on factual accuracy, argument structure, rebuttal quality, ethical awareness, and oratorical impact.<\/div>\n<\/li>\n<\/ul>\n<h3 data-path-to-node=\"6\">Round 2: The CEO Courtroom (Executive Role-Play)<\/h3>\n<ul data-path-to-node=\"7\">\n<li>\n<div><strong data-path-to-node=\"7,0,0\" data-index-in-node=\"0\">Format:<\/strong> Individual leadership and problem-solving crisis simulation.<\/div>\n<\/li>\n<li>\n<div><strong data-path-to-node=\"7,1,0\" data-index-in-node=\"0\">Mechanism:<\/strong> Finalists assume the role of tech CEOs\/Tech Leaders presented with complex, high-pressure scenarios (e.g., AI ethics, algorithmic bias, data privacy breaches, or digital inequality).<\/div>\n<\/li>\n<li>\n<div><strong data-path-to-node=\"7,2,0\" data-index-in-node=\"0\">Objective:<\/strong> Participants must analyze the problem, present viable innovation strategies, balance corporate interests with public responsibility, and defend their decisions under intense cross-questioning.<\/div>\n<\/li>\n<\/ul>\n<p data-path-to-node=\"9\"><strong>Rules and Guidelines:<\/strong><\/p>\n<ul data-path-to-node=\"10\">\n<li>\n<div><strong data-path-to-node=\"10,0,0\" data-index-in-node=\"0\">Eligibility:<\/strong> Open to university\/college students across India from all academic years and specializations.<\/div>\n<\/li>\n<li>\n<div><strong data-path-to-node=\"10,1,0\" data-index-in-node=\"0\">Participation:<\/strong> Individual entry. Selection for Round 2 is strictly based on individual merit.<\/div>\n<\/li>\n<li>\n<div><strong data-path-to-node=\"10,2,0\" data-index-in-node=\"0\">Preparation:<\/strong> Designated prep time will be provided prior to each debate session.<\/div>\n<\/li>\n<li>\n<div><strong data-path-to-node=\"10,3,0\" data-index-in-node=\"0\">Code of Conduct:<\/strong> Professionalism and mutual respect are mandatory. Personal attacks, discriminatory language, or offensive conduct will result in immediate disqualification.<\/div>\n<\/li>\n<li>\n<div><strong data-path-to-node=\"10,4,0\" data-index-in-node=\"0\">Final Authority:<\/strong> The judges' decision across both rounds is final and binding.<\/div>\n<\/li>\n<\/ul>\n<p><strong>For Queries Contact : -<\/strong><\/p>\n<p><strong>Nikunj Singh<\/strong> - 9211293576<\/p>\n<p><strong>Ritesh Rao <\/strong>- 8700297492&nbsp;<\/p>\n<\/div>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":33478161,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-01T12:34:04+05:30","updated_at":"2026-10-02T17:07:42+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"3WZGRnx","hashtags":null,"participation_certificate":0,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":null,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":1,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-01 12:35:58","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/uploadedManual-6abe067d375f6_bvestlogo_final_1.png","logoUrl2":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/150x150\/uploadedManual-6