{"data":{"status":true,"competition":{"id":1767027,"visibility":"public","theme_colour":null,"paid":0,"title":"The Wrecking Ball Challenge ","festival_id":null,"organization_id":604,"web_url":"techfest.org\/competitions\/wrecking-ball-challenge","start_date":"2026-10-07T00:00:00+05:30","end_date":"2026-12-18T10:56:00+05:30","location":null,"type":"competitions","public_url":"competitions\/the-wrecking-ball-challenge-iit-bombay-1767027","region":"online","details":"<p><span data-path-to-node=\"4,0\">Mandatory Registration at: https:\/\/techfest.org\/competitions\/wrecking-ball-challenge<br \/><br \/>The <strong data-path-to-node=\"4,0\" data-index-in-node=\"4\">Wrecking Ball Challenge<\/strong> is Techfest, IIT Bombay&rsquo;s premier autonomous robotics competition<\/span><span data-path-to-node=\"4,2\">. Participants are tasked with designing, building, and deploying a self-contained, autonomous, battery-powered spherical robot to navigate a high-stakes <strong data-path-to-node=\"4,2\" data-index-in-node=\"154\">75-meter obstacle-laden arena<\/strong><\/span><span data-path-to-node=\"4,4\">.<\/span><\/p>\n<p><span data-path-to-node=\"5,0\">The challenge evaluates advanced engineering principles&mdash;balancing internal mechanical actuation (Center-of-Gravity stabilization) with real-time vision algorithms to autonomously navigate ramps, smash low-density barriers, and evade a swinging pendulum<\/span><span data-path-to-node=\"5,2\">.<\/span><\/p>\n<p><span data-path-to-node=\"6,0\">Do you have what it takes to engineer a rolling sphere that can master autonomous vision-based navigation under pressure<\/span><span data-path-to-node=\"6,2\">? Benchmark your innovation against the top student teams across the country and compete for cash prizes, internships, and subscriptions!<\/span><\/p>\n<p data-path-to-node=\"8\"><strong>Eligibility &amp; Team Structure<\/strong><\/p>\n<ul data-path-to-node=\"9\">\n<li><span data-path-to-node=\"9,0,0,0\"><strong data-path-to-node=\"9,0,0,0\" data-index-in-node=\"0\">Eligibility:<\/strong> Open to all currently enrolled undergraduate, postgraduate, or diploma students from recognized academic institutions<\/span><span data-path-to-node=\"9,0,0,2\">.<\/span><\/li>\n<li><span data-path-to-node=\"9,1,0,0\"><strong data-path-to-node=\"9,1,0,0\" data-index-in-node=\"0\">Team Size:<\/strong> Up to <strong data-path-to-node=\"9,1,0,0\" data-index-in-node=\"17\">6 members<\/strong> per team<\/span><span data-path-to-node=\"9,1,0,2\">.<\/span><\/li>\n<li><span data-path-to-node=\"9,2,0,0\"><strong data-path-to-node=\"9,2,0,0\" data-index-in-node=\"0\">Inter-College Teams:<\/strong> Permitted<\/span><span data-path-to-node=\"9,2,0,2\">.<\/span><\/li>\n<li><span data-path-to-node=\"9,3,0,0\"><strong data-path-to-node=\"9,3,0,0\" data-index-in-node=\"0\">Registration:<\/strong> All teams must register on <code data-path-to-node=\"9,3,0,0\" data-index-in-node=\"41\">techfest.org<\/code> to receive an official Team ID<\/span><span data-path-to-node=\"9,3,0,2\">.<\/span><\/li>\n<\/ul>\n<p data-path-to-node=\"11\"><strong>Round Details &amp; Structure<\/strong><\/p>\n<p data-path-to-node=\"12\"><strong data-path-to-node=\"12\" data-index-in-node=\"0\">Phase 1: Registration &amp; CAD Abstract Submission (Deadline: October 20, 2026)<\/strong><\/p>\n<ul data-path-to-node=\"13\">\n<li><span data-path-to-node=\"13,0,0,0\"><strong data-path-to-node=\"13,0,0,0\" data-index-in-node=\"0\">Format:<\/strong> Online Document Submission<\/span><span data-path-to-node=\"13,0,0,2\">.<\/span><\/li>\n<li><span data-path-to-node=\"13,1,0,0\"><strong data-path-to-node=\"13,1,0,0\" data-index-in-node=\"0\">Deliverable:<\/strong> Submit a CAD assembly illustrating the internal electronic layout, center-of-gravity placement, system architecture schematic, and dimension compliance<\/span><span data-path-to-node=\"13,1,0,2\">.<\/span><\/li>\n<\/ul>\n<p data-path-to-node=\"14\"><strong>Phase 2: Virtual Design &amp; Simulation Audit (Deadline: November 15, 2026)<\/strong><\/p>\n<ul data-path-to-node=\"15\">\n<li><span data-path-to-node=\"15,0,0,0\"><strong data-path-to-node=\"15,0,0,0\" data-index-in-node=\"0\">Format:<\/strong> Virtual Evaluation<\/span><span data-path-to-node=\"15,0,0,2\">.<\/span><\/li>\n<li><span data-path-to-node=\"15,1,0,0\"><strong data-path-to-node=\"15,1,0,0\" data-index-in-node=\"0\">Deliverable:<\/strong> Technical Simulation Report including mathematical analysis validating actuator torque across inclined planes (specifically the 0.8 ft ramp), balance stability calculations, and wireless emergency kill-switch implementation<\/span><span data-path-to-node=\"15,1,0,2\">.<\/span><\/li>\n<li><span data-path-to-node=\"15,2,0,0\"><strong data-path-to-node=\"15,2,0,0\" data-index-in-node=\"0\">Finalist Announcement:<\/strong> November 20, 2026<\/span><span data-path-to-node=\"15,2,0,2\">.<\/span><\/li>\n<\/ul>\n<p data-path-to-node=\"16\"><strong data-path-to-node=\"16\" data-index-in-node=\"0\">Phase 3: Grand Finale (On-Campus at IIT Bombay &mdash; Dec 16&ndash;17, 2026)<\/strong><\/p>\n<ul data-path-to-node=\"17\">\n<li><strong data-path-to-node=\"17,0,0\" data-index-in-node=\"0\">Day 1 (Dec 16): On-Site Technical Inspection &amp; Qualifying Heats<\/strong>\n<ul data-path-to-node=\"17,0,1\">\n<li><span data-path-to-node=\"17,0,1,0,0,0\">Dimensional compliance check (2.0 to 2.5 ft diameter), weight verification, electrical isolation, emergency kill-switch validation, and preliminary practice runs<\/span><span data-path-to-node=\"17,0,1,0,0,2\">.<\/span><\/li>\n<\/ul>\n<\/li>\n<li><strong data-path-to-node=\"17,1,0\" data-index-in-node=\"0\">Day 2 (Dec 17): Official Timed Final Heats<\/strong>\n<ul data-path-to-node=\"17,1,1\">\n<li><span data-path-to-node=\"17,1,1,0,0,0\">Teams execute official timed runs across the 75-meter arena<\/span><span data-path-to-node=\"17,1,1,0,0,2\">.<\/span><\/li>\n<li><span data-path-to-node=\"17,1,1,1,0,0\">Teams get <strong data-path-to-node=\"17,1,1,1,0,0\" data-index-in-node=\"10\">3 restart attempts<\/strong>, with only the top performance logged<\/span><span data-path-to-node=\"17,1,1,1,0,2\">.<\/span><\/li>\n<\/ul>\n<\/li>\n<\/ul>\n<p data-path-to-node=\"19\"><strong>The 75-Meter Arena Layout<\/strong><\/p>\n<p><span data-path-to-node=\"20,0\">The track is guided visually by color-coded boundary cones (<strong data-path-to-node=\"20,0\" data-index-in-node=\"60\">Red<\/strong> on the right, <strong data-path-to-node=\"20,0\" data-index-in-node=\"78\">Yellow<\/strong> on the left)<\/span><span data-path-to-node=\"20,2\">:<\/span><\/p>\n<ul data-path-to-node=\"21\">\n<li><span data-path-to-node=\"21,0,0,0\"><strong data-path-to-node=\"21,0,0,0\" data-index-in-node=\"0\">Sector 1: The Gate Runway (0m&ndash;15m):<\/strong> Straight acceleration stretch with wide chevron-patterned cone gates for vision calibration<\/span><span data-path-to-node=\"21,0,0,2\">.<\/span><\/li>\n<li><span data-path-to-node=\"21,1,0,0\"><strong data-path-to-node=\"21,1,0,0\" data-index-in-node=\"0\">Sector 2: The Step-Up Ramps (15m&ndash;35m):<\/strong> Three consecutive incline ramps (0.2 ft, 0.4 ft, and 0.8 ft heights)<\/span><span data-path-to-node=\"21,1,0,2\">.<\/span><\/li>\n<li><span data-path-to-node=\"21,2,0,0\"><strong data-path-to-node=\"21,2,0,0\" data-index-in-node=\"0\">Sector 3: The Wrecking Zone (35m&ndash;55m):<\/strong> Low-density barriers (foam, thermocol, cardboard) that the robot must plow through while staying on course<\/span><span data-path-to-node=\"21,2,0,2\">.<\/span><\/li>\n<li><span data-path-to-node=\"21,3,0,0\"><strong data-path-to-node=\"21,3,0,0\" data-index-in-node=\"0\">Sector 4: The Pendulum Gauntlet (55m&ndash;75m):<\/strong> Final sector featuring a continuously swinging mechanical pendulum before the finish line<\/span><span data-path-to-node=\"21,3,0,2\">.<\/span><\/li>\n<\/ul>\n<p data-path-to-node=\"23\"><strong>Technical &amp; Constraint Guidelines<\/strong><\/p>\n<ul data-path-to-node=\"24\">\n<li><span data-path-to-node=\"24,0,0,0\"><strong data-path-to-node=\"24,0,0,0\" data-index-in-node=\"0\">Robot Dimensions:<\/strong> Outer shell must be strictly spherical with a diameter between <strong data-path-to-node=\"24,0,0,0\" data-index-in-node=\"81\">2.0 feet and 2.5 feet<\/strong><\/span><span data-path-to-node=\"24,0,0,2\">.<\/span><\/li>\n<li><span data-path-to-node=\"24,1,0,0\"><strong data-path-to-node=\"24,1,0,0\" data-index-in-node=\"0\">Peripheral Limits:<\/strong> External sensors or camera mounts cannot extend more than <strong data-path-to-node=\"24,1,0,0\" data-index-in-node=\"77\">0.5 feet<\/strong> beyond the shell surface<\/span><span data-path-to-node=\"24,1,0,2\">.<\/span><\/li>\n<li><span data-path-to-node=\"24,2,0,0\"><strong data-path-to-node=\"24,2,0,0\" data-index-in-node=\"0\">Autonomy:<\/strong> 100% autonomous operation; no manual remote control, tethered lines, or external offload processing permitted<\/span><span data-path-to-node=\"24,2,0,2\">.<\/span><\/li>\n<li><span data-path-to-node=\"24,3,0,0\"><strong data-path-to-node=\"24,3,0,0\" data-index-in-node=\"0\">Primary Sensing:<\/strong> Onboard camera system must serve as the primary path-tracking sensor (IMUs, encoders, distance sensors permitted internally for balance)<\/span><span data-path-to-node=\"24,3,0,2\">.<\/span><\/li>\n<li><span data-path-to-node=\"24,4,0,0\"><strong data-path-to-node=\"24,4,0,0\" data-index-in-node=\"0\">Safety:<\/strong> Must include a working wireless emergency kill switch that halts motor power immediately<\/span><span data-path-to-node=\"24,4,0,2\">.<\/span><\/li>\n<li><span data-path-to-node=\"24,5,0,0\"><strong data-path-to-node=\"24,5,0,0\" data-index-in-node=\"0\">Penalties:<\/strong> Touching, knocking over, or running over any boundary cone incurs a <strong data-path-to-node=\"24,5,0,0\" data-index-in-node=\"79\">+5 second penalty<\/strong> per instance<\/span><span data-path-to-node=\"24,5,0,2\">.<\/span><\/li>\n<\/ul>\n<p>&nbsp;<\/p>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":33117322,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-07T10:40:42+05:30","updated_at":"2026-10-07T17:09:55+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"3hLQCTx","hashtags":null,"participation_certificate":0,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":null,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":2,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-07 10:49:16","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/6ac62f8c05cf0_","logoUrl2":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/150x150\/6ac62f8c05cf0_","regnRequirements":{"id":2498707,"opportunity_id":1767027,"festival_id":null,"max_team_size":2,"min_team_size":1,"start_regn_dt":"2026-10-07T00:00:00+05:30","end_regn_dt":"2026-10-20T00:00:00+05:30","show_deadline":1,"open_for":0,"college_type":0,"same_organisation":0,"study_year_filter":0,"deleted_at":null,"eligibility":"{\"sector\":[\"students\"],\"engineering\":[],\"bSchools\":[],\"arts\":[],\"medicine\":[],\"law\":[],\"others\":[\"all\"],\"experience\":[\"all\"],\"studentPassoutYearsSelected\":[\"all\"],\"fresherPassoutYearsSelected\":[\"all\"],\"schoolFilteredClasses\":[\"all\"],\"minMarks\":{\"high_school_perc\":0,\"high_school_cgpa\":0},\"locations\"