{"data":{"status":true,"competition":{"id":1744778,"visibility":"public","theme_colour":null,"paid":0,"title":"Foodprint","festival_id":504454,"organization_id":675999,"web_url":null,"start_date":"2026-09-28T00:00:00+05:30","end_date":"2026-10-12T23:00:00+05:30","location":null,"type":"competitions","public_url":"competitions\/foodprint-techfest26-annual-technical-festival-of-sliet-sant-longowal-institute-of-engineering-and-technolo-1744778","region":"offline","details":"<p><strong>Recognize The Brand Behind The Food:<\/strong><\/p>\n<p><strong>Overview:<\/strong><\/p>\n<ul>\n<li>&ldquo;Recognize the Brand Behind the Food&rdquo; is a fast-paced and entertaining event designed to test participants&rsquo; knowledge and awareness of popular food and beverage brands.<\/li>\n<li>Participants will identify brands based on taglines, logos, product images, blurred pictures, or advertisements within a limited time.<\/li>\n<li>The event tests brand awareness, observation skills, memory, and quick decision-making.<\/li>\n<\/ul>\n<p><strong>Event Objective:<\/strong><\/p>\n<ul>\n<li>To test participants&rsquo; awareness of food and beverage brands while developing observation, recognition, memory, and quick decision-making skills in an engaging and competitive environment.<\/li>\n<\/ul>\n<p><strong>Event Description:<\/strong><\/p>\n<ul>\n<li>Participants will be shown different clues related to popular food and beverage brands.<\/li>\n<li>The clues may include taglines, logos, product images, blurred pictures, or advertisements.<\/li>\n<li>Participants must identify the correct brand within the allotted time.<\/li>\n<li>The event will test participants&rsquo; brand awareness, observation skills, memory, and ability to make quick decisions.<\/li>\n<\/ul>\n<p><strong>Judgement Criteria:<\/strong><\/p>\n<ul>\n<li>Accuracy of Brand Identification: Correct identification of the food or beverage brand.<\/li>\n<li>Speed of Response: Ability to identify the brand within the shortest possible time.<\/li>\n<li>Observation Skills: Ability to recognise brands from visual and textual clues.<\/li>\n<li>Brand Awareness: Knowledge and familiarity with popular food and beverage brands.<\/li>\n<li>Consistency of Performance: Overall performance across different rounds and types of clues.<\/li>\n<\/ul>\n<p><strong>Rules &amp; Regulations:<\/strong><\/p>\n<ul>\n<li>Individual participation only.<\/li>\n<li>Participants must identify the brand based on the clue provided.<\/li>\n<li>Each question must be answered within the allotted time.<\/li>\n<li>Use of external resources or internet search is prohibited.<\/li>\n<li>Decorum should be maintained throughout the event.<\/li>\n<li>Any conflict may be resolved at the discretion of the event coordinator.<\/li>\n<\/ul>\n<p><strong>Accommodation and Meals:<\/strong><\/p>\n<p><strong>Registration for the techFEST&rsquo;26 package is compulsory for accommodation and other perks, while participation in individual events is free*.<\/strong><\/p>\n<p><strong>Registration Note:<\/strong><\/p>\n<ul>\n<li>Registration is mandatory for participation.<\/li>\n<li>The fee once paid is non-refundable.<\/li>\n<li>Participants can follow the official Instagram and other social media platforms for updates.<\/li>\n<li>Register through the techFEST'26 package page.<\/li>\n<\/ul>\n<p><strong>Register Now:<\/strong><br \/><a href=\"https:\/\/www.techfest26.com\/package\">https:\/\/www.techfest26.com\/package<\/a><\/p>\n<p><strong>Certification Policy:<\/strong><\/p>\n<ul>\n<li>Participation certificates will be provided to all participants.<\/li>\n<li>Certificates of excellence will be provided to the winners.<\/li>\n<\/ul>\n<p><strong>Important Note:<\/strong><\/p>\n<ul>\n<li>The event is open to participants from all branches\/departments.<\/li>\n<li>Rules and awards are subject to change and, in the worst case, may change without notifying the team.<\/li>\n<li>In case of any update, the documents uploaded on the official techFEST'26 website will be treated as final.<\/li>\n<li>Participants are responsible for visiting the official techFEST'26 website frequently and following the stated instructions.<\/li>\n<li><strong>All payments must be made exclusively through our official TechFest website. Kindly complete your payment through: https:\/\/app.techfest26.com\/package<\/strong><\/li>\n<\/ul>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":null,"registration_clicks":0,"user_id":27463276,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-08-26T23:11:03+05:30","updated_at":"2026-10-07T19:25:24+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"9E8Tvtp","hashtags":null,"participation_certificate":0,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":2,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":129,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-08-27 04:06:28","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/uploadedManual-6aad50b5aceca_logo.webp","logoUrl2":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/150x150\/uploadedManual-6aad50b5aceca_logo.webp","regnRequirements":{"id":2476084,"opportunity_id":1744778,"festival_id":null,"max_team_size":1,"min_team_size":1,"start_regn_dt":"2026-09-28T00:00:00+05:30","end_regn_dt":"2026-10-10T23:00:00+05:30","show_deadline":1,"open_for":0,"college_type":0,"same_organisa