{"data":{"status":true,"competition":{"id":1759088,"visibility":"public","theme_colour":null,"paid":0,"title":"The Logic Circuit","festival_id":515746,"organization_id":1034442,"web_url":null,"start_date":"2026-09-21T00:00:00+05:30","end_date":"2026-10-13T15:50:15+05:30","location":null,"type":"competitions","public_url":"competitions\/the-logic-circuit-pravrutti-20-m-s-ramaiah-university-of-applied-sciences-1759088","region":"online","details":"<p><strong>About the Event:<\/strong><\/p>\n<p>Experience THE LOGIC CIRCUIT, a high-stakes digital puzzle race at Pravrutti 2026! Teams will compete to crack logic problems and puzzles, unlock progression keys, and race through challenges on a competitive local network.<\/p>\n<p>Each team will share one laptop and work together to solve the challenges. With all teams competing simultaneously, participants will need logical reasoning, focus, and teamwork to progress through the competition.<\/p>\n<p>The first three teams to complete the final challenge in the correct sequence will claim victory.<\/p>\n<p>Do you have what it takes to outsmart the circuit? Fasten your focus and get ready to explore the hidden world of problem-solving!<\/p>\n<p><strong>Event Details:<\/strong><\/p>\n<ul>\n<li><strong>Event Name:<\/strong> The Logic Circuit<\/li>\n<li><strong>Event Type:<\/strong> Team-based digital puzzle competition<\/li>\n<li><strong>Team Size:<\/strong> 1 to 3 members<\/li>\n<li><strong>Duration:<\/strong> 3 hours<\/li>\n<li><strong>Event Dates:<\/strong> 14&ndash;16 October 2026<\/li>\n<li><strong>Venue:<\/strong> Ramaiah Technology Campus, Bengaluru<\/li>\n<li><strong>Registration Fee:<\/strong> \u20b9200 per team<\/li>\n<li><strong>Team Capacity:<\/strong> 40 teams<\/li>\n<\/ul>\n<p><strong>Rules and Guidelines:<\/strong><\/p>\n<ul>\n<li>Participants can register individually or in teams of up to 3 members.<\/li>\n<li>Each team must share one laptop during the competition.<\/li>\n<li>Teams will solve logic-based problems and puzzles to unlock progression keys.<\/li>\n<li>The competition will be conducted on a local network.<\/li>\n<li>Teams will compete simultaneously against other participating teams.<\/li>\n<li>The first three teams to complete the final challenge in the correct sequence will be declared the winners.<\/li>\n<\/ul>\n<p><strong>Prizes:<\/strong><\/p>\n<ul>\n<li><strong>1st Prize:<\/strong> \u20b97,000<\/li>\n<li><strong>2nd Prize:<\/strong> \u20b95,000<\/li>\n<li><strong>3rd Prize:<\/strong> \u20b93,000<\/li>\n<\/ul>\n<p><strong>Important Note:<\/strong><\/p>\n<p>Participants are requested to check the official event rulebook for detailed instructions and additional guidelines before participating.<\/p>\n<p>Get ready to think, solve, and conquer THE LOGIC CIRCUIT!<\/p>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":27034930,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-09-21T00:09:07+05:30","updated_at":"2026-10-06T15:50:17+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"A5CupyO","hashtags":null,"participation_certificate":1,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":2,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":0,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-09-21 00:18:34","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/uploadedManua