{"data":{"status":true,"competition":{"id":1744777,"visibility":"public","theme_colour":null,"paid":0,"title":"Clue Craze","festival_id":504454,"organization_id":675999,"web_url":null,"start_date":"2026-09-28T00:00:00+05:30","end_date":"2026-10-14T00:00:00+05:30","location":null,"type":"competitions","public_url":"competitions\/clue-craze-techfest26-annual-technical-festival-of-sliet-sant-longowal-institute-of-engineering-and-technol-1744777","region":"offline","details":"<p><strong>Clue Craze:<\/strong><\/p>\n<p><strong>Overview:<\/strong><\/p>\n<ul>\n<li>&ldquo;CLUE CRAZE&rdquo; is a team-based treasure hunt open to students from all departments.<\/li>\n<li>Participants will solve clues, puzzles, and QR-code challenges across different checkpoints on campus.<\/li>\n<li>The event tests teamwork, logical thinking, problem-solving, observation, and time management skills.<\/li>\n<li>The event is aligned with the TechFEST&rsquo;26 theme, &ldquo;Technology and Science for a Sustainable Earth.&rdquo;<\/li>\n<\/ul>\n<p><strong>Event Objective:<\/strong><\/p>\n<ul>\n<li>To promote teamwork, logical thinking, problem-solving, observation, and time management through an engaging and challenging campus-wide treasure hunt.<\/li>\n<\/ul>\n<p><strong>Event Description:<\/strong><\/p>\n<ul>\n<li>Each team will receive a clue leading them towards a particular checkpoint.<\/li>\n<li>At different checkpoints, participants will encounter clues, puzzles, and QR-code challenges.<\/li>\n<li>Participants must solve the challenges correctly to proceed to the next checkpoint.<\/li>\n<li>Teams will use teamwork, logical thinking, observation, and problem-solving skills to complete the hunt.<\/li>\n<li>The team that completes all checkpoints in the shortest time will be declared the winner.<\/li>\n<\/ul>\n<p><strong>Judgement Criteria:<\/strong><\/p>\n<ul>\n<li>Puzzle Solving Skills: Ability to interpret and solve clues accurately and efficiently.<\/li>\n<li>Logical Thinking: Application of logical and creative approaches to solve challenges.<\/li>\n<li>Teamwork &amp; Coordination: Effective communication, cooperation, and coordination among team members.<\/li>\n<li>Time Management: Ability to complete the treasure hunt within the minimum possible time.<\/li>\n<li>Adherence to Rules &amp; Fair Play: Following all event rules and demonstrating sportsmanship and positive conduct throughout the hunt.<\/li>\n<\/ul>\n<p><strong>Rules &amp; Regulations:<\/strong><\/p>\n<ul>\n<li>Each team must consist of a minimum of 1 participant and a maximum of 3 participants.<\/li>\n<li>All team members must remain within the permitted area during the event.<\/li>\n<li>Use of external resources or internet search may be prohibited during the challenges.<\/li>\n<li>Participants must follow the instructions provided at each checkpoint.<\/li>\n<li>The decision of the event coordinator will be final.<\/li>\n<\/ul>\n<p><strong>Accommodation and Meals:<\/strong><\/p>\n<p><strong>Registration for the techFEST&rsquo;26 package is compulsory for accommodation and other perks, while participation in individual events is free*.<\/strong><\/p>\n<p><strong>Registration Note:<\/strong><\/p>\n<ul>\n<li>Registration is mandatory for participation.<\/li>\n<li>The fee once paid is non-refundable.<\/li>\n<li>Participants can follow the official Instagram and other social media platforms for updates.<\/li>\n<li>Register through the techFEST'26 package page.<\/li>\n<\/ul>\n<p><strong>Certification Policy:<\/strong><\/p>\n<ul>\n<li>Certificates of excellence will be provided to the Top 3 Winners.<\/li>\n<li>Participation certificates will be provided to all participants.<\/li>\n<\/ul>\n<p><strong>Important Note:<\/strong><\/p>\n<ul>\n<li>The event is open to participants from all branches\/departments.<\/li>\n<li>Rules and awards are subject to change and, in the worst case, may change without notifying the team.<\/li>\n<li>In case of any update, the documents uploaded on the official techFEST'26 website will be treated as final.<\/li>\n<li>Participants are responsible for visiting the official techFEST'26 website frequently and following the stated instructions.<\/li>\n<li><strong>All payments must be made exclusively through our official TechFest website. Kindly complete your payment through: https:\/\/app.techfest26.com\/package<\/strong><\/li>\n<li>\n<p><strong>Register Now:<\/strong><br \/><a href=\"https:\/\/www.techfest26.com\/package\">https:\/\/www.techfest26.com\/package<\/a><\/p>\n<p>&nbsp;<\/p>\n<\/li>\n<\/ul>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":null,"registration_clicks":0,"user_id":27463276,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-08-26T23:10:40+05:30","updated_at":"2026-10-07T19:25:12+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"NDoCvbV","hashtags":null,"participation_certificate":0,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":2,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":125,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-08-27 04:06:14","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/uploadedManual-6aad50d5c87dd_logo.webp","logoUrl2":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/150x150\/uploadedManual-6aad50d5c87dd_logo.webp","regnRequirements":{"id":2476083,"opportunity_id":1744777,"festival_id":null,"max_team_s