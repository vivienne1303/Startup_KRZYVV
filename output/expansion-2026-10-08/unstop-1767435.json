{"data":{"status":true,"competition":{"id":1767435,"visibility":"public","theme_colour":"blue_un","paid":0,"title":"Kronos 2026: HR Case Competition ","festival_id":null,"organization_id":543526,"web_url":null,"start_date":"2026-10-07T20:00:00+05:30","end_date":"2026-10-22T05:00:00+05:30","location":null,"type":"competitions","public_url":"competitions\/kronos-2026-hr-case-competition-xavier-school-of-management-xlri-1767435","region":"online","details":"<p><strong>XLRI PGDM (GM)<\/strong> Class of 2026-27 is excited to organize the \"<strong>Kronos 2026<\/strong>\" Case Competition as part of Kronos, the flagship CHRO Conclave.<br \/>The Kronos Conclave is scheduled for October 24th, 2026 and is themed \"<strong>The New Rules of Leadership, Talent &amp; Performance<\/strong>.\" Senior HR leaders and CHROs from reputed organizations will share their ideas and experiences on how leadership, talent strategy, and performance management are being reshaped in a changing world of work.<\/p>\n<ul>\n<li>The competition gives participants an opportunity to deepen their understanding of how organizations can lead, attract and retain talent, and drive performance under new rules.<br \/><br \/><strong>Registration closes on 19th October 2026 8:00 PM<\/strong>.<\/li>\n<\/ul>\n<p><strong>Guidelines:<\/strong><\/p>\n<ul>\n<li>There is no restriction on the number of teams participating from the same institute but<strong> <\/strong>all team members should be from the same organization\/institution.<\/li>\n<li>Each participant should be registered only once &amp; can be a part of only one team.<\/li>\n<li>The first round consists of a quiz, followed by a PPT\/PDF (4-5 slides excluding the introduction and ending slide).<\/li>\n<li>Teams need to submit their presentation slides as a PPT\/PDF on the Unstop platform.<br \/>The PPT\/PDF and video files should be named InstituteName_TeamName.<\/li>\n<li>Participants can form teams of 1 (minimum) to 3 (maximum) members.<\/li>\n<li>Modification of teams after registration will not be entertained.<\/li>\n<li>Candidates will not be allowed to add, remove, or modify any content of the presentations submitted during the case solution submission round. Any noticeable changes may lead to disqualification of that entry at the discretion of the Corporate Competition Committee, XLRI Jamshedpur.<\/li>\n<\/ul>\n<p><strong>Rules:<\/strong><\/p>\n<ul>\n<li>Teams should adhere to the provided guidelines; failure to comply may result in disqualification.<\/li>\n<li>Participants will be evaluated on the creativity and feasibility of the solutions presented.<\/li>\n<li>Any participant found to be registered in multiple teams will be disqualified.<\/li>\n<li>In case of any disputes, the decision of the organizers will be final.<\/li>\n<li>The PGDM (GM) Competition Committee reserves the right to verify the registration information submitted at any point in time.<\/li>\n<li>Only teams that are in top 2 positions at the end of case submission round will receive participation certificates.<\/li>\n<\/ul>","overall_prizes":"Pooled Prize of Rs 25,000\/-","regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":31638541,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-07T19:31:10+05:30","updated_at":"2026-10-07T20:22:51+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"case_competition","combined_leaderboard":null,"source":null,"short_id":"43dNWxf","hashtags":null,"participation_certificate":0,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":null,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":70,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-07 19:55: