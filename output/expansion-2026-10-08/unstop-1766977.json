{"data":{"status":true,"competition":{"id":1766977,"visibility":"public","theme_colour":null,"paid":0,"title":"Procon Jr.","festival_id":null,"organization_id":627,"web_url":null,"start_date":"2026-10-07T00:00:00+05:30","end_date":"2026-10-21T00:00:00+05:30","location":null,"type":"hackathons","public_url":"hackathons\/procon-jr-indraprastha-institute-of-information-technology-iiit-delhi-1766977","region":"offline","details":"<p>Procon Jr. is a premier school-level competitive programming contest, inspired by the International Olympiad in Informatics (IOI). The event identifies and celebrates budding coding talent among school students through challenging algorithmic and problem-solving tasks that test logical reasoning, creativity, and coding expertise.<\/p>\n<p>The competition also provides unique academic benefits: winners will receive Bonus Points for IIIT-Delhi admissions via JAC counselling, with each point equivalent to a 1 percentile increase in JEE Main score.<\/p>\n<p><strong>Guidelines:<\/strong><\/p>\n<ul>\n<li>Eligibility: Open to all registered school students (up to Class 12).<\/li>\n<li>Participation is individual only &ndash; team participation is not allowed.<\/li>\n<li>Inter-specialization team members: Not applicable (since this event is for school students).<\/li>\n<\/ul>\n<p><strong>Format:<\/strong><\/p>\n<ul>\n<li>Final Round (On-site at IIIT-Delhi campus): Top 40&ndash;50 qualifiers, 3 hours duration.<\/li>\n<li>Number of Problems: 4-7 IOI-style algorithmic problems (exact number revealed during the contest).<\/li>\n<li>Platform: Online round conducted on a coding contest platform with auto-judging; final round held at IIIT-Delhi.<\/li>\n<\/ul>\n<p><strong>Additional Benefits: <\/strong>Bonus points in IIIT-Delhi admissions (via JAC) for top 3 participants.<\/p>\n<p><strong>Rules:<\/strong><\/p>\n<ul>\n<li><strong>You can come to contest even if you have missed the registration just join the group<\/strong><\/li>\n<li>Each participant must be a currently enrolled school student (up to Class 12).<\/li>\n<li>Participation is strictly individual &ndash; no teams allowed.<\/li>\n<li>Submissions must be made only on the contest platform. External IDEs may be used locally, but the final code must be submitted online.<\/li>\n<li>Code plagiarism or unfair means will result in immediate disqualification.<\/li>\n<li>Problems will follow an IOI-style format with partial marking based on test case passes.<\/li>\n<li>Decisions of the organizing committee will be final and binding in all matters.<\/li>\n<li>For the final on-campus round, participants must carry a valid school ID card for verification.<\/li>\n<li>Any technical or system-related issues during the online round must be reported immediately to organizers, but extra time will not be granted.<\/li>\n<\/ul>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":22724220,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-07T01:29:43+05:30","updated_at":"2026-10-07T09:50:34+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"online_coding_challenge","combined_leaderboard":null,"source":null,"short_id":"eFwf4KG","hashtags":null,"participation_certificate":0,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":null,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":14,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-07 01:49:25","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxum