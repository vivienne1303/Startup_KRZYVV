{"data":{"status":true,"competition":{"id":1767402,"visibility":"public","theme_colour":null,"paid":0,"title":"Tech Got Latent","festival_id":null,"organization_id":627,"web_url":null,"start_date":"2026-10-07T00:00:00+05:30","end_date":"2026-10-15T00:00:00+05:30","location":null,"type":"competitions","public_url":"competitions\/tech-got-latent-indraprastha-institute-of-information-technology-iiit-delhi-1767402","region":"offline","details":"<p><strong>Eligibility:<\/strong><\/p>\n<ul>\n<li>The competition is open to <strong>college\/university students only<\/strong>.<\/li>\n<li>Students from any college, university, branch, or specialization are eligible.<\/li>\n<li>This is an <strong>individual competition<\/strong>. Team participation is not allowed.<\/li>\n<li>Participants may choose any form of performance, provided that it is related to <strong>technology<\/strong>.<\/li>\n<\/ul>\n<p><strong>Format:<\/strong><\/p>\n<ul>\n<li>Each participant will be given <strong>1 minute and 30 seconds<\/strong> to perform their act on stage.<\/li>\n<li>Participants are free to choose the format of their performance, as long as it has a clear connection to technology.<\/li>\n<li>Possible performance formats include:\n<ul>\n<li>Tech poetry<\/li>\n<li>Tech comedy or stand-up<\/li>\n<li>Tech roast<\/li>\n<li>Roasting your own startup\/project<\/li>\n<li>Technology-related storytelling<\/li>\n<li>Tech parody<\/li>\n<li>Any other creative technology-related act<\/li>\n<\/ul>\n<\/li>\n<li>Before their performance, the participant will provide their self-rating to the organising team.<\/li>\n<li>After the performance, the participant may interact with the host\/judges.<\/li>\n<\/ul>\n<p><strong>Judging:<\/strong><\/p>\n<ul>\n<li><strong>Performance:<\/strong> The participant performs their chosen technology-related act within the allotted <strong>1 minute and 30 seconds<\/strong>.<\/li>\n<li><strong>Self-Rating:<\/strong> Before their performance, the participant gives themselves a score from <strong>1 to 10<\/strong>.<\/li>\n<li><strong>Judges' Scoring:<\/strong> Each judge independently gives the participant a score from <strong>1 to 10<\/strong>, based on the quality, creativity, execution, and overall impact of the performance.<\/li>\n<li><strong>Judges' Average:<\/strong> The scores given by all judges are averaged to calculate the final judges' score.<\/li>\n<li><strong>The Verdict:<\/strong> If the participant's self-rating <strong>exactly matches the judges' average score<\/strong>, the participant wins the designated reward for that round.<\/li>\n<\/ul>\n<p><strong>Rules:<\/strong><\/p>\n<ul>\n<li>Participation is <strong>strictly individual<\/strong>. No team performances are allowed.<\/li>\n<li>The performance must have a clear <strong>technology-related theme or connection<\/strong>.<\/li>\n<li>Participants are free to choose the format and style of their act.<\/li>\n<li>Participants must provide their <strong>self-rating from 1 to 10<\/strong> before their performance.<\/li>\n<li>The judges' scores will be averaged to determine the final score.<\/li>\n<li>A participant wins the round's designated reward only if their self-rating <strong>exactly matches the judges' average score<\/strong>.<\/li>\n<li>Participants must not attempt to influence or communicate with the judges regarding their scores.<\/li>\n<li>Performances must remain appropriate for a college event. Offensive, discriminatory, or excessively inappropriate content may result in disqualification.<\/li>\n<li>The judges' decision regarding the performance score will be <strong>final and binding<\/strong>.<\/li>\n<li>The organizers reserve the right to intervene or disqualify a participant if their performance violates the event rules or disrupts the event.<\/li>\n<\/ul>\n<p><strong>Winner &amp; Rewards:<\/strong><\/p>\n<ul>\n<li>A participant who achieves an <strong>exact match between their self-rating and the judges' average score<\/strong> will be eligible for the designated reward for that round.<\/li>\n<li>Multiple participants may win rewards if multiple participants achieve an exact match.<\/li>\n<\/ul>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":4335091,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-07T18:33:42+05:30","updated_at":"2026-10-07T19:48:17+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"kUcQjpY","hashtags":null,"participation_certificate":0,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":null,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":2,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-07 18:48:03","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/6ac6547403541_IIIT_Delhi_logo.jpg","logoUrl2":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/150x150\/6ac6547403541_IIIT_Delhi_logo.jpg","regnRequirements":{"id":2499088,"opportunity_id":1767402,"festival_id":null,"max_team_size":1,"min_team_size":1,"start_regn_dt":"2026-10-07T00:00:00+05:30","end_regn_dt":"2026-10-15T00:00:00+05:30","show_deadline":1,"open_for":0,"college_type":0,"same_organisation":0,"study_year_filter":0,"deleted_at":null,"eligibility":"{\"sector\":[\"students\"],\"engineering\":[],\"bSchools\":[],\"arts\":[],\"medicine\":[],\"law\":[],\"others\":[\"all\"],\"experience\":[\"all\"],\"studentPassoutYearsSelected