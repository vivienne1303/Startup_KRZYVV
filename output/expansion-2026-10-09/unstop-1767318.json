{"data":{"status":true,"competition":{"id":1767318,"visibility":"public","theme_colour":"light-blue_un","paid":0,"title":"Fault Hunt","festival_id":519255,"organization_id":2087305,"web_url":null,"start_date":"2026-10-07T00:00:00+05:30","end_date":"2026-10-11T13:00:00+05:30","location":null,"type":"competitions","public_url":"competitions\/fault-hunt-society-of-electronics-engineers-see-indian-institute-of-technology-indian-school-of-mines-dhanb-1767318","region":"offline","details":"<p><strong style=\"color: #000000;\">Fault Hunt:<\/strong><\/p>\n<p><strong>Official Event Rulebook &middot; Concetto 2026:<\/strong><\/p>\n<p><strong>Overview:<\/strong><\/p>\n<p>Fault Hunt is a circuit-analysis and troubleshooting event. Teams find faults in LTspice circuits and justify their findings through systematic analysis.<\/p>\n<p>The event has two rounds:<\/p>\n<ul>\n<li><strong>Round 1 &ndash; Preliminary Individual Quiz<\/strong><\/li>\n<li><strong>Round 2 &ndash; Circuit Fault Analysis<\/strong><\/li>\n<\/ul>\n<p><strong>Prerequisites:<\/strong><\/p>\n<ul>\n<li>Participants must have LTspice installed on their laptop before the event.<\/li>\n<li><strong>Windows:<\/strong> Download LTspice<\/li>\n<li><strong>macOS:<\/strong> Download LTspice<\/li>\n<\/ul>\n<p><strong>Event Structure:<\/strong><\/p>\n<ul>\n<li><strong>Round 1:<\/strong> Preliminary Quiz &mdash; 30 Minutes &mdash; Top 10 Teams<\/li>\n<li><strong>Round 2:<\/strong> Circuit Fault Analysis (LTspice) &mdash; 90 Minutes &mdash; &mdash;<\/li>\n<\/ul>\n<p><strong>Eligibility &amp; Team Specifications:<\/strong><\/p>\n<ul>\n<li>Open to students from all branches.<\/li>\n<li>Team size: 1&ndash;3 members.<\/li>\n<li>Each team must have a unique team name.<\/li>\n<li>A participant may be part of only one team.<\/li>\n<li>Teams must remain unchanged throughout the event.<\/li>\n<\/ul>\n<p><strong>Round 1 &ndash; Preliminary Quiz:<\/strong><\/p>\n<ul>\n<li>The quiz is conducted individually, not team-wise.<\/li>\n<li>Duration: <strong>30 minutes<\/strong>.<\/li>\n<li>Questions cover fundamental electronics and circuit analysis.<\/li>\n<li>Collaboration between team members during the quiz is not permitted.<\/li>\n<\/ul>\n<p><strong>Team Score = Sum of individual scores &divide; Number of team members<\/strong><\/p>\n<p>The top 10 teams based on this score qualify for Round 2.<\/p>\n<p><strong style=\"color: #000000;\">Round 2 &ndash; Circuit Fault Analysis:<\/strong><\/p>\n<ul>\n<li>Duration: <strong>90 minutes<\/strong>.<\/li>\n<li>All qualified teams receive the same LTspice circuit files containing intentional faults.<\/li>\n<li>Teams must identify the faulty component(s) or connection(s), support the finding with simulation results, and explain the cause.<\/li>\n<li>Internet is permitted for datasheets and references only.<\/li>\n<li>Teams submit a short fault report along with their LTspice files before time ends.<\/li>\n<\/ul>\n<p><strong>Evaluation Criteria:<\/strong><\/p>\n<p>The emphasis is not only on finding the correct fault, but on how the team reaches it and explains its reasoning.<\/p>\n<ul>\n<li>Accuracy of Fault Identification &mdash; 30<\/li>\n<li>Troubleshooting Approach &amp; Logical Reasoning &mdash; 25<\/li>\n<li>Use of LTspice Simulation &amp; Measurements &mdash; 20<\/li>\n<li>Clarity &amp; Quality of Explanation &mdash; 15<\/li>\n<li>Handling of Questions &mdash; 10<\/li>\n<li><strong>Total &mdash; 100<\/strong><\/li>\n<\/ul>\n<p><strong>Rules &amp; Regulations:<\/strong><\/p>\n<ul>\n<li>Teams must consist of 1&ndash;3 members.<\/li>\n<li>Round 1 must be attempted individually by every team member.<\/li>\n<li>The top 10 teams qualify for Round 2.<\/li>\n<li>Solutions must be the team's own work.<\/li>\n<li>Plagiarism, cheating or misconduct may result in disqualification.<\/li>\n<li>Judges' decisions are final and binding.<\/li>\n<li>The organisers reserve the right to make necessary changes to the schedule or rules.<\/li>\n<\/ul>\n<p><strong>Prizes:<\/strong><\/p>\n<ul>\n<li>Winner &mdash; \u20b95,000<\/li>\n<li>Runner-up &mdash; \u20b93,000<\/li>\n<li>Second Runner-up &mdash; \u20b92,000<\/li>\n<li><strong>Total Prize Pool &mdash; \u20b910,000<\/strong><\/li>\n<\/ul>\n<p><strong>Debug Smart. Find the Fault.<\/strong><\/p>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":19183409,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-07T17:29:54+05:30","updated_at":"2026-10-07T18:55:06+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"uMwRIXc","hashtags":null,"participation_certificate":0,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":7,"checked":null,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":14,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-07 17:34:08","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/uploadedManual-6ac63465a27c8_77fd11c6-37fa-4cc3-a029-2a7c1f8dae48.jpg","logoUrl2":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/150x150\/uploadedManual-6ac63465a27c8_77fd11c6-37fa-4cc3-a029-2a7c1f8dae48.jpg","regnRequirements":{"id":2499003,"opportunity_id":1767318,"festival_id":null,"max_team_size":3,"min_team_size":1,"start_regn_dt":"2026-10-07T00:00:00+05:30","end_regn_dt":"2026-10-11T13:00:00+05:30","show_deadline":1,"open_for":0,"college_type":0,"same_organisation":0,"study_year_filter":0,"deleted