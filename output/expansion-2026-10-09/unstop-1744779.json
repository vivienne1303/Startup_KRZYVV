{"data":{"status":true,"competition":{"id":1744779,"visibility":"public","theme_colour":null,"paid":0,"title":"Tech4Earth","festival_id":504454,"organization_id":675999,"web_url":null,"start_date":"2026-09-28T00:00:00+05:30","end_date":"2026-10-12T23:00:00+05:30","location":null,"type":"competitions","public_url":"competitions\/tech4earth-techfest26-annual-technical-festival-of-sliet-sant-longowal-institute-of-engineering-and-technol-1744779","region":"offline","details":"<p><strong>Overview:<\/strong><\/p>\n<ul>\n<li>TECH4EARTH is a knowledge competition based on the central theme of TechFEST&rsquo;26, &ldquo;Technology and Science for a Sustainable Earth.&rdquo;<\/li>\n<li>Topics include sustainability, environmental science, renewable energy, climate change, green technology, food technology, artificial intelligence, space science, and recent scientific developments.<\/li>\n<li>The event aims to test scientific knowledge, logical thinking, and awareness of emerging sustainable technologies.<\/li>\n<\/ul>\n<p><strong>Event Objective:<\/strong><\/p>\n<ul>\n<li>Assess participants&rsquo; knowledge of science and technology, logical thinking, awareness of sustainable technologies, and understanding of recent scientific developments through an engaging and competitive quiz.<\/li>\n<\/ul>\n<p><strong>Event Description:<\/strong><\/p>\n<ul>\n<li>The quiz will consist of multiple-choice questions with four options for each question.<\/li>\n<li>Questions will cover sustainability, environmental science, renewable energy, climate change, green technology, food technology, artificial intelligence, space science, and recent scientific developments.<\/li>\n<li>Participants must select the correct answer within the allotted time.<\/li>\n<li>The quiz will test scientific knowledge, logical thinking, general awareness, and understanding of technologies contributing towards a sustainable future.<\/li>\n<\/ul>\n<p><strong>Register Now:<\/strong><br \/><a href=\"https:\/\/www.techfest26.com\/package\">https:\/\/www.techfest26.com\/package<\/a><\/p>\n<p><strong>Judgement Criteria:<\/strong><\/p>\n<ul>\n<li>Accuracy of Answers: Correctness of responses to the questions asked.<\/li>\n<li>Knowledge and Understanding: Understanding of science, technology, sustainability, and related topics.<\/li>\n<li>Awareness of Current Trends: Knowledge of recent scientific developments and emerging technologies.<\/li>\n<li>Application of Knowledge: Ability to apply scientific and logical reasoning to the given questions.<\/li>\n<li>Speed and Completion: Ability to answer the questions accurately within the allotted time.<\/li>\n<\/ul>\n<p><strong>Rules And Regulations:<\/strong><\/p>\n<ul>\n<li>Individual participation only.<\/li>\n<li>Each question will have four options.<\/li>\n<li>Participants must select the correct option within the allotted time.<\/li>\n<li>Use of external resources or internet search is prohibited.<\/li>\n<li>Decorum should be maintained throughout the event.<\/li>\n<li>Any conflict whatsoever may be resolved at the discretion of the event coordinator.<\/li>\n<\/ul>\n<p><strong>Accommodation and Meals:<\/strong><\/p>\n<p><strong>Registration for the techFEST&rsquo;26 package is compulsory for accommodation and other perks, while participation in individual events is free*.<\/strong><\/p>\n<p><strong>Certification Policy:<\/strong><\/p>\n<ul>\n<li>Participation certificate will be provided to all participants.<\/li>\n<li>Certificate of excellence will be provided to the top 3 winners.<\/li>\n<\/ul>\n<p><strong>Important Note:<\/strong><\/p>\n<ul>\n<li>The event is open to participants from all branches\/departments.<\/li>\n<li>Rules and awards are subject to change and may be modified without prior notification.<\/li>\n<li>In case of any update, the documents uploaded on the official TechFEST&rsquo;26 website will be treated as final.<\/li>\n<li>Participants are responsible for visiting the official TechFEST&rsquo;26 website frequently and following the stated instructions.<\/li>\n<li><strong>All payments must be made exclusively through our official TechFest website. Kindly complete your payment through: https:\/\/app.techfest26.com\/package<\/strong><\/li>\n<\/ul>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":null,"registration_clicks":0,"user_id":27463276,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-08-26T23:11:28+05:30","updated_at":"2026-10-07T19:25:35+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"f6BwPsH","hashtags":null,"participation_certificate":0,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":2,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":229,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-08-27 04:06:42","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/uploadedManual-6aad50a2bd81b_logo.webp","logoUrl2":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/150x150\/uploadedManual-6aad50a2bd81b_logo.webp","regnRequirements":{"id":2476085,"opportunity_id":1744779,"festival_id":null,"max_team_size":1,"min_team_size":1,"start_regn_dt":"2026-09-28T00:00:00+05:30","end_regn_dt":"2026-10-10T23:00:00+05:30","show_deadline":1,"open_for":0,"college_type":0,"same_organisation":0,"study_year_filter":0,"deleted_at":null,"eligibility":null,"gender":["A"],"vendor_id":null,"verified_email":1,"verified_mobile"