{"data":{"status":true,"competition":{"id":1767566,"visibility":"public","theme_colour":"blue_un","paid":0,"title":"Tech Mafia - Trust No One. Debug Everyone.","festival_id":null,"organization_id":967,"web_url":null,"start_date":"2026-10-08T00:00:00+05:30","end_date":"2026-10-16T15:00:00+05:30","location":null,"type":"hackathons","public_url":"hackathons\/tech-mafia-trust-no-one-debug-everyone-netaji-subhas-university-of-technology-nsut-delhi-1767566","region":"offline","details":"<p><strong>Tech Mafia<\/strong><span style=\"font-weight: 400;\"> is a team-based technical social deduction game that combines <\/span><strong>coding, debugging, AI prompting, logical reasoning, strategy, deception, and teamwork<\/strong><span style=\"font-weight: 400;\">.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Participants will register individually but will be assigned a team at the beginning of Round 1. They shall compete in teams of <\/span><strong>6<\/strong><span style=\"font-weight: 400;\">, but there is a hidden conflict within every team.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">At the beginning of the event, each participant receives a secret role card. In every team:<\/span><\/p>\n<ul>\n<li><strong>4 participants are Innocents<\/strong><\/li>\n<li><strong>2 participants are Mafia&nbsp;<\/strong><\/li>\n<\/ul>\n<p><span style=\"font-weight: 400;\">The Innocents must work together to complete technical challenges as efficiently as possible.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">The Mafia have a completely different objective: <\/span><strong>slow down, mislead, and sabotage their team without being identified.<\/strong><\/p>\n<p><span style=\"font-weight: 400;\">Across the first two rounds, participants must balance two things - <\/span><strong>performing well and figuring out who they can trust.<\/strong><\/p>\n<p><span style=\"font-weight: 400;\">At the end of Round 2, every team must identify its suspected Mafia members. The outcome of this decision determines which participants advance to the final round.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Round 3 eliminates the team element completely.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">The remaining participants compete individually through a series of technical and mental challenges, with the <\/span><strong>Top 3 performers becoming the final winners of Tech Mafia.<\/strong><\/p>","overall_prizes":"Prizes will consist of cash prize + vouchers + goodies","regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":5077528,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-08T01:02:44+05:30","updated_at":"2026-10-08T12:22:27+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"online_coding_challenge","combined_leaderboard":null,"source":null,"short_id":"qVoNJbS","hashtags":null,"participation_certificate":1,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":30,"checked":null,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":2,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-08 02:03:00","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/6ac728b4a9fe2_220px-Netaji_Subhas_University_of_Technology.svg.png","logoUrl2":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/150x150\/6ac728b4a9fe2_220px-Netaji_Subhas_University_of_Technology.svg.png","regnRequirements":{"id":2499254,"opportunity_id":1767566,"festival_id":null,"max_team_size":1,"min_team_s