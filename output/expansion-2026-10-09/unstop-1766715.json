{"data":{"status":true,"competition":{"id":1766715,"visibility":"public","theme_colour":null,"paid":0,"title":"AeroCraft \u2013 Design & Innovation Challenge","festival_id":521740,"organization_id":17467,"web_url":null,"start_date":"2026-10-08T00:00:00+05:30","end_date":"2026-10-29T16:00:00+05:30","location":null,"type":"competitions","public_url":"competitions\/aerocraft-design-innovation-challenge-crescendo-fr-crce-students-council-1766715","region":"offline","details":"<p><strong>AeroCraft<\/strong> is an aerospace design and innovation challenge that puts your engineering thinking to the test.<\/p>\n<p>Participants will be given an aerospace-oriented problem statement and challenged to develop a virtual CanSat solution using digital design and modelling tools. The challenge is not just about creating a model&mdash;it is about understanding the mission, making smart engineering decisions, working within constraints, and presenting a solution that is both innovative and practical.<\/p>\n<p>Whether you are approaching the challenge through conceptual design or detailed CAD modelling, AeroCraft gives you the opportunity to turn an idea into an engineered solution.<\/p>\n<p><strong>Guidelines:<\/strong><\/p>\n<ul>\n<li>Each team must consist of exactly 3 participants.<\/li>\n<li>Inter-college teams are allowed.<\/li>\n<li>&nbsp;For CRCE Cross-class teams are not permitted.<\/li>\n<li>For non-CRCE teams, all participants must belong to the same academic year.<\/li>\n<li>Each participant can register for only one team.<\/li>\n<li>One problem statement will be provided to each team on the spot.<\/li>\n<li>Teams must develop their solution within the specified time limit.<\/li>\n<li>Participants may use suitable CAD\/3D modelling software. Preferred tools include SolidWorks, Blender, Unigraphics, AutoCAD and Autodesk Fusion 360.<\/li>\n<li>Participants are encouraged to bring their own laptops with the required software installed. Laptop setups will also be available at the venue.<\/li>\n<li>&nbsp;FOR CRCE&nbsp; Teams participation limit per class : 2 Teams<\/li>\n<\/ul>\n<p><strong>Rules:<\/strong><\/p>\n<ul>\n<li>All submitted work must be <strong>original<\/strong> and created by the participating team.<\/li>\n<li>Copying, plagiarism, or submitting another team's design\/work as one's own will result in <strong>disqualification<\/strong>.<\/li>\n<li>Teams must strictly follow the requirements and constraints given in the problem statement.<\/li>\n<li>Teams must submit their work within the <strong>specified time limit<\/strong>.<\/li>\n<li>Only registered team members are permitted to participate in the competition.<\/li>\n<li>Any form of misconduct, misrepresentation, or violation of the competition rules may result in disqualification.<\/li>\n<\/ul>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":33503862,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-06T15:36:41+05:30","updated_at":"2026-10-08T15:01:53+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"innovation_challenge","combined_leaderboard":null,"source":null,"short_id":"5jvabPU","hashtags":null,"participation_certificate":0,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":2,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":0,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-06 15:37:55","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images