{"data":{"status":true,"competition":{"id":1764127,"visibility":"public","theme_colour":"blue_un","paid":0,"title":"Pixel Patakha","festival_id":520881,"organization_id":943045,"web_url":null,"start_date":"2026-10-01T00:00:00+05:30","end_date":"2026-10-23T16:00:00+05:30","location":null,"type":"competitions","public_url":"competitions\/pixel-patakha-bharati-vidyapeeths-college-of-engineering-1764127","region":"offline","details":"<div id=\"model-response-message-contentr_6a8ddab858354e0b\" class=\"markdown markdown-main-panel md-content enable-luminous-fast-follows enable-updated-hr-color stronger tutor-markdown-rendering\" dir=\"ltr\" aria-busy=\"false\" aria-live=\"polite\">\n<p data-path-to-node=\"0\"><strong>About the Event:<\/strong><\/p>\n<p data-path-to-node=\"0\"><strong data-path-to-node=\"1\" data-index-in-node=\"0\">Pixel Patakha<\/strong> is an intense, high-energy 3-hour UI\/UX design challenge where design teams race against the clock to turn a surprise problem statement into an intuitive, visually stunning digital experience. Focused on real-world usability, design systems, and creative execution, this event tests your ability to innovate under pressure and articulate design decisions effectively.<\/p>\n<p><strong data-path-to-node=\"2\" data-index-in-node=\"0\">Theme Line:<\/strong> Create. Design. Innovate. Make your pixels count.<\/p>\n<p data-path-to-node=\"4\"><strong>Round-wise Details:<\/strong><\/p>\n<p data-path-to-node=\"5\">Round 1: Mentorship &amp; Progress Review<\/p>\n<ul data-path-to-node=\"6\">\n<li>\n<div><strong data-path-to-node=\"6,0,0\" data-index-in-node=\"0\">Duration:<\/strong> In-person check-in during the 3-hour design sprint.<\/div>\n<\/li>\n<li>\n<div><strong data-path-to-node=\"6,1,0\" data-index-in-node=\"0\">Mechanism:<\/strong> Judges and mentors interact with teams to review mid-process wireframes, provide constructive feedback, and assess design direction.<\/div>\n<\/li>\n<\/ul>\n<p data-path-to-node=\"7\">Round 2: Final Design Submission &amp; Evaluation<\/p>\n<ul data-path-to-node=\"8\">\n<li>\n<div><strong data-path-to-node=\"8,0,0\" data-index-in-node=\"0\">Mechanism:<\/strong> Teams complete their high-fidelity prototypes and submit their final design file links\/presentations before the 3-hour timer expires.<\/div>\n<\/li>\n<li>\n<div><strong data-path-to-node=\"8,1,0\" data-index-in-node=\"0\">Judging Criteria:<\/strong> Concept &amp; Visual Execution, User Experience &amp; Functionality, Innovation, Responsiveness, and Design Rationale.<\/div>\n<\/li>\n<\/ul>\n<p data-path-to-node=\"10\"><strong>Rules and Guidelines:<\/strong><\/p>\n<ul>\n<li>\n<div><strong data-path-to-node=\"11,0,0\" data-index-in-node=\"0\">Team Size:<\/strong> 1&ndash;3 participants per team.<\/div>\n<\/li>\n<li>\n<div><strong data-path-to-node=\"11,1,0\" data-index-in-node=\"0\">Duration:<\/strong> 3 hours. Late submissions will result in instant disqualification.<\/div>\n<\/li>\n<li>\n<div><strong data-path-to-node=\"11,2,0\" data-index-in-node=\"0\">Approved Tools:<\/strong> Designs must be created and presented using Figma, Canva, or Adobe XD.<\/div>\n<\/li>\n<li>\n<div><strong data-path-to-node=\"11,3,0\" data-index-in-node=\"0\">Hardware Requirements:<\/strong> Participants must bring their own laptops, necessary peripherals, and a stable internet connection.<\/div>\n<\/li>\n<li>\n<div><strong data-path-to-node=\"11,4,0\" data-index-in-node=\"0\">AI Policy:<\/strong> Generative AI is strictly prohibited for core design elements, layout generation, and brainstorming.<\/div>\n<\/li>\n<\/ul>\n<p><strong data-path-to-node=\"11,5,0\" data-index-in-node=\"0\">Originality &amp; Fair Play:<\/strong><\/p>\n<ul>\n<li>All work must be created live during the event.<\/li>\n<li>Platforms like Dribbble or Pinterest may be used strictly for visual reference, but the final output must be 100% original.<\/li>\n<li>Judges reserve the right to inspect file version history to verify live creation.<\/li>\n<li>Third-party assets used must be credited upon submission. Plagiarism or unauthorized external help will lead to immediate disqualification.<\/li>\n<li>\n<div><strong data-path-to-node=\"11,6,0\" data-index-in-node=\"0\">Authority:<\/strong> The judges' decision is final, binding, and non-contestable.<\/div>\n<\/li>\n<\/ul>\n<p><strong>For Queries Contact :-<\/strong><\/p>\n<p><strong>Rajdip Biswas - <\/strong>6289940712<\/p>\n<p><strong>Aadya Srivastava- <\/strong>7827291553<\/p>\n<p>&nbsp;<\/p>\n<\/div>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":33478161,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-01T12:42:43+05:30","updated_at":"2026-10-02T17:07:42+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"AtuES1o","hashtags":null,"participation_certificate":0,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":null,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":37,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-01 12:45:37","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/uploadedManual-6abe08086eff6_bvestlogo_final_1.png","logoUrl2":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/150x150\/uploadedManual-6abe08086eff6_bvestlogo_final_1.png","regnRequirements":{"id":2495734,"opportunity_id":1764127,"festival_id":null,"max_team_size":3,"min_t