{"data":{"status":true,"competition":{"id":1766420,"visibility":"public","theme_colour":"blue_un","paid":0,"title":"AlgoSort","festival_id":null,"organization_id":13183,"web_url":null,"start_date":"2026-10-06T00:00:00+05:30","end_date":"2026-10-09T00:00:00+05:30","location":null,"type":"competitions","public_url":"competitions\/algosort-indian-institute-of-technology-indian-school-of-mines-iit-ism-dhanbad-1766420","region":"offline","details":"<p>AlgoSort is a high-energy academic team competition that combines mathematical problem-solving, algorithmic thinking, strategic decision-making, and live physical coordination. Participants will not only be required to solve mathematical problems accurately but will also have to use their answers to execute a physical sorting sequence under strict time constraints.<\/p>\n<p>The competition is designed to test a team's ability to combine individual mathematical accuracy with collective strategy, communication, coordination, and algorithmic thinking.<\/p>\n<p><strong>Guidlines:<\/strong><\/p>\n<ul>\n<li>Institution: Indian Institute of Technology (Indian School of Mines), Dhanbad<\/li>\n<li>Format: Live Action Mathematical Strategy Game<\/li>\n<li>Team Size: 5 members per team<\/li>\n<li>Duration: Approximately 2&ndash;3 hours<\/li>\n<li>Round Format: Fixed time limit per round<\/li>\n<li>Venue: NLHC (Offline)<\/li>\n<li>Prize Pool: \u20b910,000 + Goodies &amp; Certificates<\/li>\n<\/ul>\n<p><strong>Eligibility &amp; Team Formation:<\/strong><\/p>\n<ul>\n<li>Participants will compete in teams of exactly 4 members.<\/li>\n<li>Each team must have five registered participants before the beginning of the competition.<\/li>\n<li>Inter-college teams: Allowed.<\/li>\n<li>Inter-specialization\/department teams: Allowed.<\/li>\n<li>Participants from different academic years, departments, specializations, and institutions may form a team, subject to the event<\/li>\n<li>registration requirements.<\/li>\n<li>Each participant will be assigned an individual mathematical problem during every round.<\/li>\n<li>Team members must work individually during the problem-solving phase and may not confer while solving their assigned problems.<\/li>\n<li>All team members must be physically present at the designated competition area during the relevant round.<\/li>\n<\/ul>\n<p><strong>Rulebook: <a title=\"Rulebook\" href=\"https:\/\/docs.google.com\/document\/d\/1FLCTQXI6_IPPqyfn0otiNzYZb1y2sMCCkaCxeQeOKWk\/edit?usp=sharing\" target=\"_self\">https:\/\/docs.google.com\/document\/d\/1FLCTQXI6_IPPqyfn0otiNzYZb1y2sMCCkaCxeQeOKWk\/edit?usp=sharing<\/a><\/strong><\/p>","overall_prizes":"Prize money","regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":33533275,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-06T01:49:39+05:30","updated_at":"2026-10-06T14:00:11+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"HwiSVrQ","hashtags":null,"participation_certificate":0,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":30,"checked":null,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":0,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-06 10:00:41","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/6ac4b185f32ca_IIT_dh_logo.png","logoUrl2":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/150x150\/6ac4b185f32ca_IIT_dh_logo.png","regnRequirement