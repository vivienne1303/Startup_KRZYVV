{"data":{"status":true,"competition":{"id":1766839,"visibility":"public","theme_colour":null,"paid":0,"title":"Code Kernel '26 ","festival_id":null,"organization_id":12935,"web_url":null,"start_date":"2026-10-06T00:00:00+05:30","end_date":"2026-10-20T00:00:00+05:30","location":null,"type":"hackathons","public_url":"hackathons\/code-kernel-26-gokaraju-rangaraju-institute-of-engineering-and-technology-griet-hyderabad-1766839","region":"online","details":"<p><strong>Code Kernel '26<\/strong> | Decode &rarr; Build &rarr; Prove<\/p>\n<p>An online national problem-solving competition by <strong>X-Kernel<\/strong>, the student-led technical and innovation club of <strong>Gokaraju Rangaraju Institute of Engineering and Technology (GRIET), Hyderabad<\/strong>.<\/p>\n<p><strong>Tentative dates:<\/strong> 12 October &ndash; 21 October 2026<br \/><strong>Mode:<\/strong> Online<br \/><strong>Team size:<\/strong> 1 to 4 engineering students<br \/><strong>Format:<\/strong> Decode &rarr; Build &rarr; Prove<\/p>\n<p><strong>What It Is<\/strong><br \/>Engineering Students Enter in Teams of 1 to 4. Each Team Takes One Real Problem Through Three Stages in Order. This Is <em>Not<\/em> a Pitch Contest and <em>Not<\/em> a Prototype-Only Hackathon. The work has to hold up when the Test Changes.<\/p>\n<p><strong>Stages<\/strong><\/p>\n<ul>\n<li>\n<p><strong>Decode<\/strong> &mdash; Understand the Real Problem Before Writing a Solution. Root Cause, People Affected, Limits Already in Place, and Whether the Approach Can Work.<\/p>\n<\/li>\n<li>\n<p><strong>Build<\/strong> &mdash; Make a Practical Response, Not a Slide. Software, Ai\/ml, Web or Mobile, Automation, Data, a Technical or Business Solution, a Hardware Simulation, or A Proof of Concept.<\/p>\n<\/li>\n<li>\n<p><strong>Prove<\/strong> &mdash; Show that It Still Works when The Test Changes. Unseen Checks, Extra Constraints, New Test Cases, a Technical Evaluation, a Live Demo and Questions.<\/p>\n<\/li>\n<\/ul>\n<p><strong>Problems<\/strong><br \/>Each Problem Is Framed as <strong>Problem, Context, Constraints and Expected Outcome<\/strong>. Sponsor Partners May Contribute Problem Statements. the Day-By-Day Round Calendar Inside the Tentative Window Is to Be Decided.<\/p>\n<p><strong>Eligibility<\/strong><\/p>\n<ul>\n<li>Open to <strong>Engineering Students Across India<\/strong><\/li>\n<li>Teams of <strong>1 to 4<\/strong><\/li>\n<li><strong>Online<\/strong> participation<\/li>\n<\/ul>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":33543691,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-06T20:20:53+05:30","updated_at":"2026-10-06T22:57:30+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"online_coding_challenge","combined_leaderboard":null,"source":null,"short_id":"mtDibqB","hashtags":null,"participation_certificate":0,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":null,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":17,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-06 20:39:03","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/uploadedManual-6ac50ecadd7da_xkernel-newlogo1.png","logoUrl2":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/150x150\/uploadedManual-6ac50ecadd7da_xkernel-newlogo1.png","regnRequirements":{"id":2498515,"opportunity_id":1766839,"festival_id":null,"max_team_size":4,"min_team_size":1,"start_regn_dt":"2026-10-06T00: