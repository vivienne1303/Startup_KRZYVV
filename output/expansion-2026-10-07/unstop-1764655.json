{"data":{"status":true,"competition":{"id":1764655,"visibility":"public","theme_colour":null,"paid":0,"title":"Dream City","festival_id":null,"organization_id":212585,"web_url":null,"start_date":"2026-10-01T00:00:00+05:30","end_date":"2026-10-08T18:00:00+05:30","location":null,"type":"competitions","public_url":"competitions\/dream-city-xim-university-bhubaneswar-1764655","region":"hybrid","details":"<p><strong>Theme:<\/strong><\/p>\n<p><strong>From Flood to Flow: Reimagining Urban Water Management<\/strong><\/p>\n<p><strong>Eligibility Criteria:<\/strong><\/p>\n<ul>\n<li>Undergraduate \/ Postgraduate Students<\/li>\n<\/ul>\n<p><strong>Team Size:<\/strong><\/p>\n<ul>\n<li>2 members<\/li>\n<\/ul>\n<p><strong>Mode:<\/strong><\/p>\n<ul>\n<li>Hybrid (Online \/ Offline)<\/li>\n<\/ul>\n<p><strong>Time Limit:<\/strong><\/p>\n<ul>\n<li>10 minutes<\/li>\n<\/ul>\n<p><strong>Registration &amp; Submission Deadline:<\/strong><\/p>\n<ul>\n<li>8 October 2026<\/li>\n<\/ul>\n<p><strong>Notification for Selection:<\/strong><\/p>\n<ul>\n<li>To be announced<\/li>\n<\/ul>\n<p><strong>Registration Fees:<\/strong><\/p>\n<ul>\n<li>\u20b9300 Per Preson<\/li>\n<\/ul>\n<p><strong>Rules &amp; Regulations:<\/strong><\/p>\n<ul>\n<li>On-the-spot registration will not be allowed.<\/li>\n<li>Teams must propose an innovative and practical solution to an urban challenge related to urban flooding and water management.<\/li>\n<li>The proposed solution should demonstrate a clear understanding of the identified urban water challenge.<\/li>\n<li>The solution should incorporate innovative approaches, technologies, planning strategies, or nature-based solutions wherever relevant.<\/li>\n<li>The submission must include a PPT\/Pitch Deck covering:\n<ul>\n<li>Problem definition \/ urban challenge being addressed<\/li>\n<li>Context and existing situation<\/li>\n<li>Proposed solution<\/li>\n<li>Innovation and applicability of the proposed intervention<\/li>\n<li>Business \/ financial feasibility, wherever applicable<\/li>\n<li>Implementation roadmap<\/li>\n<li>Technical and operational feasibility<\/li>\n<li>Long-term impact and scalability<\/li>\n<\/ul>\n<\/li>\n<li>The proposal should demonstrate how the intervention can help cities move from flood vulnerability towards water resilience.<\/li>\n<li>Teams may be required to present their proposal before the jury.<\/li>\n<li>The presentation must be completed within the 10-minute time limit.<\/li>\n<li>The use of foul language, inappropriate content, or rude behavior with organizers is strictly prohibited.<\/li>\n<li>Any team found violating the rules may be disqualified.<\/li>\n<li>The decision of the jury shall be final and binding on all participants with regard to the interpretation of the rules and regulations.<\/li>\n<\/ul>","overall_prizes":"\u20b96000 prize pool","regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":26594113,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-02T02:00:43+05:30","updated_at":"2026-10-06T12:56:07+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"fGVhMRs","hashtags":null,"participation_certificate":0,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":2,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":0,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-02 02:03:47","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/imag