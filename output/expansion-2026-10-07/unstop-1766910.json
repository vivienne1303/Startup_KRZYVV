{"data":{"status":true,"competition":{"id":1766910,"visibility":"public","theme_colour":null,"paid":0,"title":"Render for Change | AI Art Competition","festival_id":null,"organization_id":10586,"web_url":null,"start_date":"2026-10-06T00:00:00+05:30","end_date":"2026-10-08T12:00:00+05:30","location":null,"type":"competitions","public_url":"competitions\/render-for-change-ai-art-competition-cluster-innovation-centre-ducic-university-of-delhi-du-delhi-1766910","region":"online","details":"<p><strong>AI Art Competition<\/strong><\/p>\n<p><strong>Imagine. Create. Inspire change.<\/strong><\/p>\n<p>We invite artists, creators, and AI enthusiasts to use the power of <strong>artificial intelligence and visual storytelling<\/strong> to envision a cleaner, greener, and more responsible India.<\/p>\n<p>Create a striking AI-generated artwork that captures your interpretation of <strong>Swachhata<\/strong>. Your artwork may explore <strong>cleanliness, waste management, sustainability, civic responsibility, environmental awareness, public spaces, or community participation<\/strong>. Think beyond the obvious and use your imagination to create a visual that makes people pause, think, and engage with the idea of a cleaner India.<\/p>\n<p>Theme: <strong>Swachhata Hi Seva: Every Action Counts<\/strong><\/p>\n<p><strong>Rules &amp; Guidelines<\/strong><\/p>\n<ul>\n<li><strong>One participation per individual<\/strong>.<\/li>\n<li>Participants must submit <strong>one AI-generated artwork<\/strong>.<\/li>\n<li>The artwork must be created specifically for this competition and must be <strong>directly relevant to the theme of Swachhata<\/strong>.<\/li>\n<li>The artwork must be submitted in <strong>HD\/high-resolution format<\/strong>.<\/li>\n<li>Participants must use <strong>one single prompt<\/strong> to generate their final artwork.<\/li>\n<li>The <strong>exact prompt used<\/strong> to generate the submitted artwork must be provided along with the entry.<\/li>\n<li>Participants must clearly mention the <strong>AI tool\/AI agent<\/strong> used to generate the artwork.<\/li>\n<li>The final artwork must be generated using AI. <strong>Combining multiple AI-generated images or using multiple prompts is not permitted.<\/strong><\/li>\n<li>Participants may use any AI image-generation platform\/tool of their choice.<\/li>\n<li>Entries must be original and must not contain offensive, discriminatory, defamatory, or inappropriate content.<\/li>\n<li>Entries must be submitted by <strong>8th October, 2026 by 12 pm<\/strong> through <strong>Unstop.<\/strong><\/li>\n<li>The organisers reserve the right to disqualify entries that do not follow the guidelines or are not relevant to the theme.<\/li>\n<\/ul>\n<p><strong>Judging Criteria<\/strong><\/p>\n<p>Entries will be evaluated on:<\/p>\n<ul>\n<li>Relevance to the theme<\/li>\n<li>Creativity and originality<\/li>\n<li>Visual appeal and composition<\/li>\n<li>Effective use of AI<\/li>\n<li>Clarity and impact of the message<\/li>\n<li>Overall presentation<\/li>\n<\/ul>\n<p><strong>One prompt. One vision. One powerful picture of a cleaner India.<\/strong><\/p>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":21501317,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-06T22:26:25+05:30","updated_at":"2026-10-06T23:27:05+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"R7iCmAf","hashtags":null,"participation_certificate":1,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":null,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":19,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college