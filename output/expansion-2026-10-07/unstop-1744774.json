{"data":{"status":true,"competition":{"id":1744774,"visibility":"public","theme_colour":null,"paid":0,"title":"Food Forge","festival_id":504454,"organization_id":675999,"web_url":"www.techfest26.com\/","start_date":"2026-08-26T00:00:00+05:30","end_date":"2026-10-13T22:23:11+05:30","location":null,"type":"competitions","public_url":"competitions\/food-forge-techfest26-annual-technical-festival-of-sliet-sant-longowal-institute-of-engineering-and-technol-1744774","region":"offline","details":"<p><strong>New Product Development:<\/strong><\/p>\n<p><strong>Overview:<\/strong><\/p>\n<ul>\n<li>&ldquo;New Product Development&rdquo; is an innovative food product development event where participants independently conceptualize and develop a unique food product of their choice.<\/li>\n<li>Participants will use their creativity and food technology knowledge to develop the product within a limited time.<\/li>\n<li>The event combines culinary creativity, product development, nutritional considerations, packaging, and marketing concepts.<\/li>\n<li>Participants are encouraged to transform their original ideas into commercially viable food products.<\/li>\n<\/ul>\n<p><strong>Event Objective:<\/strong><\/p>\n<ul>\n<li>To develop an innovative food product using randomly provided ingredients while encouraging creativity, innovation, product development skills, teamwork, and entrepreneurial thinking.<\/li>\n<\/ul>\n<p><strong>Event Description:<\/strong><\/p>\n<ul>\n<li>Explain the ingredients, preparation process, and nutritional facts of the developed product.<\/li>\n<li>Present the product concept, target consumers, and its unique selling proposition (USP).<\/li>\n<li>Explain the packaging concept and proposed marketing strategy.<\/li>\n<li>Participate in a jury Q&amp;A session about the product, its development, nutritional aspects, and market potential.<\/li>\n<\/ul>\n<p><strong>Judgement Criteria:<\/strong><\/p>\n<ul>\n<li>Innovation and Uniqueness of the Product: Originality and creativity of the developed food product.<\/li>\n<li>Utilization of Ingredients: Effective and innovative utilization of the ingredients provided to the participants.<\/li>\n<li>Nutritional Value: Nutritional benefits and suitability of the product for the proposed target consumers.<\/li>\n<li>Hygiene and Marketing Concept: Practicality and effectiveness of hygiene practices and marketing strategy.<\/li>\n<li>Presentation and Teamwork: Clarity of explanation, confidence, creativity, coordination, and teamwork.<\/li>\n<\/ul>\n<p><strong>Rules &amp; Regulations:<\/strong><\/p>\n<ul>\n<li>Each team must consist of a minimum of 1 participant and a maximum of 3 participants.<\/li>\n<li>The product must be prepared within the allotted time.<\/li>\n<li>Decorum should be maintained in the lab provided throughout the event.<\/li>\n<li>Any conflict whatsoever may be resolved at the discretion of the event coordinator.<\/li>\n<li>Any damage to the apparatus will not be tolerated.<\/li>\n<\/ul>\n<p><strong>Registration Note:<\/strong><\/p>\n<ul>\n<li>Registration is mandatory for participation.<\/li>\n<li>The fee once paid is non-refundable.<\/li>\n<li>Participants can follow the official Instagram and other social media platforms for updates.<\/li>\n<li>Register through the techFEST'26 package page.<\/li>\n<li>\n<p><strong>Register Now:<\/strong><br \/><a href=\"https:\/\/www.techfest26.com\/package\">https:\/\/www.techfest26.com\/package<\/a><\/p>\n<\/li>\n<\/ul>\n<p><strong>Accommodation and Meals:<\/strong><\/p>\n<p><strong>Registration for the techFEST&rsquo;26 package is compulsory for accommodation and other perks, while participation in individual events is free*.<\/strong><\/p>\n<p><strong>Certification Policy:<\/strong><\/p>\n<ul>\n<li>Participation certificates will be provided to all participants.<\/li>\n<li>Certificates of excellence will be provided to the winners.<\/li>\n<\/ul>\n<p><strong>Important Note:<\/strong><\/p>\n<ul>\n<li>The event is open to participants from all branches\/departments.<\/li>\n<li>Rules and awards are subject to change and, in the worst case, may change without notifying the team.<\/li>\n<li>In case of any update, the documents uploaded on the official techFEST'26 website will be treated as final.<\/li>\n<li>Participants are responsible for visiting the official techFEST'26 website frequently and following the stated instructions.<\/li>\n<\/ul>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":null,"registration_clicks":0,"user_id":27463276,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-08-26T23:09:38+05:30","updated_at":"2026-10-06T22:23:12+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"innovation_challenge","combined_leaderboard":null,"source":null,"short_id":"z8QgUs3","hashtags":null,"participation_certificate":0,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":2,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":98,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-08-27 04:05:46","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/uploadedManual-6aad510a1733f_logo.webp","logoUrl2":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/150x150\/uploadedManual-6aad510a1733f_logo.webp","regnRequirements":{"id":2476080,"opportunity_id":1744774,"festival_id":null,"max_team_size":3,"min_team_size":1,"start_regn_dt":"2026-08-26T00:00:00+05:30","end_regn_dt":"2026-10-13T22:23:11+05:30","show_deadlin