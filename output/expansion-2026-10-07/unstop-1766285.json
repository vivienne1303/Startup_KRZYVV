{"data":{"status":true,"competition":{"id":1766285,"visibility":"public","theme_colour":null,"paid":0,"title":"Code War 8.0","festival_id":null,"organization_id":106,"web_url":"codewar.aec.ac.in","start_date":"2026-10-05T00:00:00+05:30","end_date":"2026-10-10T00:00:00+05:30","location":null,"type":"hackathons","public_url":"hackathons\/code-war-80-assam-engineering-college-aec-assam-1766285","region":"online","details":"<p><span data-path-to-node=\"3,0\"><strong data-path-to-node=\"0,0\" data-index-in-node=\"0\">IMPORTANT REGISTRATION NOTE:<\/strong> In addition to registering on this platform, <strong data-path-to-node=\"0,0\" data-index-in-node=\"74\">all participants must complete the official registration form<\/strong> <a href=\"https:\/\/forms.gle\/HmBCMmtc7HysPvTk8\">here<\/a><\/span><\/p>\n<p><span data-path-to-node=\"3,0\">CODESTELLATION is a 24-hour online hackathon where virtual teams collaborate, code, and build innovative tech solutions to solve real-world problem statements and ship a working prototype<\/span><span data-path-to-node=\"3,2\">.<\/span><\/p>\n<p><strong data-path-to-node=\"5\" data-index-in-node=\"0\">Guidelines:<\/strong><\/p>\n<ul data-path-to-node=\"6\">\n<li>Format: 100% Online \/ Virtual 24-hour team-based hackathon focused on building and shipping a working prototype.<\/li>\n<li>Eligibility: Open to all registered students and tech enthusiasts globally participating in teams.<\/li>\n<li>Inter-college Team Members: Allowed (Participants from different institutions can form a team).<\/li>\n<li>Inter-specialization Team Members: Allowed (Participants across different departments\/branches can form a team).<\/li>\n<li>Problem Statements: Real-world problem statements will be released online at the start of the event.<\/li>\n<li>Duration of Rounds: Single continuous 24-hour online hackathon round.<\/li>\n<li>Platform &amp; Tools: Whatsapp Group for communication and mentoring; GitHub\/Devpost for project submissions.<\/li>\n<\/ul>\n<p data-path-to-node=\"8\"><strong data-path-to-node=\"8\" data-index-in-node=\"0\">Rules:<\/strong><\/p>\n<ul data-path-to-node=\"9\">\n<li>Team-Based Structure: Participation is strictly team-based.<\/li>\n<li>Virtual Presence: Teams must stay active on the official online event platform (e.g., Discord) for announcements, mentoring sessions, and check-ins.<\/li>\n<li>Originality &amp; Commit History: All development and design work must take place within the 24-hour timeframe. Code repository commit history must reflect work done during the hackathon hours.<\/li>\n<li>Deliverables: Teams must submit a functional working prototype, a public repository link (e.g., GitHub), and a short video demonstration before the deadline.<\/li>\n<li>Relevance: The prototype built must directly address one of the assigned real-world problem statements.<\/li>\n<li>Code of Conduct: Plagiarism, submitting pre-existing projects, or improper online behavior will lead to immediate disqualification.<\/li>\n<\/ul>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":28350456,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-05T21:28:50+05:30","updated_at":"2026-10-06T16:54:55+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"online_coding_challenge","combined_leaderboard":null,"source":null,"short_id":"VB7Fs6k","hashtags":null,"participation_certificate":1,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":2,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":1,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-05 21:31:27","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0