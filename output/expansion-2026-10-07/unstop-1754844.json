{"data":{"status":true,"competition":{"id":1754844,"visibility":"public","theme_colour":"blue_un","paid":0,"title":"Infothon 7.0","festival_id":null,"organization_id":1405,"web_url":null,"start_date":"2026-09-16T10:00:00+05:30","end_date":"2026-10-24T21:00:00+05:30","location":null,"type":"hackathons","public_url":"hackathons\/infothon-70-vidyavardhaka-college-of-engineering-mysore-1754844","region":"offline","details":"<p><strong>Overview<\/strong><\/p>\n<p>The ultimate offline hackathon hosted by the Information Science Department of VVCE Mysore!<\/p>\n<p><strong data-start=\"301\" data-end=\"317\">Infothon 7.0<\/strong> is an exhilarating <strong>10-hour<\/strong> coding challenge held at the prestigious VVCE campus in Mysore. This event unites passionate innovators, programmers, and problem solvers to ignite creativity, foster collaboration, and drive breakthroughs in <strong data-start=\"562\" data-end=\"607\">Agentic Intelligence &amp; Autonomous Systems<\/strong>, with a dedicated focus on advancing <strong data-start=\"645\" data-end=\"672\">Sustainable Development<\/strong>.<\/p>\n<p><strong>Why Join Infothon 7.0?<\/strong><\/p>\n<ul>\n<li data-start=\"709\" data-end=\"764\">Test your skills and learn from industry experts.<\/li>\n<li data-start=\"767\" data-end=\"866\">Showcase your talent by creating cutting-edge solutions that support sustainable development.<\/li>\n<li data-start=\"869\" data-end=\"935\">Network with professionals and build meaningful connections.<\/li>\n<li data-start=\"938\" data-end=\"1057\">Experience the thrill of competition while contributing to the future of Agentic Intelligence &amp; Autonomous Systems.<\/li>\n<\/ul>\n<p><strong>Code of Conduct:<\/strong><\/p>\n<ul>\n<li data-start=\"1086\" data-end=\"1173\">Follow all event guidelines to ensure a positive, diverse, and inclusive environment.<\/li>\n<li data-start=\"1176\" data-end=\"1261\">Maintain respectful interactions with fellow participants, mentors, and organizers.<\/li>\n<li data-start=\"1264\" data-end=\"1331\">Cheating or misconduct will result in immediate disqualification.<\/li>\n<li data-start=\"1334\" data-end=\"1394\">Ensure a harassment-free experience for everyone involved.<\/li>\n<li data-start=\"1397\" data-end=\"1492\">Strictly adhere to disciplinary rules; participants must remain on-site throughout the event.<\/li>\n<li data-start=\"1495\" data-end=\"1564\">Teams will be shortlisted based on the quality of their presentation.<\/li>\n<\/ul>\n<p><strong>Registration Fee:<\/strong> Rs. 350 per team<\/p>\n<p>Join us at <strong data-start=\"1631\" data-end=\"1647\">Infothon 7.0<\/strong>, where creativity, collaboration, and coding excellence come together to build smarter, safer solutions in Agentic Intelligence &amp; Autonomous Systems.<\/p>\n<p><strong>Architecting an Autonomous Tomorrow.<\/strong><\/p>","overall_prizes":"","regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":7742370,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-09-12T17:21:05+05:30","updated_at":"2026-09-16T20:36:03+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"online_coding_challenge","combined_leaderboard":null,"source":null,"short_id":"aMWPD3T","hashtags":null,"participation_certificate":1,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":2,"checked":2,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":211,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-09-12 18:03:08","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"lo