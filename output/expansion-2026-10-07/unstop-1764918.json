{"data":{"status":true,"competition":{"id":1764918,"visibility":"public","theme_colour":null,"paid":0,"title":"Actonomics \u2014 the Economics Charades","festival_id":null,"organization_id":136795,"web_url":null,"start_date":"2026-10-02T23:59:00+05:30","end_date":"2026-11-04T15:30:00+05:30","location":null,"type":"competitions","public_url":"competitions\/actonomics-the-economics-charades-kamala-nehru-college-knc-du-delhi-1764918","region":"offline","details":"<p><em>No Words. Just Wits, Moves &amp; Economics.<\/em><\/p>\n<p>Get ready for a fun twist on the classic game of Dumb Charades &mdash; where movies and characters are replaced by the language of Economics!<\/p>\n<p>Actonomics is an engaging and entertaining game that challenges participants to identify Economics-related terms and concepts through gestures and actions, without using words.<\/p>\n<p><strong>Guidelines:<\/strong><\/p>\n<ul>\n<li>The competition is open to all undergraduate students.<\/li>\n<li>Participants must register in <strong>teams of 4.<\/strong><\/li>\n<\/ul>\n<p><strong>Rules:<\/strong><\/p>\n<p><strong>How It Works<\/strong><\/p>\n<ul>\n<li>Participants will compete in teams of 4.<\/li>\n<li>In each turn, one member of the team will pick an Economics-related word or phrase.<\/li>\n<li>The participant will have 60 seconds to act out the given term while their teammates try to guess it.<\/li>\n<li>No speaking, writing, spelling through gestures, or verbal clues are allowed.<\/li>\n<li>The game will consist of multiple rounds, with the difficulty level increasing as the rounds progress.<\/li>\n<li>Teams will earn points based on how quickly they correctly guess the given term.<\/li>\n<\/ul>\n<p><strong>Scoring:<\/strong><\/p>\n<ul>\n<li>Correct guess within 30 seconds: 10 points<\/li>\n<li>Correct guess within 60 seconds: 5 points<\/li>\n<li>Pass \/ No correct guess: 0 points<\/li>\n<\/ul>\n<p><strong>The Steal<\/strong><\/p>\n<p>If a team fails to guess the term within their allotted time, another team will get an opportunity to steal the answer.<\/p>\n<p>A successful steal will earn the team 5 points.<\/p>","overall_prizes":"Prizes for 1st, 2nd & 3rd, plus certificates and exciting surprise rewards!","regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":4879033,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-02T19:30:57+05:30","updated_at":"2026-10-03T00:26:09+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"70pe5ID","hashtags":null,"participation_certificate":0,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":null,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":9,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-02 21:00:41","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/uploadedManual-6abfccaef0aaf_1000221610.webp","logoUrl2":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/150x150\/uploadedManual-6abfccaef0aaf_1000221610.webp","regnRequirements":{"id":2496553,"opportunity_id":1764918,"festival_id":null,"max_team_size":4,"min_team_size":3,"start_regn_dt":"2026-10-02T23:59:00+05:30","end_regn_dt":"2026-10-31T00:00:00+05:30","show_deadline":1,"open_for":0,"college_type":0,"same_organisation":0,"study_year_filter":0,"deleted_at":null,"eligibility":"{\"sector\":[\"students\"],\"engineering\":[\"allCourses\",{\"course\":\"btech\",\"type\":\"engineer