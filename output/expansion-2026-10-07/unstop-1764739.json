{"data":{"status":true,"competition":{"id":1764739,"visibility":"public","theme_colour":"blue_un","paid":0,"title":"Ideas On Trial","festival_id":520881,"organization_id":943045,"web_url":null,"start_date":"2026-10-02T00:00:00+05:30","end_date":"2026-10-22T16:00:00+05:30","location":null,"type":"competitions","public_url":"competitions\/ideas-on-trial-bharati-vidyapeeths-college-of-engineering-1764739","region":"offline","details":"<p><strong>About the Event:<\/strong><\/p>\n<p><strong>Ideas on Trial<\/strong> is a high-concept business plan competition hosted by <strong>TechShuttle BVCOE<\/strong> and <strong>Horizon Society<\/strong>. Taking place in a creative, courtroom-style setting, the competition challenges teams to take failed or unsuccessful business concepts, analyze their downfalls, defend their viability, and prove to a strict jury why their case deserves a second chance.<\/p>\n<p>The event is aligned with <strong>SDG 9: Industry, Innovation and Infrastructure<\/strong> and <strong>SDG 11: Sustainable Cities and Communities<\/strong>. Participants are expected to evaluate their business cases through the lens of resilient infrastructure, sustainable innovation, urban development, and community impact.<\/p>\n<p><strong>Motto:<\/strong> <em>Ideas Enter. Verdicts Follow.<\/em><\/p>\n<p><strong>Round Wise Details:<\/strong><\/p>\n<p><strong>Round 0: Online Selection (Unstop Screening)<\/strong><\/p>\n<ul>\n<li>Format: Online preliminary screening on Unstop.<\/li>\n<li>Mechanism: Registered teams submit basic business concept details and problem analysis as per the official Unstop prompt. Shortlisted teams qualify for the live courtroom trials.<\/li>\n<\/ul>\n<p><strong>Round 1: The First Trial (1v1 Knockout)<\/strong><\/p>\n<ul>\n<li>Format: 1v1 courtroom-style debate.<\/li>\n<li>Mechanism: Qualified teams are paired against each other via a spin-wheel system. Each team presents a single-page overview of their business idea, covering the core model and failure points. Teams then cross-examine and defend their cases against their opponent before the judges.<\/li>\n<li>Outcome: Winners advance to Round 2; losing teams are eliminated and assigned the event dare!<\/li>\n<\/ul>\n<p><strong>Round 2: The Case (PPT Battle)<\/strong><\/p>\n<ul>\n<li>Format: Detailed presentation battle.<\/li>\n<li>Mechanism: Advancing teams present an in-depth slide deck analyzing the business model, market failures, unit economics, and growth potential under strict time constraints.<\/li>\n<li>Outcome: Top-scoring teams advance to the Grand Finale; losing teams receive the designated event dare.<\/li>\n<\/ul>\n<p><strong>Round 3: The Final Trial (Pitch Deck &amp; SDG Jury Cross-Examination)<\/strong><\/p>\n<ul>\n<li>Format: Comprehensive pitch deck defense + SDG question sheet.<\/li>\n<li>Mechanism: Finalist teams present their full pitch deck to the jury panel. Following their pitch, the jury hands the team a custom question sheet with 7&ndash;8 high-level questions tied to SDG 9, SDG 11, and their specific business model. Teams receive prep time before stepping back onto the witness stand for live cross-examination by the jury.<\/li>\n<\/ul>\n<p><strong>Rules and Guidelines:<\/strong><\/p>\n<ul>\n<li>Eligibility: Open to students registered via the official Unstop platform.<\/li>\n<li>Team &amp; Idea Policy: Submissions must reflect genuine work. Misrepresentation of data or deliberate plagiarism will result in immediate disqualification.<\/li>\n<li>Courtroom Decorum: While the event follows a heated trial format, all arguments must remain focused purely on the business case. Personal attacks, discriminatory remarks, or abusive language will lead to immediate expulsion.<\/li>\n<li>The Dare Element: Eliminated teams will participate in designated, fun dares designed to maintain event energy within safe, respectful, and institutional guidelines.<\/li>\n<li>Evaluation Criteria:\n<ul>\n<li>Depth of business understanding &amp; failure analysis<\/li>\n<li>Structure and clarity of argument<\/li>\n<li>Resilience under pressure during cross-examination<\/li>\n<li>Alignment with SDG 9 &amp; SDG 11 themes<\/li>\n<\/ul>\n<\/li>\n<li>Final Authority: The decision of the judges, jury, and organizing committee is final and non-contestable.<\/li>\n<\/ul>\n<div id=\"model-response-message-contentr_cae7634d0cb2801e\" class=\"markdown markdown-main-panel md-content enable-luminous-fast-follows enable-updated-hr-color stronger tutor-markdown-rendering\" dir=\"ltr\" aria-busy=\"false\" aria-live=\"polite\">\n<div><strong data-path-to-node=\"0\" data-index-in-node=\"0\">Contact for Queries<\/strong><\/div>\n<br \/>\n<ul>\n<li><strong data-path-to-node=\"1\" data-index-in-node=\"0\">Ahzam Mehdi<\/strong> &mdash; +91 85958 01570<\/li>\n<li><strong data-path-to-node=\"2\" data-index-in-node=\"0\">Nihal<\/strong> &mdash; +91 81782 55161<\/li>\n<\/ul>\n<\/div>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":33478161,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-02T12:28:59+05:30","updated_at":"2026-10-05T09:35:38+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"mfW5Mti","hashtags":null,"participation_certificate":0,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":null,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":0,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-02 12:32:47","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":n