{"data":{"status":true,"competition":{"id":1742226,"visibility":"public","theme_colour":null,"paid":0,"title":"CTF Arena","festival_id":496201,"organization_id":11832,"web_url":"d3fest.techsoc-iiitbbsr.com\/","start_date":"2026-08-20T00:00:00+05:30","end_date":"2027-02-07T23:59:00+05:30","location":null,"type":"hackathons","public_url":"hackathons\/ctf-arena-international-institute-of-information-technology-iiit-bhubaneswar-1742226","region":"offline","details":"<p><strong>About Capture The Flag (CTF):<\/strong><\/p>\n<p>A Capture The Flag (CTF) competition is a cybersecurity-based contest where participants solve a variety of real-world hacking challenges to \ufb01nd hidden clues called \ufb02ags. These \ufb02ags act as proof of solving a challenge and are submitted on a CTF platform to earn points.<\/p>\n<p>Each challenge represents a practical security scenario, encouraging participants to think like ethical hackers while maintaining legal and responsible boundaries. The aim is not just to break systems but to understand, analyze, and defend them that promote both offensive and defensive cybersecurity skills.<\/p>\n<p><strong>About the Event:<\/strong><\/p>\n<ul>\n<li>The Capture the Flag (CTF) competition hosted by Tech Society IIIT Bhubaneswar is a cybersecurity challenge designed to test your hacking, analytical, and problem-solving skills in a real-world simulation environment.<\/li>\n<li>In this event, participants will face a series of challenges related to ethical hacking domains that include web exploitation, cryptography, forensics, reverse engineering, OSINT (Open-Source Intelligence), steganography, and privilege escalation.<\/li>\n<li>Each challenge will test different aspects of cybersecurity knowledge and technical expertise. The event is meant to promote cybersecurity awareness, encourage ethical hacking practices, and create a platform for collaboration among students passionate about security.<\/li>\n<li>This event will be conducted offline at IIIT Bhubaneswar, giving participants a chance to interact with cybersecurity enthusiasts, mentors, and experts from different colleges.<\/li>\n<\/ul>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":null,"registration_clicks":0,"user_id":22795458,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-08-20T22:11:05+05:30","updated_at":"2026-10-02T12:58:21+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"online_coding_challenge","combined_leaderboard":null,"source":null,"short_id":"zUySvXs","hashtags":null,"participation_certificate":1,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":2,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":4,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-08-20 23:10:44","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":false,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/uploadedManual-6a873bb5c1cf1_20260729_010736.png","logoUrl2":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/150x150\/uploadedManual-6a873bb5c1cf1_20260729_010736.png","regnRequirements":{"id":2472790,"opportunity_id":1742226,"festival_id":null,"max_team_size":3,"min_team_size":2,"start_regn_dt":"2026-08-20T00:00:00+05:30","end_regn_dt":"2026-12-20T23:59:00+05:30","show_deadline":1,"open_for":0,"college_type":0,"same_organisation":0,"study_year_filter":0,"deleted_at":null,"eligibility":null,"gender":["A"],"vendor_id":null,"verified_email":1,"verified_mobile":1,"experience":null,"only_official_domains":null,"enable_veri