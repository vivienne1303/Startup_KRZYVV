{"data":{"status":true,"competition":{"id":1764780,"visibility":"public","theme_colour":"blue_un","paid":0,"title":"Query Heist ","festival_id":520881,"organization_id":943045,"web_url":null,"start_date":"2026-10-02T00:00:00+05:30","end_date":"2026-10-19T22:00:00+05:30","location":null,"type":"competitions","public_url":"competitions\/query-heist-bharati-vidyapeeths-college-of-engineering-1764780","region":"offline","details":"<p><strong>About the Event:<\/strong><\/p>\n<p><strong>Query Wars<\/strong> is a high-octane, competitive SQL-based event that merges technical database problem-solving with an interactive physical treasure hunt. The event revolves around a custom, SDG-focused database featuring real-world data points on education, skill development, employment metrics, and workforce opportunities.<\/p>\n<p>Across three dynamic stages, participants will be tested on SQL syntax, relational query logic, speed, analytical reasoning, and team coordination under pressure.<\/p>\n<p><strong>Round Wise Details:<\/strong><\/p>\n<p><strong>Online Qualifier<\/strong><\/p>\n<ul>\n<li>Format: Online SQL Quiz.<\/li>\n<li>Mechanism: All registered teams compete in an online screening round covering conceptual SQL, output prediction, and query syntax challenges.<\/li>\n<li>Selection: The Top 30&ndash;40 teams advance to the offline stage based on score accuracy, with completion speed serving as the tie-breaker.<\/li>\n<\/ul>\n<p><strong>Round 1: SQL Intel<\/strong><\/p>\n<ul>\n<li>Format: Offline Database Sprint.<\/li>\n<li>Mechanism: Qualified teams work on the core SDG database to solve 6&ndash;8 SQL problems. To maintain competitive integrity, teams are assigned one of 5 equivalent question sets. Upon completion, teams receive an <strong>Initial Intel<\/strong> document revealing their starting location for the treasure hunt.<\/li>\n<li>Note: Scores from this round contribute to the final leaderboard.<\/li>\n<\/ul>\n<p><strong>Round 2: SQL Treasure Hunt<\/strong><\/p>\n<ul>\n<li>Format: On-campus QR-based technical hunt.<\/li>\n<li>Mechanism: Teams navigate designated campus routes starting from different checkpoints. At each station, teams scan a unique QR code, solve an SQL query challenge, and unlock the clue to their next checkpoint. All routes lead to a common finish line.<\/li>\n<li>Selection: The Top 10&ndash;12 teams to reach and complete the final station qualify for the Grand Finale.<\/li>\n<\/ul>\n<p><strong>Round 3: SQL Rapid Fire Battle<\/strong><\/p>\n<ul>\n<li>Format: Buzzer-based live SQL showdown.<\/li>\n<li>Mechanism: Finalists battle in a high-stakes buzzer round. Questions are weighted by difficulty and carry <strong>negative marking<\/strong> for wrong answers. The overall winner is declared based on cumulative performance across Round 1 and Round 3.<\/li>\n<\/ul>\n<p><strong>Rules and Guidelines:<\/strong><\/p>\n<ul>\n<li>Eligibility: Open to college students from all academic years.<\/li>\n<li>Team Structure: Teams must consist of <strong>2 to 4 members<\/strong>. Each participant can join only one team.<\/li>\n<li>Prerequisites &amp; ID: Basic knowledge of SQL and relational databases is recommended. All participants must carry a valid college\/student ID card.<\/li>\n<li>Treasure Hunt Rules:\n<ul>\n<li>Teams must follow their strictly assigned route and scan QR codes only at designated checkpoints.<\/li>\n<li>Tampering with, removing, or scanning QR codes assigned to other routes is grounds for immediate disqualification.<\/li>\n<li>Interfereing with another team's route or progress is prohibited.<\/li>\n<\/ul>\n<\/li>\n<li>Fair Play &amp; Integrity:\n<ul>\n<li>The Initial Intel received after Round 1 must not be shared with other teams.<\/li>\n<li>Plagiarism, impersonation, unauthorized external help, or system manipulation will result in instant disqualification.<\/li>\n<\/ul>\n<\/li>\n<li>Authority: The decision of the organizing committee and judges regarding qualifications, rule violations, and tie-breakers is final and binding.<\/li>\n<\/ul>\n<div id=\"model-response-message-contentr_c2661d4006fe8341\" class=\"markdown markdown-main-panel md-content enable-luminous-fast-follows enable-updated-hr-color stronger tutor-markdown-rendering\" dir=\"ltr\" aria-busy=\"false\" aria-live=\"polite\">\n<div><strong data-path-to-node=\"0\" data-index-in-node=\"0\">Contact for Queries<\/strong><\/div>\n<br \/>\n<div><strong data-path-to-node=\"1\" data-index-in-node=\"0\">Md. Kaif<\/strong> &mdash; +91 82879 75163<\/div>\n<br \/>\n<div><strong data-path-to-node=\"2\" data-index-in-node=\"0\">Vikal Sirohi<\/strong> &mdash; +91 86042 21173<\/div>\n<\/div>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":33478161,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-02T14:28:08+05:30","updated_at":"2026-10-05T09:30:27+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"W5oZ40D","hashtags":null,"participation_certificate":0,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":null,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":0,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-02 14:32:17","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/uploadedManual-6abf723108489_bvestlogo_final_1.png","logoUrl2":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/150x150\/uploadedM