ue growth, supported by clear assumptions and relevant fintech-specific metrics.\u00a0\nThe strategy could involve acquiring new customers, increasing engagement or transaction volumes, launching new products or services, entering new markets, changing pricing or monetisation, forming strategic partnerships, leveraging technology, or developing new revenue streams.\nTeams should address:\nOpportunity: What is the opportunity and why is it relevant to the company?\nTarget Audience: Who are the customers the company should","start_date":"2026-11-01T12:20:00+05:30","end_date":"2026-11-01T13:45:00+05:30","who_can_play":1,"round_config":null,"ai_interview_enabled":false,"status":"NOT_STARTED","can_evaluate":true,"seo_data":{"title":"Round 2","keyword":"","description":"Offline Round as part of Conviction: The FinTech Challenge","sharable_image_url":"https:\/\/d8it4huxumps7.cloudfront.net\/lambda-pdfs\/opportunity-bannerImages\/1791282059.png","audience":"","entity_type":"App\\Model\\Opportunity","entity_id":1766433,"public_url":"\/competitions\/conviction-the-fintech-challenge-shatranj-30-the-entrepreneurship-weekender-ashoka-university-1766433\/offline-round\/1390315","keywords":"","seo_url":"https:\/\/unstop.com\/competitions\/conviction-the-fintech-challenge-shatranj-30-the-entrepreneurship-weekender-ashoka-university-1766433\/offline-round\/1390315"},"public_url":"\/competitions\/conviction-the-fintech-challenge-shatranj-30-the-entrepreneurship-weekender-ashoka-university-1766433\/offline-round\/1390315\/details","images":[]}],"status":"NOT_STARTED","display_only":true},{"id":1639646,"opportunity_id":1766433,"entity_id":1390312,"entity_type":"App\\Model\\OfflineRound","is_inactive":1,"is_hidden":0,"evaluation_fields":null,"subtype":null,"round_order":3,"players_count":0,"register_window":1,"eliminator_round":0,"result_flag":0,"to_be_announced":null,"proctoring":null,"grace_period":15,"hide_rounds_data":null,"hosted_on_d2c":1,"parent":null,"pro_only":false,"show_round