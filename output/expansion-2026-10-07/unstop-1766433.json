{"data":{"status":true,"competition":{"id":1766433,"visibility":"public","theme_colour":"blue_un","paid":0,"title":"Conviction: The FinTech Challenge","festival_id":515277,"organization_id":1028215,"web_url":null,"start_date":"2026-10-06T00:00:00+05:30","end_date":"2026-11-01T16:31:00+05:30","location":null,"type":"competitions","public_url":"competitions\/conviction-the-fintech-challenge-shatranj-30-the-entrepreneurship-weekender-ashoka-university-1766433","region":"offline","details":"<p><strong><em>Analyse. Strategise. Adapt.<\/em><\/strong><\/p>\n<p><strong>Think like an investor. Build like an entrepreneur. Defend your conviction.<\/strong><span style=\"font-weight: 400;\"> <\/span><\/p>\n<p><em><span style=\"font-weight: 400;\">Conviction: The Fintech Challenge<\/span><\/em><span style=\"font-weight: 400;\"> puts you at the intersection of fintech, investing, and strategy, challenging teams to analyse real businesses, build bold growth strategies, and adapt when the market turns against them. From your first investment thesis to a live market shock, every decision will test your financial reasoning, strategic thinking, and ability to make the right call under pressure. <\/span><strong>The market won&rsquo;t wait. Neither should you.<\/strong><\/p>\n<p><strong>Rules<\/strong><\/p>\n<ul>\n<li><span style=\"font-weight: 400;\"> Teams must consist of <\/span><strong>3&ndash;4 members<\/strong><span style=\"font-weight: 400;\">. Each participant may be part of only one team.<\/span><span style=\"font-weight: 400;\"><br \/><\/span><\/li>\n<li><strong>Round 1:<\/strong><span style=\"font-weight: 400;\"> Analyse an assigned fintech and present an investment thesis.<\/span><span style=\"font-weight: 400;\"><br \/><\/span><\/li>\n<li><strong>Round 2:<\/strong><span style=\"font-weight: 400;\"> Develop a <\/span><strong>3-year growth strategy to scale the business and strengthen its market position.<\/strong><span style=\"font-weight: 400;\"><br \/><\/span><\/li>\n<li><strong>Round 3:<\/strong><span style=\"font-weight: 400;\"> Receive a market shock, adapt the strategy within <\/span><strong>30&ndash;45 minutes<\/strong><span style=\"font-weight: 400;\">, and defend the revised approach.<\/span><span style=\"font-weight: 400;\"><br \/><\/span><\/li>\n<li><span style=\"font-weight: 400;\">All recommendations must be supported by <\/span><strong>credible assumptions, financial reasoning, and relevant metrics<\/strong><span style=\"font-weight: 400;\">.<\/span><span style=\"font-weight: 400;\"><br \/><\/span><\/li>\n<li><span style=\"font-weight: 400;\">External assistance is not permitted during live rounds.<\/span><span style=\"font-weight: 400;\"><br \/><\/span><\/li>\n<li><span style=\"font-weight: 400;\">Plagiarism, fabricated data, or misrepresentation of information may result in disqualification.<\/span><span style=\"font-weight: 400;\"><br \/><\/span><\/li>\n<li><span style=\"font-weight: 400;\">Decisions of the judges and Organising Committee will be final.<\/span><\/li>\n<\/ul>\n<p><strong>Judgement Criteria<\/strong><\/p>\n<ul>\n<li><span style=\"font-weight: 400;\"> <\/span><strong>Fintech &amp; Business Acumen:<\/strong><span style=\"font-weight: 400;\"> Understanding of the company, market, product, and business model.<\/span><span style=\"font-weight: 400;\"><br \/><\/span><\/li>\n<li><strong>Financial Acumen:<\/strong><span style=\"font-weight: 400;\"> Quality of financial analysis, assumptions, and viability of the strategy.<\/span><span style=\"font-weight: 400;\"><br \/><\/span><\/li>\n<li><strong>Strategic Thinking:<\/strong><span style=\"font-weight: 400;\"> Strength of the investment thesis and growth strategy.<\/span><span style=\"font-weight: 400;\"><br \/><\/span><\/li>\n<li><strong>Innovation &amp; Entrepreneurship:<\/strong><span style=\"font-weight: 400;\"> Originality, product thinking, and commercial potential.<\/span><span style=\"font-weight: 400;\"><br \/><\/span><\/li>\n<li><strong>Adaptability:<\/strong><span style=\"font-weight: 400;\"> Ability to respond effectively to the market shock.<\/span><span style=\"font-weight: 400;\"><br \/><\/span><\/li>\n<li><strong>Presentation &amp; Teamwork:<\/strong><span style=\"font-weight: 400;\"> Clarity, persuasion, defence of ideas, and team coordination.<\/span><\/li>\n<\/ul>","overall_prizes":"Prizepool ","regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":19096997,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-06T07:49:42+05:30","updated_at":"2026-10-06T15:51:01+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"hIALveJ","hashtags":null,"participation_certificate":1,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":null,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":0,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-06 12:55:19","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/uploadedManual-6ac4a250e716e_uploadedmanual-6aaaea16dc3d6_final_logo_shatranj_png.webp","logoUrl2":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/150x150\/uploadedManual-6ac4a250e716e_uploadedmanual-6aaaea16dc3d6_final_logo_shatranj_png.webp","regnRequirements":{"id":2498102,"opportunity_id":1766433,"festival_id":null,"max_team_size":4,"min_team_size":3,"start_regn_dt":"2026-10-06T00:00:00+05:30","end_regn_dt":"2026-10-30T00:00:00+05:30","s