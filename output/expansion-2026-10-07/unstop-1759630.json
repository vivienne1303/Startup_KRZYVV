{"data":{"status":true,"competition":{"id":1759630,"visibility":"public","theme_colour":null,"paid":0,"title":"Pitch At Match","festival_id":516508,"organization_id":1034442,"web_url":null,"start_date":"2026-09-21T00:00:00+05:30","end_date":"2026-10-13T15:49:39+05:30","location":null,"type":"competitions","public_url":"competitions\/pitch-at-match-pravrutti-20-m-s-ramaiah-university-of-applied-sciences-1759630","region":"online","details":"<p><strong data-path-to-node=\"5\" data-index-in-node=\"0\">About the Event<br \/><\/strong> Welcome to <strong data-path-to-node=\"5\" data-index-in-node=\"27\">PITCH AT MACH<\/strong>, a premier aerospace pitch competition! This event challenges participants to dive deep into real-world aerospace issues, formulate innovative solutions, and present them to a panel of experts. Whether your passion lies in Aeronautics, Astronautics, or UAVs, this is your chance to showcase your technical understanding and problem-solving skills on a grand stage.<\/p>\n<p><strong data-path-to-node=\"6\" data-index-in-node=\"0\">Themes &amp; Problem Statements<\/strong><\/p>\n<p>Problem statements will be released a week before the event and will span the following domains:<\/p>\n<ul data-path-to-node=\"7\">\n<li>Aeronautics<\/li>\n<li>Astronautics<\/li>\n<li>UAVs (Unmanned Aerial Vehicles)<\/li>\n<\/ul>\n<p><strong data-path-to-node=\"8\" data-index-in-node=\"0\">Event Format &amp; Process<\/strong><\/p>\n<ul data-path-to-node=\"9\">\n<li><strong data-path-to-node=\"9,0,0\" data-index-in-node=\"0\">Preparation Phase:<\/strong> Teams will receive the problem statements one week prior to the event. Each team must select one problem of their choice, thoroughly understand it, and develop a feasible, innovative solution.<\/li>\n<li><strong data-path-to-node=\"9,1,0\" data-index-in-node=\"0\">Pitching Round (Event Day):<\/strong> Teams will pitch their proposed solutions live in front of a jury.<\/li>\n<li><strong data-path-to-node=\"9,2,0\" data-index-in-node=\"0\">Q&amp;A Defense:<\/strong> Following the pitch, teams will face a rigorous Q&amp;A session where the jury will assess their technical grasp of both the problem statement and the proposed solution.<\/li>\n<\/ul>\n<p><strong data-path-to-node=\"12\" data-index-in-node=\"0\">Rules<\/strong><\/p>\n<ul data-path-to-node=\"13\">\n<li>Teams must strictly choose from the problem statements provided by the organizers.<\/li>\n<li>Presentations must be completed within the allotted time limit<\/li>\n<li>Teams will be evaluated heavily on technical accuracy, feasibility of the solution, innovation, and how well they defend their ideas during the Q&amp;A.<\/li>\n<\/ul>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":27034930,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-09-21T21:29:50+05:30","updated_at":"2026-10-06T15:49:41+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"innovation_challenge","combined_leaderboard":null,"source":null,"short_id":"GQpn4bi","hashtags":null,"participation_certificate":1,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":2,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":0,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-09-21 21:50:41","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/uploadedManual-6ab154a3348ab_pitch-at-mach.webp","logoUrl2":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/imag