{"data":{"status":true,"competition":{"id":1764569,"visibility":"public","theme_colour":"light-blue-dark_un","paid":0,"title":"Pitch-Verse 2.0 ","festival_id":520757,"organization_id":821,"web_url":null,"start_date":"2026-10-02T18:00:00+05:30","end_date":"2026-10-15T15:00:00+05:30","location":null,"type":"competitions","public_url":"competitions\/pitch-verse-20-ieee-day26-ieee-mait-maharaja-agrasen-institute-of-technology-mait-new-delhi-1764569","region":"offline","details":"<p><strong>Pitch-Verse 2.0 | Startup Pitch Competition:<\/strong><\/p>\n<p>Pitch-Verse 2.0 is a student startup pitch competition designed to provide aspiring entrepreneurs with a platform to present innovative business ideas, demonstrate problem-solving ability, and showcase the potential to build scalable ventures.<\/p>\n<p>Participants will pitch their startup ideas before a judging panel using a PowerPoint presentation.<\/p>\n<p><strong>Official Participant Communication<\/strong><\/p>\n<p>All registered team members must join the official Pitch-Verse 2.0 WhatsApp group after completing their registration.<\/p>\n<p>Important updates regarding reporting time, venue, pitch deck submission, schedules and event announcements will be shared through the group.<\/p>\n<p><strong><a href=\"https:\/\/chat.whatsapp.com\/KHYAN1rHmjC3VnNFmCw54a?mode=gi_t\" target=\"_blank\" rel=\"noopener\">Join the Official Pitch-Verse 2.0 WhatsApp Group<\/a><\/strong><\/p>\n<p><strong>Event Details:<\/strong><\/p>\n<ul>\n<li>Date: 15th October 2026<\/li>\n<li>Venue: Maharaja Agrasen Institute of Technology, New Delhi<\/li>\n<li>Time: 9 am to 3 pm<\/li>\n<li>Format: Single Round<\/li>\n<li>Team Size: 2&ndash;3 Members<\/li>\n<li>Pitch Duration: 5&ndash;7 Minutes per Team<\/li>\n<li>Prize Pool: \u20b95,000<\/li>\n<\/ul>\n<p>The competition will be conducted in a single round, with teams evaluated on their idea, presentation, business potential, feasibility, scalability and overall pitch.<\/p>\n<p><strong>Themes:<\/strong><\/p>\n<p>Participants may develop their startup idea around any of the following categories:<\/p>\n<ul>\n<li>Beverages<\/li>\n<li>Fashion &amp; Apparel<\/li>\n<li>Entertainment<\/li>\n<li>Sustainability &amp; Science<\/li>\n<li>E-Commerce<\/li>\n<\/ul>\n<p><strong>Suggested Pitch Deck Structure:<\/strong><\/p>\n<ul>\n<li>Problem Statement<\/li>\n<li>Solution<\/li>\n<li>Target Audience<\/li>\n<li>Product or Service<\/li>\n<li>Unique Value Proposition<\/li>\n<li>Business Model<\/li>\n<li>Market Opportunity<\/li>\n<li>Competition<\/li>\n<li>Go-to-Market Strategy<\/li>\n<li>Future Vision<\/li>\n<\/ul>\n<p><strong>Evaluation Criteria:<\/strong><\/p>\n<p>Teams will be evaluated on:<\/p>\n<ul>\n<li>Innovation and originality<\/li>\n<li>Relevance and clarity of the problem<\/li>\n<li>Strength and practicality of the proposed solution<\/li>\n<li>Market potential and target audience<\/li>\n<li>Business and revenue model<\/li>\n<li>Competitive differentiation<\/li>\n<li>Feasibility and scalability<\/li>\n<li>Quality and clarity of presentation<\/li>\n<li>Team understanding and ability to answer questions<\/li>\n<\/ul>\n<p><strong>Competition Flow:<\/strong><\/p>\n<ul>\n<li>Team registration and verification<\/li>\n<li>Pitch deck setup<\/li>\n<li>Opening of the competition<\/li>\n<li>Team-wise startup pitches<\/li>\n<li>Questions and answers with the judging panel<\/li>\n<li>Evaluation and consolidation of scores<\/li>\n<li>Final result declaration<\/li>\n<\/ul>\n<p><strong>Participant Guidelines:<\/strong><\/p>\n<ul>\n<li>Each team must consist of 2&ndash;3 students.<\/li>\n<li>Each team will receive approximately 5&ndash;7 minutes to present.<\/li>\n<li>The pitch must be presented using a PowerPoint presentation.<\/li>\n<li>Teams should keep the pitch clear, structured and focused on the startup idea.<\/li>\n<li>Participants should be prepared to answer questions from the judging panel.<\/li>\n<li>The idea presented should belong to the participating team and comply with the competition guidelines.<\/li>\n<\/ul>\n<p><strong>Prize Distribution:<\/strong><\/p>\n<ul>\n<li>1st Prize: \u20b92,500<\/li>\n<li>2nd Prize: \u20b91,500<\/li>\n<li>3rd Prize: \u20b91,000<\/li>\n<\/ul>\n<p><strong>Total Prize Pool: \u20b95,000<\/strong><\/p>\n<p><strong>Registration Deadline:<\/strong><\/p>\n<p>15th October 2026<br \/><br \/><\/p>\n<p><strong>Important Note: Accommodation will not be provided by the organizers. Participants are required to make their own stay arrangements, if needed.<\/strong><\/p>\n<p style=\"text-align: justify;\">&nbsp;<\/p>","overall_prizes":"Cash prizes worth \u20b95,000 for the top 3 teams.","regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":9094295,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-01T22:33:03+05:30","updated_at":"2026-10-05T23:27:37+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"QFtJ5x4","hashtags":null,"participation_certificate":1,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":7,"checked":null,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":8,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-02 16:34:35","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/uploadedManual-6abe9267e66ce_ieee-day-logo-color-rgb.jpg","logoUrl2":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/150x150\/uploadedManual-6abe9267e66ce_ieee-day-lo