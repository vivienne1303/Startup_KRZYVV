{"data":{"status":true,"competition":{"id":1755508,"visibility":"public","theme_colour":null,"paid":0,"title":"Annual International Mathematics Olympiad (AIMO) 2026","festival_id":null,"organization_id":183,"web_url":null,"start_date":"2026-09-14T00:00:00+05:30","end_date":"2026-10-20T00:00:00+05:30","location":null,"type":"competitions","public_url":"competitions\/annual-international-mathematics-olympiad-aimo-2026-bits-1755508","region":"online","details":"<p><strong>Overview<\/strong><\/p>\n<p dir=\"ltr\">The Annual International Mathematics Olympiad (AIMO) 2026 is a worldwide mathematics olympiad conducted by the Mathematics Association, BITS Pilani. It gives students the chance to challenge themselves, test their problem-solving skills against peers from across the world, and gain hands-on practice for school board examinations and competitive exams such as JEE and BITSAT.<\/p>\n<p dir=\"ltr\"><strong>Why Participate<\/strong><\/p>\n<ul dir=\"ltr\">\n<li>Certificate from the Mathematics Association, BITS Pilani for every participant<\/li>\n<li>Total prize pool of \u20b930,000 for top performers<\/li>\n<li>International exposure and a benchmark of your standing at a global level<\/li>\n<li>Practice with NCERT, MAT and Olympiad-level problems<\/li>\n<\/ul>\n<p dir=\"ltr\"><strong>Important Dates<\/strong><\/p>\n<ul dir=\"ltr\">\n<li>Last date for registration: 20 October 2026<\/li>\n<li>Grades 9 to 12: 24 October 2026, 2:00 PM to 3:00 PM IST<\/li>\n<li>Grades 6 to 8: 25 October 2026, 2:00 PM to 3:00 PM IST<\/li>\n<\/ul>\n<p dir=\"ltr\">International participants should note that all timings are in Indian Standard Time (IST). For example, the exam runs from 12:30 PM to 1:30 PM in the UAE and Oman, 11:30 AM to 12:30 PM in Qatar, Saudi Arabia, Kuwait and Bahrain, and 4:30 PM to 5:30 PM in Singapore.<\/p>\n<p dir=\"ltr\"><strong>Registration Fee<\/strong><br \/>\u20b9200 per student. International cards are accepted.<\/p>\n<p dir=\"ltr\"><strong>Guidelines<\/strong><\/p>\n<ul dir=\"ltr\">\n<li>Students of Classes 6 to 12 are eligible.<\/li>\n<li>The examination will be conducted entirely online on an external platform.<\/li>\n<li>Login credentials for the exam portal will be sent to registered students by email before the exam.<\/li>\n<li>The examination will be 1 hour long.<\/li>\n<li>Questions will be based on NCERT, MAT and Olympiad-level problems, covering topics up to the student's current class.<\/li>\n<\/ul>\n<p dir=\"ltr\"><strong>Rules<\/strong><\/p>\n<ul dir=\"ltr\">\n<li>Students must register in their current class as per the 2026-27 academic year.<\/li>\n<li>Calculators and all other electronic devices are strictly prohibited.<\/li>\n<li>Students must not exit the exam window or switch tabs once the exam has begun.<\/li>\n<li>The exam portal is equipped to detect malpractice, and any violation may lead to disqualification.<\/li>\n<\/ul>\n<p dir=\"ltr\"><strong>Contact<\/strong><\/p>\n<ul>\n<li style=\"list-style-type: none;\">\n<ul dir=\"ltr\">\n<li>Arnav Garg, Team Lead: +91 8595646143<\/li>\n<li>Parth Mehta, Events Lead: +91 8080378784<\/li>\n<li>Email: <a href=\"mailto:maths.assoc@pilani.bits-pilani.ac.in\">maths.assoc@pilani.bits-pilani.ac.in<\/a><\/li>\n<li>Website: <a href=\"https:\/\/aimo.mathbitsp.com\/\">https:\/\/aimo.mathbitsp.com\/<\/a><\/li>\n<\/ul>\n<\/li>\n<\/ul>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":10190376,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-09-14T13:21:25+05:30","updated_at":"2026-10-02T19:05:00+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"Xs8lM2k","hashtags":null,"participation_certificate":0,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":nul