{"data":{"status":true,"competition":{"id":1765469,"visibility":"public","theme_colour":"blue_un","paid":0,"title":"Robo Soccer","festival_id":520986,"organization_id":825345,"web_url":null,"start_date":"2026-10-03T00:00:00+05:30","end_date":"2026-11-27T14:00:00+05:30","location":null,"type":"competitions","public_url":"competitions\/robo-soccer-scaler-school-of-technology-bengaluru-karnataka-1765469","region":"hybrid","details":"<p><strong>Objective:<\/strong><\/p>\n<p>Teams design, build, and operate robots to compete in 1v1 soccer matches. Robots must manoeuvre and control the ball to score goals while defending against the opposing robot.<\/p>\n<p><strong>Team Composition:<\/strong><\/p>\n<ul>\n<li>2&ndash;4 participants per team<\/li>\n<li>Cross-college teams allowed<\/li>\n<li>Multiple teams from the same college permitted<\/li>\n<li>Each participant may be part of only one team<\/li>\n<\/ul>\n<p><strong>Arena:<\/strong><\/p>\n<ul>\n<li>Artificial\/false grass turf<\/li>\n<li>Tentative dimensions: ~10 m &times; 5 m<\/li>\n<li>Goals: ~1 m wide<\/li>\n<li>Ball: Foam Ball<\/li>\n<li>Designated boundaries and starting positions<\/li>\n<\/ul>\n<p><strong>Match Format:<\/strong><\/p>\n<ul>\n<li>1v1 (one robot per team on the field)<\/li>\n<li>Duration: 5 minutes<\/li>\n<li>Two halves of approximately 2 minutes each<\/li>\n<li>1 minute halftime<\/li>\n<li>Up to 30 seconds for maintenance\/tuning between matches<\/li>\n<li>Tie-breakers:<\/li>\n<li style=\"list-style-type: none;\">\n<ul>\n<li>\n<p>Extra time: 2 minutes<\/p>\n<\/li>\n<li>\n<p>Golden Goal if still tied<\/p>\n<\/li>\n<\/ul>\n<\/li>\n<\/ul>\n<p><strong>Robot Specifications:<\/strong><\/p>\n<ul>\n<li>Size: &le; 30 cm &times; 30 cm &times; 20 cm (L&times;B&times;H)<\/li>\n<li>Weight: &le; 3 kg (5% tolerance)<\/li>\n<li>Power: Onboard battery<\/li>\n<li>Connectivity: Wireless only<\/li>\n<li>Prebuilt\/commercial competition kits: Not allowed<\/li>\n<li>External structures such as pushers\/kickers permitted<\/li>\n<li>Ball trapping or permanent ball retention mechanisms not allowed<\/li>\n<li>No sharp or hazardous components<\/li>\n<\/ul>\n<p><strong>Participant Requirements:<\/strong><\/p>\n<ul>\n<li>Bring fully assembled and functional robots<\/li>\n<li>Carry controllers, batteries, spares and repair equipment<\/li>\n<li>Complete technical inspection before matches<\/li>\n<li>Report to the venue before the scheduled match<\/li>\n<li>Only designated team members may operate or handle the robot during matches<\/li>\n<\/ul>\n<p><strong>Safety &amp; Compliance:<\/strong><\/p>\n<ul>\n<li>No sharp edges or hazardous components<\/li>\n<li>No external power sources during gameplay<\/li>\n<li>No deliberate damage to robots or the ball<\/li>\n<li>Battery and safety checks mandatory<\/li>\n<li>Judges\/referees can disqualify unsafe or non-compliant robots<\/li>\n<\/ul>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":28043294,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-03T23:15:18+05:30","updated_at":"2026-10-04T21:43:38+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"DzNvEf6","hashtags":null,"participation_certificate":1,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":null,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":0,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-03 23:33:26","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players"