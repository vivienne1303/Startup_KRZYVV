{"data":{"status":true,"competition":{"id":1765419,"visibility":"public","theme_colour":null,"paid":0,"title":"Speak Your Mind","festival_id":521073,"organization_id":2084904,"web_url":null,"start_date":"2026-10-05T00:00:00+05:30","end_date":"2026-10-18T12:00:00+05:30","location":null,"type":"competitions","public_url":"competitions\/speak-your-mind-commquest26-commercium-the-commerce-society-pgdav-college-m-university-of-delhi-1765419","region":"offline","details":"<p>Put your confidence, knowledge, and presence of mind to the test. From presenting your perspective on an assigned topic to defending your arguments in a final face-off, Speak Your Mind challenges you to think quickly, speak clearly, and respond effectively.<\/p>\n<p><strong>Round 1 &ndash; Online Quiz<\/strong><\/p>\n<ul>\n<li>15-question quiz conducted on Unstop. The top 12 teams advance to the D-Day rounds.<\/li>\n<\/ul>\n<p><strong>Round 2 &ndash; Topic Presentation<\/strong><\/p>\n<ul>\n<li>The 12 shortlisted teams will receive their topics 2&ndash;4 days before the event and get 5 minutes to present their ideas, followed by cross-questioning by the judges. Top 6 teams advance to the final round.<\/li>\n<\/ul>\n<p><strong>Final Round &ndash; Debate Face-Off<\/strong><\/p>\n<ul>\n<li>The 6 finalists will be paired through a chit-draw. Each pair will argue opposing sides of the same topic, with 2 minutes for an opening statement followed by 3 minutes of cross-questioning and debate.<\/li>\n<\/ul>\n<p><strong>Guidelines:<\/strong><\/p>\n<ul>\n<li>Language: English.<\/li>\n<li>Participants must adhere to the time limits specified for each round.<\/li>\n<li>Participants must present their arguments respectfully and maintain professional conduct throughout the event.<\/li>\n<li>Use of mobile phones or external resources is not permitted during the presentation and debate rounds, except during the designated 15-minute research break.<\/li>\n<li>Any misconduct may lead to disqualification.<\/li>\n<li>The decision of the judges will be final.<\/li>\n<\/ul>\n<p><strong>Eligibility Criteria:<\/strong><\/p>\n<ul>\n<li>Teams of 2&ndash;4 members.<\/li>\n<li>Open to undergraduate students.<\/li>\n<\/ul>\n<p><strong>In case of any doubt, kindly contact below<\/strong><\/p>\n<p><strong>Anuj Sharma - 7404171165<\/strong><\/p>\n<p><strong>Noor Arora - 9650638001<\/strong><\/p>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":33504104,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-03T20:55:35+05:30","updated_at":"2026-10-04T14:49:50+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"ynD5mc6","hashtags":null,"participation_certificate":1,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":2,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":0,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-03 22:06:08","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/uploadedManual-6ac12f88858c7_copy_of_commercium_the_commerce_society_4_1.png","logoUrl2":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/150x150\/uploadedManual-6ac12f88858c7_copy_of_commercium_the_commerce_society_4_1.png","regnRequirements":{"id":2497063,"opportunity_id":1765419,"festival_id":null,"max_team_size":4,"min_team_size":2,"start_regn_dt":"2026-10-05T00:00:00+05:30","end_regn_dt":"2026-10-10T23:59