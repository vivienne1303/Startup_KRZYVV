{"data":{"status":true,"competition":{"id":1765990,"visibility":"public","theme_colour":null,"paid":0,"title":"E-Impetus: A National Social Impact Case Competition","festival_id":null,"organization_id":587,"web_url":null,"start_date":"2026-10-05T00:00:00+05:30","end_date":"2026-10-09T23:59:00+05:30","location":null,"type":"competitions","public_url":"competitions\/e-impetus-a-national-social-impact-case-competition-iim-indore-1765990","region":"online","details":"<p><strong>About E-Impetus<\/strong><\/p>\n<p data-pm-slice=\"1 1 []\">E-Impetus: Social Case Competition at IIM Indore invites participants to engage with pressing societal challenges through structured analysis and innovative problem-solving. The competition encourages teams to understand stakeholder perspectives and develop solutions that are impactful, feasible, scalable, and sustainable.<\/p>\n<p data-pm-slice=\"1 1 []\"><strong>Timeline:<\/strong><\/p>\n<ul>\n<li><strong>Round 1 &ndash; Online Quiz (10 October):<\/strong>\n<ul>\n<li>Participants will be assessed on social issues, public policy awareness, sustainability, ethical decision-making, and social-impact frameworks. Teams will be shortlisted based on their quiz performance.<\/li>\n<\/ul>\n<\/li>\n<li data-pm-slice=\"1 1 []\"><strong>Round 2 &ndash; Case Submission (15 October):<\/strong>\n<ul>\n<li data-pm-slice=\"1 1 []\">Shortlisted teams will analyse a social case and submit a case deck covering problem identification, stakeholder mapping, root-cause analysis, proposed solution and theory of change, feasibility and scalability, impact assessment, implementation roadmap, and success metrics. Participants are required to submit a 3-slide deck (excluding the appendix and cover pages)<\/li>\n<\/ul>\n<\/li>\n<li><strong style=\"color: #000000;\">Round 3 &ndash; Online Presentation (19 October):<\/strong>\n<ul>\n<li>Selected teams will present their solutions on campus at IIM Indore before an esteemed panel of judges. Each presentation will be followed by a Q&amp;A session. Participants are required to submit a 7-slide expanded deck (excluding the appendix and cover pages). Further details regarding the format and duration will be communicated to the finalists.<\/li>\n<\/ul>\n<\/li>\n<\/ul>\n<p><strong>Guidelines:<\/strong><\/p>\n<ul>\n<li>Participants must adhere to all rules and guidelines shared by the organising committee.<\/li>\n<li>Further details and guidelines will be communicated after registration.<\/li>\n<li>The judges&rsquo; decision will be final and binding.<\/li>\n<li>Any misconduct, plagiarism, or rule violation may lead to disqualification.<\/li>\n<li>The organising committee reserves the right to modify the event or its rules, if required.<\/li>\n<\/ul>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":287575,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-05T13:24:45+05:30","updated_at":"2026-10-05T18:32:10+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"case_competition","combined_leaderboard":null,"source":null,"short_id":"fc2kC57","hashtags":null,"participation_certificate":0,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":null,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":43,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-05 18:04:49","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/6ac39fb5e3555_1200px-IIM_Indore_Logo.svg.png","logoUr