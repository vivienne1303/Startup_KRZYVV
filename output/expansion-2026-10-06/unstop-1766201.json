{"data":{"status":true,"competition":{"id":1766201,"visibility":"public","theme_colour":"blue_un","paid":0,"title":"Technical Research and Innovation Challenge","festival_id":null,"organization_id":106646,"web_url":null,"start_date":"2026-10-05T00:00:00+05:30","end_date":"2026-10-31T16:30:00+05:30","location":null,"type":"competitions","public_url":"competitions\/technical-research-and-innovation-challenge-guru-tegh-bahadur-institute-of-technology-gtbit-new-delhi-1766201","region":"offline","details":"<p><strong>Q-VERSE '26<\/strong> is an <strong>inter-college Technical Research &amp; Innovation Challenge<\/strong> organized by <strong>Quantum Quorum, Physics Society, GTBIT<\/strong>.<\/p>\n<p>The event provides students with a structured platform to take an <strong>original research idea<\/strong>, develop it into a research paper through a mentorship phase, and present the final work before a judging panel. The challenge is open to <strong>students of all years and all colleges\/universities<\/strong>.<\/p>\n<p><strong>Participation<\/strong><\/p>\n<ul>\n<li>Individual participation and <strong>teams of up to 5 members<\/strong> are allowed.<\/li>\n<li><strong>Inter-college teams are permitted<\/strong>; team members may belong to different institutions.<\/li>\n<li>Only currently enrolled students can be listed as authors\/co-authors.<\/li>\n<li>Faculty members and mentors may be acknowledged but <strong>cannot be listed as co-authors<\/strong>.<\/li>\n<\/ul>\n<p><strong>Research Themes<\/strong><\/p>\n<p>Participants can submit their work under one of the following themes:<\/p>\n<ul>\n<li>Science, Technology &amp; Innovation<\/li>\n<li>AI, Data Science &amp; Automation<\/li>\n<li>Energy, Environment &amp; Sustainability<\/li>\n<li>Engineering, Materials &amp; Emerging Technologies<\/li>\n<li>Interdisciplinary Research<\/li>\n<\/ul>\n<p><strong>Event Format<\/strong><\/p>\n<p><strong>Idea &rarr; Shortlisting &rarr; Mentorship &rarr; Research Development &rarr; Final Submission &rarr; Presentation &amp; Q&amp;A &rarr; Recognition<\/strong><\/p>\n<p><strong>Final Submission<\/strong><\/p>\n<p>Shortlisted teams are required to submit:<\/p>\n<ul>\n<li>Final Research Paper<\/li>\n<li>Software-generated Similarity\/Plagiarism Report<\/li>\n<li>Software-generated AI Detection Report<\/li>\n<li>Final Presentation (maximum 12 slides)<\/li>\n<\/ul>\n<p>Important<\/p>\n<p><strong>Click <a href=\"https:\/\/chat.whatsapp.com\/KQ8ggugP8fi2ATGsyUsM3c\">here<\/a> to join our WhatsApp community for updates, announcements, and important event information.<\/strong><\/p>\n<p><strong>For complete eligibility requirements, research-paper format, abstract guidelines, submission requirements, presentation rules, plagiarism &amp; AI policy, evaluation criteria, and disqualification rules, participants are requested to read the official <em>Q-VERSE '26 Participant Guidelines &amp; SOP<\/em> carefully before submitting.<\/strong><\/p>\n<h3>Complete Rulebook<\/h3>\n<p><em>Click <a href=\"https:\/\/drive.google.com\/file\/d\/1AQ5HuF5_WlM23nFi5odWGOX39b0r1xb5\/view?usp=sharing\">here<\/a> to download the complete <\/em><strong><em>Q-VERSE '26 Participant Guidelines &amp; SOP.<\/em><\/strong><\/p>","overall_prizes":"Prizes for Top 3 teams, plus Certificates of Appreciation and Participation.","regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":33523721,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-05T19:20:08+05:30","updated_at":"2026-10-05T20:11:04+05:30","communication_sent":1,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"w6qhJgG","hashtags":null,"participation_certificate":1,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":null,"display_title":null,"show_discus