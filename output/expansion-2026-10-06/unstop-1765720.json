{"data":{"status":true,"competition":{"id":1765720,"visibility":"public","theme_colour":null,"paid":0,"title":"Treasure Hunt","festival_id":504454,"organization_id":675999,"web_url":null,"start_date":"2026-10-04T00:00:00+05:30","end_date":"2026-10-18T00:00:00+05:30","location":null,"type":"competitions","public_url":"competitions\/treasure-hunt-sant-longowal-institute-of-engineering-and-technology-longowal-punjab-1765720","region":"online","details":"<p><strong>Register \/ Event Link: www.techfest26.com<br \/><\/strong><\/p>\n<p><strong>Overview:<\/strong><\/p>\n<p>Treasure Hunt is a two-round competition under Aarambh&rsquo;26 at SLIET, designed to test teamwork, mental agility, problem-solving, quick thinking, and strategy. Teams compete through a structured elimination format to solve clues and discover the final object.<\/p>\n<p><strong>Event Details:<\/strong><\/p>\n<ul>\n<li>Date: 30\/09\/2026<\/li>\n<li>Venue: FATE Area<\/li>\n<li>Time: 4:00 P.M.<\/li>\n<li>Format: 2 rounds | Elimination + Treasure Hunt<\/li>\n<li>Team Size: 2&ndash;4 registered members<\/li>\n<li>Round 1 Duration: 15 minutes<\/li>\n<\/ul>\n<p><strong>Round 1 &ndash; Paper Scramble:<\/strong><\/p>\n<ul>\n<li>Each team receives a sealed envelope containing a physical puzzle<\/li>\n<li>Campus anagrams such as RILABRY &rarr; Library, NENETCA &rarr; Canteen, KOWRSHPO &rarr; Workshop<\/li>\n<li>First 10&ndash;15 teams to return with correct answers qualify for Round 2<\/li>\n<\/ul>\n<p><strong>Round 2 &ndash; Decoy Hunt:<\/strong><\/p>\n<ul>\n<li>Hunt restricted to one lawn or one specific floor<\/li>\n<li>50&ndash;60 envelopes hidden in the designated area<\/li>\n<li>45 envelopes contain funny decoy messages<\/li>\n<li>Only 5 envelopes contain pieces of the final riddle<\/li>\n<li>Teams must collect the actual clues, solve the final riddle, and find the physical object related to it<\/li>\n<\/ul>\n<p><strong>Judgement Criteria:<\/strong><\/p>\n<ul>\n<li>Speed &amp; Efficiency: Quickness in solving puzzles and finding clues<\/li>\n<li>Problem-Solving: Accuracy and mental agility in decoding puzzles and the final riddle<\/li>\n<li>Teamwork &amp; Coordination: Communication, task division, and overall team effort<\/li>\n<li>Strategy &amp; Fair Play: Decision-making, discipline, and respect for opponents and officials<\/li>\n<\/ul>\n<p><strong>Rules &amp; Regulations:<\/strong><\/p>\n<ul>\n<li>All team members must be registered before the event<\/li>\n<li>Valid college identification is mandatory<\/li>\n<li>Round 1 has a strict 15-minute time limit<\/li>\n<li>Only registered team members may participate<\/li>\n<li>No external help or phone usage is allowed unless permitted by organizers<\/li>\n<li>Teams must not hide or destroy decoy envelopes<\/li>\n<li>Participants must report at least 15 minutes before their scheduled start time<\/li>\n<li>Abusive behaviour, physical altercations, property damage, or disrespect toward officials may lead to disqualification<\/li>\n<li>Teams must maintain discipline and cleanliness at the venue<\/li>\n<li>Organizers may reschedule, shorten, or modify the event if necessary<\/li>\n<\/ul>\n<p><strong>Certification:<\/strong><\/p>\n<ul>\n<li>Participation certificates will be provided to registered participants, subject to event policy<\/li>\n<li>Certificates of excellence\/prizes will be provided to the winning team and other announced award categories<\/li>\n<\/ul>\n<p><strong>Eligibility:<\/strong><\/p>\n<ul>\n<li>Open to students of all eligible branches\/departments of the college<\/li>\n<li>All players must be registered college students<\/li>\n<li>Valid college identification is required<\/li>\n<\/ul>\n<p><strong>Discipline:<\/strong><\/p>\n<ul>\n<li>Event coordinators' decisions regarding clues, timing, and qualifications are final<\/li>\n<li>No abusive language, misconduct, or disrespect toward officials<\/li>\n<li>Violation of rules may lead to immediate disqualification<\/li>\n<li>Participants must follow all instructions issued by the organizing committee<\/li>\n<\/ul>\n<p><strong>Contact:<\/strong><\/p>\n<ul>\n<li>Gaurav Kumar (Core Rep): 7991107815<\/li>\n<li>Anurag Kumar (Domain Coordinator): 8084674742<\/li>\n<li>Yash (Domain Co-Coordinator): 7742875275<\/li>\n<li>Ritaj Shukla (Event Coordinator): 8840770265<\/li>\n<li>Faculty Advisor: Mr. Kanika Aggarwal, PHY<\/li>\n<li>Faculty Convener: Dr. Sumit Kumar, ME<\/li>\n<li>Email: <a href=\"mailto:techfest@sliet.ac.in\" target=\"_blank\" rel=\"noopener nofollow\">techfest@sliet.ac.in<\/a><\/li>\n<\/ul>\n<p>&nbsp;<\/p>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":27463276,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-04T20:10:08+05:30","updated_at":"2026-10-05T22:00:12+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"6oGCwJx","hashtags":null,"participation_certificate":0,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":null,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":2,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-04 20:26:16","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/6ac3d09478156_Sant_Longowal_Institute_of_Engineering_and_Technology_Logo.png","logoUrl2":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/150x150\/6ac3d09478156_Sant_Longowal_Institute_of_Engineering_and_Technology_Log