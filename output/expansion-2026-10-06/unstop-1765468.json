{"data":{"status":true,"competition":{"id":1765468,"visibility":"public","theme_colour":null,"paid":0,"title":"Campus Quest | Decode - Explore - Conquer","festival_id":521442,"organization_id":1076204,"web_url":null,"start_date":"2026-10-04T00:00:00+05:30","end_date":"2026-11-14T11:56:00+05:30","location":null,"type":"competitions","public_url":"competitions\/campus-quest-decode-explore-conquer-nisadya-national-institute-of-technology-nit-tiruchirappalli-1765468","region":"offline","details":"<p><strong>About the Event:<\/strong><\/p>\n<p>Campus Quest is an exclusive undergraduate treasure hunt at Nisadya'26, the annual business fest of the Department of Management Studies, NIT Tiruchirappalli. It lets your team experience the campus in a whole new way. Solve puzzles, crack clues, and race across the NIT Trichy campus to find the treasure. Time taken is one of the deciding factors, so think on your feet and outsmart your opponents.<\/p>\n<p><strong>Prizes:<\/strong><\/p>\n<ul>\n<li>1st Prize: Rs. 2,000<\/li>\n<li>2nd Prize: Rs. 1,000<\/li>\n<\/ul>\n<p><strong>Round 1: Cipher Rush (Online):<\/strong><\/p>\n<p>Teams solve fun puzzles, riddles, visual clues, cryptic questions and lateral-thinking challenges. This is an elimination round, and the top-scoring teams qualify for Round 2.<\/p>\n<p><strong>Round 2: The Treasure Trail (Offline):<\/strong><\/p>\n<p>Qualified teams come to the NIT Trichy campus. Each team gets a small campus map for reference and follows a chain of clues spread across different locations. Every clue leads to the next, and teams may have to complete small tasks along the way. The first teams to find the treasure within the time limit win.<\/p>\n<p><strong>Rules and Guidelines:<\/strong><\/p>\n<ul>\n<li>Teams must register on Unstop. Team members can't be changed after registration closes.<\/li>\n<li>Round 1 must be completed within the given time window. Late submissions won't be considered.<\/li>\n<li>Round 1 results are based on correct answers, with time taken as the tiebreaker.<\/li>\n<li>Only shortlisted teams may attend Round 2, and all members must be present on the day.<\/li>\n<li>Round 2 has a fixed time limit (around 2 hours). Teams that exceed it are ranked below those who finish.<\/li>\n<li>Mobile phones are not allowed during Round 2. Teams will navigate using the map provided.<\/li>\n<li>Teams must follow the clues in sequence and must not skip checkpoints.<\/li>\n<li>Teams must stay within the campus areas designated for the hunt. Restricted areas are out of bounds.<\/li>\n<li>Please be respectful of campus property, staff, and other participants. Damaging or removing property leads to disqualification.<\/li>\n<li>Clues can't be shared with other teams. Any malpractice leads to disqualification.<\/li>\n<li>The organisers' decision is final.<\/li>\n<\/ul>\n<p><strong>Eligibility:<\/strong><\/p>\n<ul>\n<li>Open only to undergraduate (UG) students<\/li>\n<li>Participants from other colleges are welcome<\/li>\n<li>Valid college ID required.<\/li>\n<\/ul>","overall_prizes":"Prizes- 1st Prize: Rs. 2,000- 2nd Prize: Rs. 1,000","regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":29663114,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-03T23:12:07+05:30","updated_at":"2026-10-05T09:57:30+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"JpzrN5Z","hashtags":null,"participation_certificate":0,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":2,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":0,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-03 23:52:28"