{"data":{"status":true,"competition":{"id":1764531,"visibility":"public","theme_colour":null,"paid":0,"title":"HackerWrath 3.0","festival_id":null,"organization_id":486,"web_url":null,"start_date":"2026-10-02T12:00:00+05:30","end_date":"2026-10-19T23:59:00+05:30","location":null,"type":"hackathons","public_url":"hackathons\/hackerwrath-30-guru-nanak-dev-university-gndu-amritsar-1764531","region":"offline","details":"<p><strong>Dates: <\/strong>22 - 23 October, 2026<\/p>\n<p><strong>Eligibility:<\/strong><\/p>\n<ul>\n<li>Open to B.Tech students from colleges and universities.<\/li>\n<li>Inter-college teams are allowed.<\/li>\n<li>Students from different branches\/specializations can form a team.<\/li>\n<li>Each team must consist of 3&ndash;5 members.<\/li>\n<li>Each participant can be part of only one team.<\/li>\n<li>The hackathon will be conducted completely offline at GNDU, Amritsar.<\/li>\n<\/ul>\n<p><strong>Hackathon Format:<\/strong><\/p>\n<ul>\n<li>The hackathon will run for 24 hours.<\/li>\n<li>Tracks and problem statements will be revealed at the beginning of the hackathon.<\/li>\n<li>Teams will select\/work on the problem statement according to the guidelines announced by the organizers.<\/li>\n<li>Teams will develop, test, and refine their solutions during the hackathon.<\/li>\n<li>An elimination round will be conducted to evaluate the participating teams.<\/li>\n<li>Finalist teams will be shortlisted based on their performance in the elimination round.<\/li>\n<li>Finalists will present and demonstrate their solutions offline at GNDU before the judging panel.<\/li>\n<\/ul>\n<p><strong>Facilities:<br \/><\/strong><\/p>\n<ul>\n<li>Food (3+ meals)<\/li>\n<li>Accomodation facilities (dormitory)&nbsp;<\/li>\n<li>Internet facilities (via Ethernet)<\/li>\n<li>Games and recreational sessions&nbsp;<\/li>\n<\/ul>\n<p><strong><br \/>Process:<\/strong><\/p>\n<ul>\n<li>Registration and Team Formation &ndash; Participants register and form teams of 3&ndash;5 members.<\/li>\n<li>Track &amp; Problem Statement Reveal &ndash; Tracks and official problem statements will be announced at the beginning of the hackathon.<\/li>\n<li>Development Phase &ndash; Teams work on their selected problem statement during the 24-hour development period.<\/li>\n<li>Project Submission &ndash; Teams submit their GitHub repository and project presentation\/PPT within the specified deadline.<\/li>\n<li>Elimination Round &ndash; Submitted projects will be evaluated, and the strongest teams will advance to the final round.<\/li>\n<li>Final Presentation &ndash; Shortlisted teams will present and demonstrate their projects before the judges at GNDU.<\/li>\n<li>Winner Announcement &ndash; Winners will be announced after the final evaluation.<\/li>\n<\/ul>\n<p><strong>Submission Requirements:<\/strong><\/p>\n<ul>\n<li>GitHub repository containing the project.<\/li>\n<li>Project presentation\/PPT.<\/li>\n<li>Working prototype\/project for demonstration.<\/li>\n<li>Any additional material requested by the organizers during the hackathon.<\/li>\n<\/ul>\n<p><strong>Judging Criteria:<\/strong><\/p>\n<ul>\n<li>Projects will be evaluated based on:<\/li>\n<li>Innovation and originality<\/li>\n<li>Real-world impact<\/li>\n<li>Problem understanding<\/li>\n<li>Technical implementation<\/li>\n<li>Functionality and working prototype<\/li>\n<li>Feasibility and scalability<\/li>\n<li>User experience<\/li>\n<li>Quality of presentation and demonstration<\/li>\n<\/ul>\n<p><strong>Rules:<\/strong><\/p>\n<ul>\n<li>Each team must have 3&ndash;5 members.<\/li>\n<li>Inter-college teams are allowed.<\/li>\n<li>Inter-branch\/inter-specialization teams are allowed.<\/li>\n<li>Each participant can participate in only one team.<\/li>\n<li>The hackathon will be conducted offline at GNDU, Amritsar.<\/li>\n<li>Problem statements and tracks will be revealed during the hackathon.<\/li>\n<li>Pre-existing projects are not allowed. Projects must be developed specifically for HackerWrath 3.0.<\/li>\n<li>Guidelines regarding the use of AI tools will be announced during the hackathon.<\/li>\n<li>Teams must submit their projects within the specified deadline.<\/li>\n<li>Teams must provide a valid GitHub repository.<\/li>\n<li>Plagiarism, cheating, misrepresentation, or any form of misconduct may lead to disqualification.<\/li>\n<li>Only shortlisted teams will proceed to the final presentation round.<\/li>\n<li>Finalists must present and demonstrate their projects offline at GNDU.<\/li>\n<li>The decision of the judging panel regarding the final results will be final.<\/li>\n<\/ul>","overall_prizes":"\u20b960,000+ Total Prize Pool for winning team members, trophies, and certificates.","regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":33482994,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-01T21:42:01+05:30","updated_at":"2026-10-05T15:04:10+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"online_coding_challenge","combined_leaderboard":null,"source":null,"short_id":"JugGFtE","hashtags":null,"participation_certificate":1,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":15,"checked":2,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":1,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-02 10:39:24","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/uploadedManual-6abf41d91741f_whatsapp_image_2026-10-01_at_12_56_11_pm.jpeg","logoUrl2":"https:\/\/d8it4huxumps7.cloud