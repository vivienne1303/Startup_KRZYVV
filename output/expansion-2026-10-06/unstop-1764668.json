{"data":{"status":true,"competition":{"id":1764668,"visibility":"public","theme_colour":"blue-dark_un","paid":0,"title":"AutoPilot","festival_id":520805,"organization_id":967,"web_url":null,"start_date":"2026-10-02T00:00:00+05:30","end_date":"2026-10-16T00:00:00+05:30","location":null,"type":"hackathons","public_url":"hackathons\/autopilot-shunya-2026-netaji-subhas-university-of-technology-nsut-delhi-1764668","region":"offline","details":"<p><strong>Autopilot:<\/strong><\/p>\n<p><strong>Build an Agent. Give It a Mission. Let It Take Over.<\/strong><\/p>\n<p><strong>17 October 2026 | NSUT, Delhi | 6 Hours<\/strong><\/p>\n<p>Welcome to <strong>AutoPilot<\/strong>, a 6-hour Agenthon where you don't just build an AI application. You build an <strong>AI agent that has to actually get things done.<\/strong><\/p>\n<p>On the day of the event, every team will receive a task. You won't know exactly what you're building until the challenge begins.<\/p>\n<p>Your job is to design and implement an agent capable of autonomously performing that task. How you structure the agent, how it interacts with its environment, how it makes decisions, and how you handle the problem will be entirely up to you within the constraints provided on the day.<\/p>\n<p>To make the competition focused entirely on the agents, we've built the infrastructure ourselves. Participants will get access to a dedicated platform, SDK, and the tools required to build and test their implementation. You'll also have a system through which you can interact with and validate your agent before submitting it for evaluation.<\/p>\n<p>And then comes the interesting part.<\/p>\n<p><strong>There is no human sitting there deciding whether your agent worked.<\/strong><\/p>\n<p>Your agent will be evaluated by our automated judging system against the same challenge. Your performance will be reflected on the leaderboard, putting your implementation directly against everyone else's.<\/p>\n<p>But simply getting a high score isn't the whole story.<\/p>\n<p>The <strong>approach used to build your agent<\/strong> will also matter. How you designed your system, how it tackles the problem, and the decisions behind your implementation will be part of what separates strong solutions from the rest.<\/p>\n<p>No predefined solution.<\/p>\n<p>No human judging.<\/p>\n<p>No second attempt at the challenge.<\/p>\n<p>Just <strong>6 hours, one task, your agent, and the leaderboard.<\/strong><\/p>\n<p><strong>Event Details:<\/strong><\/p>\n<ul>\n<li>Team Size: 1-3 participants<\/li>\n<li>Eligibility: Open to all college students<\/li>\n<li>Location: NSUT, Delhi<\/li>\n<li>Duration: 6 hours<\/li>\n<li>Date: 17 October 2026<\/li>\n<\/ul>\n<p>The task will be revealed on the day.<\/p>\n<p><strong>Your agent knows what to do. The question is whether you can build it.<\/strong><\/p>","overall_prizes":"Prizes will consists of cash prize + vouchers + goodies","regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":26779957,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-02T07:55:46+05:30","updated_at":"2026-10-03T15:08:10+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"online_coding_challenge","combined_leaderboard":null,"source":null,"short_id":"KYGo8U5","hashtags":null,"participation_certificate":1,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":30,"checked":null,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":34,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-02 08:06:20","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"link