{"data":{"status":true,"competition":{"id":1763146,"visibility":"public","theme_colour":"amber-dark_un","paid":0,"title":"CODEVERSE 2.0","festival_id":null,"organization_id":976685,"web_url":null,"start_date":"2026-09-29T16:00:00+05:30","end_date":"2026-10-07T07:00:00+05:30","location":null,"type":"hackathons","public_url":"hackathons\/codeverse-20-svkm-djsanghvi-college-of-engineering-1763146","region":"offline","details":"<p><strong>Codeverse 2.0<\/strong><\/p>\n<p>Codeverse 2.0 is a technology-focused competitive event that tests participants through challenging, time-bound tasks involving debugging, problem-solving, data analysis, web investigation, algorithms, and machine learning.<br \/><br \/>The event is divided into two phases. Teams compete in Phase 1, and the top-performing teams advance to Phase 2, where the difficulty increases and challenges become more complex.<br \/><br \/><strong>Phase 1 &mdash; The Royal Mint<\/strong><\/p>\n<ul>\n<li>Open to all teams<\/li>\n<li>Basic debugging, cryptography, web investigation, data analysis &amp; algorithms<\/li>\n<li>Interconnected challenges<\/li>\n<li>Speed and accuracy determine qualification<\/li>\n<\/ul>\n<p><strong>Phase 2 &mdash; The Escape<\/strong><\/p>\n<ul>\n<li>Shortlisted teams only<\/li>\n<li>Advanced debugging, forensics, web investigation &amp; algorithms<\/li>\n<li>Hidden clues, decoys and interconnected challenges<\/li>\n<li>Teams race to complete the final extraction&nbsp;<\/li>\n<\/ul>\n<p><strong>Rules&nbsp;<\/strong><\/p>\n<div dir=\"auto\">\n<ul>\n<li>Team Size: Each team must consist of 2&ndash;3 members. A participant can be part of only one team.<\/li>\n<li>Two Phases: The event consists of Phase 1 &mdash; The Royal Mint and Phase 2 &mdash; The Escape. Only shortlisted teams from Phase 1 proceed to Phase 2.<\/li>\n<li>Time Limit: All challenges are time-bound. Teams must submit their answers before the specified deadline.<\/li>\n<li>Fair Play: Teams must solve challenges independently. Sharing answers, collaborating with other teams, or using another team&rsquo;s work is strictly prohibited.<\/li>\n<li>Resources: Participants may use only the tools, websites, and resources permitted by the organizers for each challenge.&nbsp;&nbsp;<\/li>\n<\/ul>\n<p><strong>Guidelines&nbsp;<\/strong><\/p>\n<ul>\n<li>Scoring: Points are awarded for successfully completed challenges. In case of a tie, completion time or a tie-breaker challenge may be used.<\/li>\n<li>Technical Issues: Any technical issue must be reported to the organizers immediately. Decisions regarding technical issues and additional time will be made by the organizers<\/li>\n<li>Disqualification: Cheating, unauthorized access, tampering with the event platform, or any unfair practice may result in immediate disqualification.<\/li>\n<li>Organizer&rsquo;s Decision: The organizers reserve the right to modify timings, challenges, or rules if required. The organizers&rsquo; decision will be final.<\/li>\n<\/ul>\n<\/div>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":33454070,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-09-29T15:14:23+05:30","updated_at":"2026-10-04T16:59:22+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"online_coding_challenge","combined_leaderboard":null,"source":null,"short_id":"Yf7SJ8Z","hashtags":null,"participation_certificate":1,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":2,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":1,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-09-29 15:31:34","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"