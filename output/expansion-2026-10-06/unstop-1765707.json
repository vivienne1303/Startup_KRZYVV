{"data":{"status":true,"competition":{"id":1765707,"visibility":"public","theme_colour":null,"paid":0,"title":"AD Mania - Identify, Counter Ad, AdZap","festival_id":521442,"organization_id":1076204,"web_url":null,"start_date":"2026-10-04T00:00:00+05:30","end_date":"2026-11-14T10:25:00+05:30","location":null,"type":"competitions","public_url":"competitions\/ad-mania-identify-counter-ad-adzap-nisadya-national-institute-of-technology-nit-tiruchirappalli-1765707","region":"offline","details":"<p><strong>All that you need to know about AD MANIA:<\/strong><\/p>\n<p>Every successful brand is built on a compelling story, and bringing that story to life requires creativity, strategy, and confidence. AD MANIA challenges participants to demonstrate the skills of a brand strategist, the creativity of a copywriter, and the confidence of a performer through a rigorous three-round advertising competition.<\/p>\n<p><strong>Rules and Guidelines:<\/strong><\/p>\n<ul>\n<li>Number of Rounds: 3 (Identify the Ad &rarr; Counter Ad &rarr; AdZap)<\/li>\n<li>Team Size: [1&ndash;3] members per team<\/li>\n<li>All team members must be from the same institution<\/li>\n<li>A student cannot be part of more than one team<\/li>\n<li>Each team may submit only one entry per round<\/li>\n<li>Round 1 submissions\/responses must be completed within the stipulated window, late entries will not be considered<\/li>\n<li>Round 2 Counter-ad submissions must be entirely original and created by the participating team. Any form of plagiarism, unauthorized use of existing agency content, or copyright infringement will result in immediate disqualification.<\/li>\n<li>Round 3 is mandatory in-person; shortlisted teams unable to attend offline will be removed from the competition.<\/li>\n<li>Props, time limits, and constraints for the AdZap round will be shared with shortlisted teams beforehand and must be strictly followed.<\/li>\n<li>Any violation of the above rules will result in immediate disqualification of the entire team<\/li>\n<li>The event format and rules are subject to change prior to the commencement of the event.<\/li>\n<li>All decisions regarding eligibility, shortlisting, and final evaluation shall rest with the AD MANIA team and the judges. The judges&rsquo; decision shall be final and binding, and no further requests or appeals will be entertained once the results are declared.<\/li>\n<\/ul>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":29663114,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-04T19:33:22+05:30","updated_at":"2026-10-05T10:11:25+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"x9aIJNH","hashtags":null,"participation_certificate":0,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":2,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":1,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-04 20:53:59","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/6ac32a55006ed_nit_trichy.jpg","logoUrl2":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/150x150\/6ac32a55006ed_nit_trichy.jpg","regnRequirements":{"id":2497353,"opportunity_id":1765707,"festival_id":null,"max_team_size":3,"min_team_size":1,"start_regn_dt":"2026-10-04T00:00:00+05:30","end_regn_dt":"2026-10-17T23:59:05+05:30","show_deadline":1,"open_for":0,"college_type":0,"same_