{"data":{"status":true,"competition":{"id":1765389,"visibility":"public","theme_colour":null,"paid":0,"title":"Innovation odyssey ","festival_id":null,"organization_id":652294,"web_url":null,"start_date":"2026-10-03T00:00:00+05:30","end_date":"2026-10-14T00:00:00+05:30","location":null,"type":"competitions","public_url":"competitions\/innovation-odyssey-shaheed-rajguru-college-of-applied-sciences-for-women-delhi-university-1765389","region":"offline","details":"<p><strong>Guidelines:<\/strong><\/p>\n<p><strong>Eligibility<\/strong>:<\/p>\n<ul>\n<li>Participation can be individual or in teams of up to __4_ members.<\/li>\n<li>Participants should bring their own hardware\/software prototype.<\/li>\n<li>The prototype can be from electronics, IoT, robotics, AI\/ML, software, automation, sustainability, healthcare, smart systems, etc.<\/li>\n<\/ul>\n<p><strong>Prototype Requirement:<\/strong><\/p>\n<ul>\n<li>The prototype must be functional\/working at the time of demonstration.<\/li>\n<li>Participants should be able to demonstrate the actual working of their project.<\/li>\n<li>Both hardware and software prototypes are allowed.<\/li>\n<li>A concept, poster, PPT, or only theoretical idea will not qualify as a working prototype.<\/li>\n<li>Previously developed projects can be presented, but participants must clearly state what they developed\/modified themselves.<\/li>\n<\/ul>\n<p><strong>What Participants Have to Explain:<\/strong><\/p>\n<ul>\n<li>During their presentation\/demo, participants should cover:<\/li>\n<li>Problem Statement &ndash; What real-world problem are you solving?<\/li>\n<li>Idea\/Solution &ndash; What is your proposed solution?<\/li>\n<li>Working &ndash; How does your prototype actually work?<\/li>\n<li>Technology Used &ndash; Hardware, software, sensors, programming languages, etc.<\/li>\n<li>Innovation &ndash; What makes your approach different or interesting?<\/li>\n<li>Applications &ndash; Where can it be used?<\/li>\n<li>Future Scope &ndash; How could it be improved or scaled?<\/li>\n<\/ul>\n<p><strong>Demonstration:<\/strong><\/p>\n<ul>\n<li>Each team gets __15_ minutes for presentation + __10_ minutes for demonstration\/Q&amp;A.<\/li>\n<li>Participants must bring all required components, laptops, chargers, adapters, cables, etc.<\/li>\n<li>The prototype should preferably be demonstrated live.<\/li>\n<li>A backup video\/demo may be kept in case of technical failure, but it should not replace the actual prototype.<\/li>\n<\/ul>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":33512419,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-03T19:30:15+05:30","updated_at":"2026-10-04T20:01:35+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"case_competition","combined_leaderboard":null,"source":null,"short_id":"9maMXNH","hashtags":null,"participation_certificate":0,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":null,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":27,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-04 19:26:03","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/6ac263430de8f_organisation_image-qQR3ZxSrqs1913972161YB8qqaztms.png","logoUrl2":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/150x150\/6ac263430de8f_organisation_image-qQR3ZxSrqs1913972161YB8qqaztms.png","regnRequirements":{"id":2497033,"opportunity_id":1765389,"festival_id":null,"max_t