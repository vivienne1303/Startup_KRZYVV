{"data":{"status":true,"competition":{"id":1766149,"visibility":"public","theme_colour":"amber-dark_un","paid":0,"title":"Code Bounty 2.0","festival_id":null,"organization_id":289,"web_url":null,"start_date":"2026-10-05T00:00:00+05:30","end_date":"2026-10-12T18:11:54+05:30","location":null,"type":"hackathons","public_url":"hackathons\/code-bounty-20-shri-vile-parle-kelavani-mandals-dwarkadas-j-sanghvi-college-of-engineering-djsce-mumbai-1766149","region":"offline","details":"<p><strong>Overview:<\/strong><\/p>\n<p>Get ready for a Competitive Programming showdown where speed, accuracy, teamwork, and strategy come together.<\/p>\n<p>Whether you are an experienced competitive programmer or relatively new to CP, the competition offers multiple ways to contribute and make an impact.<\/p>\n<p>The competition unfolds across three stages: a fast-paced Competitive Programming Round, a Non-Technical Challenge, and the Grand CP Finale.<\/p>\n<p>But there is a twist.<\/p>\n<p>Your performance in the earlier stages can directly influence your advantage in the finale. Every second, every decision, and every problem counts.<\/p>\n<p><strong>Guidelines:<\/strong><\/p>\n<ul>\n<li>Team Size: 2 participants<\/li>\n<li>Inter-College Teams: Allowed<\/li>\n<li>Round 1: Fast-paced CP round featuring easy-to-medium difficulty problems<\/li>\n<li>Qualification: Top 30 teams advance to Round 2<\/li>\n<li>Round 2: 30-minute Challenge consisting of puzzles, quizzes, and other challenges<\/li>\n<li>Round 3: Grand CP Finale where both teammates compete individually and strategically use the advantages earned in Round 2<\/li>\n<li>Detailed instructions and rules for each round will be announced before the respective round begins.<\/li>\n<\/ul>\n<p><strong>Rules:<\/strong><\/p>\n<ul>\n<li>Each participant may be a member of only one team.<\/li>\n<li>Plagiarism, copying, solution sharing, or any form of collaboration outside the permitted team structure is strictly prohibited.<\/li>\n<li>Participants must follow all instructions and guidelines issued by the organizers.<\/li>\n<li>Any form of unfair assistance, cheating, or misconduct may result in immediate disqualification.<\/li>\n<li>All submissions must be made through the designated contest platform.<\/li>\n<li>Participants are responsible for ensuring that their submissions comply with the rules of the respective round.<\/li>\n<li>The organizers reserve the right to disqualify participants or teams found violating the rules.<\/li>\n<li>The organizers' decision regarding qualification, scoring, penalties, and disqualification shall be final and binding.<\/li>\n<\/ul>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":21907789,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-05T17:58:02+05:30","updated_at":"2026-10-05T21:40:40+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"online_coding_challenge","combined_leaderboard":null,"source":null,"short_id":"P9DSkoY","hashtags":null,"participation_certificate":0,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":null,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":28,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-05 17:59:58","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/uploadedManual-6ac397e2071ff_photo-2026-10-05-16-08-47.jpg","logoUrl2":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/150x150\/uploadedMa