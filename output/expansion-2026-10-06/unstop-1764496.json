{"data":{"status":true,"competition":{"id":1764496,"visibility":"public","theme_colour":"blue_un","paid":0,"title":"Market Maestros 2026 | Stock Market Simulation & Investment Challenge","festival_id":null,"organization_id":109494,"web_url":null,"start_date":"2026-10-02T00:00:00+05:30","end_date":"2026-10-24T16:00:00+05:30","location":null,"type":"competitions","public_url":"competitions\/market-maestros-2026-stock-market-simulation-investment-challenge-institute-of-management-studies-fms-banar-1764496","region":"hybrid","details":"<p><strong>Overview:<\/strong><\/p>\n<p>Motilal Oswal &amp; Dhanalytics AI Presents: Market Maestros 2026<\/p>\n<p>Calling all aspiring investors, market enthusiasts and strategic thinkers!<\/p>\n<p>Market Maestros 2026 is a Stock Market Simulation &amp; Investment Challenge organised by Krtyanvesana &ndash; The Consulting Club, Institute of Management Studies, Banaras Hindu University (BHU), with Motilal Oswal and Dhanalytics AI as the Title Sponsors.<\/p>\n<p>Experience the dynamics of financial markets, analyse market movements, make strategic investment decisions and put your market acumen to the test.<\/p>\n<p><strong>What is Market Maestros:<\/strong><\/p>\n<p>Market Maestros is a simulated stock market competition that gives participants an opportunity to experience investing and trading in a competitive environment.<\/p>\n<p>Participants will analyse market situations, manage their virtual portfolios and make strategic decisions while balancing risk and potential returns.<\/p>\n<p><strong>Competition Structure:<\/strong><\/p>\n<p><strong>Round 1 &mdash; Stock Market Simulation:<\/strong><\/p>\n<p>A one-week trading and investment simulation where teams analyse market movements and manage their virtual portfolios.<\/p>\n<p><strong>Round 2 &mdash; Investment Strategy Presentation:<\/strong><\/p>\n<p>Shortlisted teams will present their investment strategy, portfolio decisions and market rationale before the judging panel.<\/p>\n<p><strong>What You Will Experience:<\/strong><\/p>\n<ul>\n<li>Practical exposure to financial-market decision-making<\/li>\n<li>Investment and portfolio strategy<\/li>\n<li>Risk management and market analysis<\/li>\n<li>Decision-making under changing market conditions<\/li>\n<li>Competition with students from across India<\/li>\n<\/ul>\n<p><strong>Eligibility:<\/strong><\/p>\n<p>Open to college and university students across India with an interest in stock markets, finance, investing, business and strategy.<\/p>\n<p><strong>Title Sponsors:<\/strong><\/p>\n<p>Motilal Oswal &amp; Dhanalytics AI<\/p>\n<p><strong>Event Date:<\/strong><\/p>\n<p>24 October 2026<\/p>\n<p>Join the challenge. Build your strategy. Make your move. Become a Market Maestro.<\/p>","overall_prizes":"Win exciting cash prizes worth \u20b922,000, along with certificates for the winners!","regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":33487272,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-01T20:35:29+05:30","updated_at":"2026-10-05T22:55:42+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"Zd6cI2e","hashtags":null,"participation_certificate":1,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":7,"checked":2,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":4,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-01 21:13:55","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxu