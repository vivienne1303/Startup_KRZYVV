{"data":{"status":true,"competition":{"id":1764596,"visibility":"public","theme_colour":"amber-dark_un","paid":0,"title":"Devlympics","festival_id":520805,"organization_id":967,"web_url":null,"start_date":"2026-10-01T00:00:00+05:30","end_date":"2026-10-18T14:00:00+05:30","location":null,"type":"hackathons","public_url":"hackathons\/devlympics-shunya-2026-netaji-subhas-university-of-technology-nsut-delhi-1764596","region":"offline","details":"<p><strong>Devlympics:<\/strong><\/p>\n<p><strong>24 Hours. One Theme. Endless Possibilities.<\/strong><\/p>\n<p><strong>17-18 October 2026 | NSUT, Delhi<\/strong><\/p>\n<p>Devlympics is not your traditional hackathon.<\/p>\n<p>There are no predefined problem statements waiting for you. No weeks of preparation. No building your project beforehand and showing up with a polished prototype.<\/p>\n<p>You start from zero.<\/p>\n<p>When the clock starts, the challenge begins. A theme will be revealed, and from that moment, you and your team will have <strong>24 hours to think, build, experiment, break things, fix them, and create something worth showing off.<\/strong><\/p>\n<p>The theme is intentionally open-ended. You could build a web app, mobile application, game, AI project, hardware experiment, interactive experience, or something nobody expected. There is no single \"right\" solution. How you interpret the theme is part of the challenge.<\/p>\n<p>But there is a catch.<\/p>\n<p><strong>Devlympics isn't just about coding for 24 hours.<\/strong><\/p>\n<p>Throughout the event, expect things to change. There may be unexpected challenges, creative constraints, sudden tasks, and moments where your original plan goes completely out the window.<\/p>\n<p>Your ability to adapt, collaborate, think creatively, and keep building under pressure will matter just as much as your technical skills.<\/p>\n<p>At the end of the 24 hours, you'll present what you built to the judges.<\/p>\n<p>Projects will be evaluated on <strong>theme interpretation, creativity and originality, execution, overall experience, presentation, and how well teams embrace the challenges thrown at them.<\/strong><\/p>\n<p>So bring your laptop, find your team, and come prepared to build something you probably weren't expecting to build.<\/p>\n<p><strong>Event Details:<\/strong><\/p>\n<ul>\n<li>Team Size: 1-3 participants<\/li>\n<li>Eligibility: Open to all college students<\/li>\n<li>Location: NSUT, Delhi<\/li>\n<li>Duration: 24 hours, overnight<\/li>\n<li>Dates: 17-18 October 2026<\/li>\n<\/ul>\n<p><strong>What happens during those 24 hours?<\/strong><\/p>\n<p>That's something you'll have to discover yourself.<\/p>\n<p><strong>The clock starts. The theme drops. Everything changes.<\/strong><\/p>","overall_prizes":"Prizes will consists of cash prize + vouchers + goodies","regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":26779957,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-01T23:12:37+05:30","updated_at":"2026-10-05T12:30:37+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"online_coding_challenge","combined_leaderboard":null,"source":null,"short_id":"FzqN56l","hashtags":null,"participation_certificate":1,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":30,"checked":null,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":26,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-02 07:54:51","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75