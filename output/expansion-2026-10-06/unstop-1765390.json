{"data":{"status":true,"competition":{"id":1765390,"visibility":"public","theme_colour":"blue_un","paid":0,"title":"TechYuva 11.0 \u2013 Technical Model Competition 2026 | Ideas to Models, Models to Solutions","festival_id":null,"organization_id":1939143,"web_url":"www.bit.ac.in\/#","start_date":"2026-10-03T00:00:00+05:30","end_date":"2026-10-28T23:59:00+05:30","location":null,"type":"competitions","public_url":"competitions\/techyuva-110-technical-model-competition-2026-ideas-to-models-models-to-solutions-buddha-innovation-council-1765390","region":"offline","details":"<p dir=\"auto\" data-section-id=\"1699a9w\" data-start=\"519\" data-end=\"543\"><strong>About the Competition<\/strong><\/p>\n<ul>\n<li dir=\"auto\" data-start=\"545\" data-end=\"811\"><strong data-start=\"545\" data-end=\"580\">Buddha Innovation Council (BIC)<\/strong>, the Incubation Unit of <strong data-start=\"605\" data-end=\"650\">Buddha Institute of Technology, Gorakhpur<\/strong>, is organizing <strong data-start=\"666\" data-end=\"718\">TECHYUVA 11.0 &ndash; Technical Model Competition 2026<\/strong>, sponsored by <strong data-start=\"733\" data-end=\"810\">AKTU Innovation Hub, Dr. A.P.J. Abdul Kalam Technical University, Lucknow<\/strong>.<\/li>\n<li dir=\"auto\" data-start=\"813\" data-end=\"1026\">TECHYUVA 11.0 is a platform for <strong data-start=\"845\" data-end=\"897\">students, startups, innovators and entrepreneurs<\/strong> to present their innovative ideas, technical models, prototypes and technology-based solutions addressing real-world challenges.<\/li>\n<li dir=\"auto\" data-start=\"1028\" data-end=\"1200\">The competition provides participants with an opportunity to <strong data-start=\"1089\" data-end=\"1161\">showcase, present and receive expert evaluation of their innovations<\/strong> in a physical competition environment.<\/li>\n<\/ul>\n<p dir=\"auto\" data-section-id=\"1v67a23\" data-start=\"1207\" data-end=\"1225\"><strong>Why Participate?<\/strong><\/p>\n<ul data-start=\"1227\" data-end=\"1623\">\n<li data-section-id=\"bef4u1\" data-start=\"1227\" data-end=\"1281\">Showcase your <strong data-start=\"1243\" data-end=\"1281\">innovative idea or technical model<\/strong><\/li>\n<li data-section-id=\"1slvdvz\" data-start=\"1282\" data-end=\"1327\">Present your <strong data-start=\"1297\" data-end=\"1327\">prototype or working model<\/strong><\/li>\n<li data-section-id=\"1yrl8tn\" data-start=\"1328\" data-end=\"1374\">Get an opportunity for <strong data-start=\"1353\" data-end=\"1374\">expert evaluation<\/strong><\/li>\n<li data-section-id=\"qsl5d4\" data-start=\"1375\" data-end=\"1421\">Compete at the <strong data-start=\"1392\" data-end=\"1421\">Screening and Final Round<\/strong><\/li>\n<li data-section-id=\"yq15s5\" data-start=\"1422\" data-end=\"1473\">Top <strong data-start=\"1428\" data-end=\"1440\">50 teams<\/strong> will qualify for the Final Round<\/li>\n<li data-section-id=\"18yzrja\" data-start=\"1474\" data-end=\"1495\">Win <strong data-start=\"1480\" data-end=\"1495\">cash prizes<\/strong><\/li>\n<li data-section-id=\"7o0wpo\" data-start=\"1496\" data-end=\"1536\">Receive <strong data-start=\"1506\" data-end=\"1536\">Participation Certificates<\/strong><\/li>\n<li data-section-id=\"1bnhfhy\" data-start=\"1537\" data-end=\"1623\">Connect with an ecosystem focused on <strong data-start=\"1576\" data-end=\"1623\">innovation, technology and entrepreneurship<\/strong><\/li>\n<\/ul>\n<p dir=\"auto\" data-section-id=\"14vv235\" data-start=\"1625\" data-end=\"1677\"><span role=\"text\"><strong data-start=\"1629\" data-end=\"1677\">Think &bull; Build &bull; Innovate &bull; Present &bull; Inspire<\/strong><\/span><\/p>\n<p dir=\"auto\" data-section-id=\"13mvb8x\" data-start=\"1684\" data-end=\"1706\"><strong>Who Can Participate?<\/strong><\/p>\n<p dir=\"auto\" data-start=\"1708\" data-end=\"1733\">TECHYUVA 11.0 is open to:<\/p>\n<ul data-start=\"1735\" data-end=\"1883\">\n<li data-section-id=\"17be2bd\" data-start=\"1735\" data-end=\"1753\">College Students<\/li>\n<li data-section-id=\"chvnzw\" data-start=\"1754\" data-end=\"1783\">Undergraduate (UG) Students<\/li>\n<li data-section-id=\"xafl49\" data-start=\"1784\" data-end=\"1812\">Postgraduate (PG) Students<\/li>\n<li data-section-id=\"13pjyzi\" data-start=\"1813\" data-end=\"1823\">Startups<\/li>\n<li data-section-id=\"zno5ur\" data-start=\"1824\" data-end=\"1836\">Innovators<\/li>\n<li data-section-id=\"1sa0l6g\" data-start=\"1837\" data-end=\"1852\">Entrepreneurs<\/li>\n<li data-section-id=\"1ob9okp\" data-start=\"1853\" data-end=\"1883\">Young Technology Enthusiasts<\/li>\n<\/ul>\n<p dir=\"auto\" data-start=\"1885\" data-end=\"2037\">Participants can present an <strong data-start=\"1913\" data-end=\"2004\">innovative idea, technical model, prototype, working model or technology-based solution<\/strong> addressing a real-world problem.<\/p>\n<p dir=\"auto\" data-section-id=\"73a5o0\" data-start=\"2044\" data-end=\"2064\"><strong>Competition Format<\/strong><\/p>\n<p dir=\"auto\" data-section-id=\"1e5oyut\" data-start=\"2066\" data-end=\"2096\"><span role=\"text\"><strong data-start=\"2069\" data-end=\"2096\">DAY 1 &ndash; Screening Round<\/strong><\/span><\/p>\n<p dir=\"auto\" data-section-id=\"nq2v66\" data-start=\"2097\" data-end=\"2130\"><span role=\"text\"><strong data-start=\"2101\" data-end=\"2130\">3 November 2026 | Tuesday<\/strong><\/span><\/p>\n<p dir=\"auto\" data-start=\"2131\" data-end=\"2149\"><strong data-start=\"2131\" data-end=\"2149\">Mode: Physical<\/strong><\/p>\n<p dir=\"auto\" data-start=\"2151\" data-end=\"2177\">Participants will present:<\/p>\n<ul data-start=\"2179\" data-end=\"2246\">\n<li data-section-id=\"1kvwjac\" data-start=\"2179\" data-end=\"2216\">Innovative Idea through PPT, and\/or<\/li>\n<li data-section-id=\"imr3bp\" data-start=\"2217\" data-end=\"2246\">Technical Model \/ Prototype<\/li>\n<\/ul>\n<p dir=\"auto\" data-start=\"2248\" data-end=\"2335\">The screening round will be conducted at <strong data-start=\"2289\" data-end=\"2334\">Buddha Institute of Technology, Gorakhpur<\/strong>.<\/p>\n<p dir=\"auto\" data-section-id=\"9wgo85\" data-start=\"2337\" data-end=\"2384\"><span role=\"text\"><strong data-start=\"2341\" data-end=\"2384\">No Registration Fee for Screening Round<\/strong><\/span><\/p>\n<p dir=\"auto\" data-start=\"2386\" data-end=\"2475\">All registered teams can participate in the Screening Round without any registration fee.<\/p>\n<p dir=\"auto\" data-start=\"2477\" data-end=\"2534\"><strong data-start=\"2477\" data-end=\"2493\">Top 50 teams<\/strong> will be shortlisted for the Final Round.<\/p>\n<p dir=\"auto\" data-section-id=\"pg2q8l\" data-start=\"2541\" data-end=\"2566\"><span role=\"text\"><strong data-start=\"2543\" data-end=\"2566\">DAY 2 &ndash; Final Round<\/strong><\/span><\/p>\n<p dir=\"auto\" data-section-id=\"1netg0\" data-start=\"2567\" data-end=\"2602\"><span role=\"text\"><strong data-start=\"2571\" data-end=\"2602\">4 November 2026 | Wednesday<\/strong><\/span><\/p>\n<p dir=\"auto\" data-start=\"2604\" data-end=\"2670\">The selected <strong data-start=\"2617\" data-end=\"2633\">Top 50 Teams<\/strong> will participate in the Final Round.<\/p>\n<p dir=\"auto\" data-start=\"2672\" data-end=\"2701\">The Final Round will include:<\/p>\n<ul data-start=\"2703\" data-end=\"2797\">\n<li data-section-id=\"91d619\" data-start=\"2703\" data-end=\"2733\">Technical\/Model Presentation<\/li>\n<li data-section-id=\"15l2ckw\" data-start=\"2734\" data-end=\"2753\">Expert Evaluation<\/li>\n<li data-section-id=\"cvdb4j\" data-start=\"2754\" data-end=\"2776\">Winners Announcement<\/li>\n<li data-section-id=\"1isrhuu\" data-start=\"2777\" data-end=\"2797\">Prize Distribution<\/li>\n<\/ul>\n<h3 dir=\"auto\" data-section-id=\"2os5mc\" data-start=\"2799\" data-end=\"2850\"><span role=\"text\"><strong data-start=\"2803\" data-end=\"2850\">Final Round Registration Fee: \u20b9200 per Team<\/strong><\/span><\/h3>\n<p dir=\"auto\" data-start=\"2852\" data-end=\"2945\"><strong data-start=\"2852\" data-end=\"2945\">Applicable only to the Top 50 Teams selected from the Screening Round on 3 November 2026.<\/strong><\/p>\n<p dir=\"auto\" data-section-id=\"1lonneg\" data-start=\"2952\" data-end=\"2965\"><strong>Cash Prizes<\/strong><\/p>\n<ul>\n<li dir=\"auto\" data-start=\"2967\" data-end=\"2997\"><strong data-start=\"2970\" data-end=\"2997\">First Prize &ndash; \u20b911,000\/-<\/strong><\/li>\n<li dir=\"auto\" data-start=\"2999\" data-end=\"3029\"><strong data-start=\"3002\" data-end=\"3029\">Second Prize &ndash; \u20b97,100\/-<\/strong><\/li>\n<li dir=\"auto\" data-start=\"3031\" data-end=\"3060\"><strong data-start=\"3034\" data-end=\"3060\">Third Prize &ndash; \u20b95,100\/-<\/strong><\/li>\n<\/ul>\n<p dir=\"auto\" data-start=\"3062\" data-end=\"3135\"><strong data-start=\"3062\" data-end=\"3135\">Participation Certificates will be provided to eligible participants.<\/strong><\/p>\n<p dir=\"auto\" data-section-id=\"1bqljif\" data-start=\"3142\" data-end=\"3159\"><strong>Important Dates<\/strong><\/p>\n<ul>\n<li dir=\"auto\" data-start=\"3161\" data-end=\"3198\"><strong data-start=\"3164\" data-end=\"3180\">Event Dates:<\/strong> 3&ndash;4 November 2026<\/li>\n<li dir=\"auto\" data-start=\"3200\" data-end=\"3254\"><strong data-start=\"3203\" data-end=\"3234\">Last Date for Registration:<\/strong> <strong data-start=\"3235\" data-end=\"3254\">28 October 2026<\/strong><\/li>\n<\/ul>\n<p dir=\"auto\" data-section-id=\"1w306ah\" data-start=\"3256\" data-end=\"3279\"><strong><span role=\"text\">3 November 2026<\/span><\/strong><\/p>\n<ul>\n<li dir=\"auto\" data-start=\"3280\" data-end=\"3385\"><strong data-start=\"3280\" data-end=\"3315\">Screening Round &ndash; Physical Mode<\/strong><\/li>\n<li dir=\"auto\" data-start=\"3280\" data-end=\"3385\">Idea (PPT) \/ Technical Model Presentation<\/li>\n<li dir=\"auto\" data-start=\"3280\" data-end=\"3385\"><strong data-start=\"3362\" data-end=\"3385\">No Registration Fee<\/strong><\/li>\n<\/ul>\n<p dir=\"auto\" data-section-id=\"1bs2xr2\" data-start=\"3387\" data-end=\"3410\"><strong><span role=\"text\">4 November 2026<\/span><\/strong><\/p>\n<ul>\n<li dir=\"auto\" data-start=\"3411\" data-end=\"3517\"><strong data-start=\"3411\" data-end=\"3426\">Final Round<\/strong><\/li>\n<li dir=\"auto\" data-start=\"3411\" data-end=\"3517\">Top 50 Teams Presentation<\/li>\n<li dir=\"auto\" data-start=\"3411\" data-end=\"3517\"><strong data-start=\"3457\" data-end=\"3517\">\u20b9200 per Team &ndash; applicable only to selected Top 50 Teams<\/strong><\/li>\n<\/ul>\n<p dir=\"auto\" data-section-id=\"1k4lrtk\" data-start=\"3524\" data-end=\"3545\"><strong>Competition Process<\/strong><\/p>\n<p dir=\"auto\" data-section-id=\"1asc813\" data-start=\"3547\" data-end=\"3576\"><span role=\"text\"><strong data-start=\"3551\" data-end=\"3576\">Step 1 &ndash; Registration<\/strong><\/span><\/p>\n<ul>\n<li dir=\"auto\" data-start=\"3577\" data-end=\"3614\">Register your team for TECHYUVA 11.0.<\/li>\n<\/ul>\n<p dir=\"auto\" data-section-id=\"102ri4o\" data-start=\"3616\" data-end=\"3656\"><span role=\"text\"><strong data-start=\"3620\" data-end=\"3656\">Step 2 &ndash; Prepare Your Innovation<\/strong><\/span><\/p>\n<ul>\n<li dir=\"auto\" data-start=\"3657\" data-end=\"3734\">Develop your innovative idea, technical model, prototype or working solution.<\/li>\n<\/ul>\n<p dir=\"auto\" data-section-id=\"i1x2d6\" data-start=\"3736\" data-end=\"3768\"><span role=\"text\"><strong data-start=\"3740\" data-end=\"3768\">Step 3 &ndash; Screening Round<\/strong><\/span><\/p>\n<ul>\n<li dir=\"auto\" data-start=\"3769\" data-end=\"3855\">Present your idea\/model physically before the evaluation panel on <strong data-start=\"3835\" data-end=\"3854\">3 November 2026<\/strong>.<\/li>\n<\/ul>\n<p dir=\"auto\" data-section-id=\"101nxst\" data-start=\"3857\" data-end=\"3890\"><span role=\"text\"><strong data-start=\"3861\" data-end=\"3890\">Step 4 &ndash; Top 50 Selection<\/strong><\/span><\/p>\n<ul>\n<li dir=\"auto\" data-start=\"3891\" data-end=\"3952\">The <strong data-start=\"3895\" data-end=\"3911\">Top 50 Teams<\/strong> will be shortlisted for the Final Round.<\/li>\n<\/ul>\n<p dir=\"auto\" data-section-id=\"txkfk8\" data-start=\"3954\" data-end=\"3989\"><span role=\"text\"><strong data-start=\"3958\" data-end=\"3989\">Step 5 &ndash; Final Presentation<\/strong><\/span><\/p>\n<ul>\n<li dir=\"auto\" data-start=\"3990\" data-end=\"4059\">Selected teams will present their innovations on <strong data-start=\"4039\" data-end=\"4058\">4 November 2026<\/strong>.<\/li>\n<\/ul>\n<p dir=\"auto\" data-section-id=\"icb7oq\" data-start=\"4061\" data-end=\"4098\"><span role=\"text\"><strong data-start=\"4065\" data-end=\"4098\">Step 6 &ndash; Winners Announcement<\/strong><\/span><\/p>\n<ul>\n<li dir=\"auto\" data-start=\"4099\" data-end=\"4160\">The top three teams will receive cash prizes and recognition.<\/li>\n<\/ul>\n<p dir=\"auto\" data-section-id=\"19mpi3w\" data-start=\"4510\" data-end=\"4538\"><strong>General Rules &amp; Guidelines<\/strong><\/p>\n<ol data-start=\"4540\" data-end=\"5512\">\n<li data-section-id=\"tsc5mu\" data-start=\"4540\" data-end=\"4639\">The project\/model\/idea presented should be <strong data-start=\"4586\" data-end=\"4638\">original and developed by the participating team<\/strong>.<\/li>\n<li data-section-id=\"sdcz3y\" data-start=\"4640\" data-end=\"4761\">Participants must bring their required <strong data-start=\"4682\" data-end=\"4727\">model\/prototype and presentation material<\/strong> for the physical Screening Round.<\/li>\n<li data-section-id=\"17q5m7r\" data-start=\"4762\" data-end=\"4883\">Participants are responsible for arranging and carrying their own <strong data-start=\"4831\" data-end=\"4882\">project\/model, equipment and required materials<\/strong>.<\/li>\n<li data-section-id=\"1wl5x01\" data-start=\"4884\" data-end=\"4958\">Teams must be physically present at the venue for the respective round.<\/li>\n<li data-section-id=\"vugc28\" data-start=\"4959\" data-end=\"5061\">Only the <strong data-start=\"4971\" data-end=\"5023\">Top 50 teams selected during the Screening Round<\/strong> will be eligible for the Final Round.<\/li>\n<li data-section-id=\"ifacr4\" data-start=\"5062\" data-end=\"5155\">The <strong data-start=\"5069\" data-end=\"5106\">\u20b9200 Final Round registration fee<\/strong> is applicable only to the selected Top 50 teams.<\/li>\n<li data-section-id=\"11j7jjf\" data-start=\"5156\" data-end=\"5251\">The decision of the evaluation panel regarding selection, ranking and prizes shall be final.<\/li>\n<li data-section-id=\"9wcmsu\" data-start=\"5252\" data-end=\"5330\">The organizers reserve the right to modify the event schedule, if required.<\/li>\n<li data-section-id=\"y9vvj\" data-start=\"5331\" data-end=\"5403\">Participation certificates will be provided to eligible participants.<\/li>\n<li data-section-id=\"yckd6b\" data-start=\"5404\" data-end=\"5512\">Teams qualifying for the Final Round must be physically present at the venue for the final presentation.<\/li>\n<\/ol>\n<p dir=\"auto\" data-section-id=\"ba6az\" data-start=\"5519\" data-end=\"5526\"><strong>Venue<\/strong><\/p>\n<ul>\n<li dir=\"auto\" data-start=\"5528\" data-end=\"5633\"><strong data-start=\"5528\" data-end=\"5573\">Buddha Institute of Technology, Gorakhpur<\/strong><br data-start=\"5573\" data-end=\"5576\" \/>CL-1, Sector-7, GIDA, Gorakhpur,<br data-start=\"5608\" data-end=\"5611\" \/>Uttar Pradesh &ndash; 273209<\/li>\n<\/ul>\n<p dir=\"auto\" data-section-id=\"tfpd16\" data-start=\"5640\" data-end=\"5654\"><strong>Organized By<\/strong><\/p>\n<ul>\n<li dir=\"auto\" data-section-id=\"1qd92ml\" data-start=\"5656\" data-end=\"5695\"><span role=\"text\"><strong data-start=\"5660\" data-end=\"5695\">Buddha Innovation Council (BIC)<\/strong><\/span><\/li>\n<li dir=\"auto\" data-start=\"5696\" data-end=\"5760\"><strong data-start=\"5696\" data-end=\"5760\">Incubation Unit of Buddha Institute of Technology, Gorakhpur<\/strong><\/li>\n<li dir=\"auto\" data-section-id=\"bj23ps\" data-start=\"5762\" data-end=\"5776\">Sponsored By<\/li>\n<li dir=\"auto\" data-section-id=\"x5khlr\" data-start=\"5778\" data-end=\"5805\"><span role=\"text\"><strong data-start=\"5782\" data-end=\"5805\">AKTU Innovation Hub<\/strong><\/span><\/li>\n<li dir=\"auto\" data-start=\"5806\" data-end=\"5862\"><strong data-start=\"5806\" data-end=\"5862\">Dr. A.P.J. Abdul Kalam Technical University, Lucknow<\/strong><\/li>\n<\/ul>","overall_prizes":null,"regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":30452242,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-03T19:48:15+05:30","updated_at":"2026-10-04T16:23:47+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"ftPX1eM","hashtags":null,"participation_certificate":0,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":2,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":2,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-03 20:08:08","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/uploadedManual-6ac1117d5f5ac_whatsapp_image_2026-09-20_at_12_05_11_pm.jpeg","logoUrl2":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/150x150\/uploadedManual-6ac1117d5f5ac_whatsapp_image_2026-09-20_at_12_05_11_pm.jpeg","regnRequirements":{"id":2497034,"