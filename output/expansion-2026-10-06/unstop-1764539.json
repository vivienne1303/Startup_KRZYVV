{"data":{"status":true,"competition":{"id":1764539,"visibility":"public","theme_colour":"red-dark_un","paid":0,"title":"Ideas In Ink - The EcoBuzz Economics Challenge","festival_id":null,"organization_id":106349,"web_url":null,"start_date":"2026-10-01T00:00:00+05:30","end_date":"2026-10-20T23:59:00+05:30","location":null,"type":"competitions","public_url":"competitions\/ideas-in-ink-the-ecobuzz-economics-challenge-gargi-college-delhi-university-delhi-1764539","region":"online","details":"<p><strong>Overview<\/strong><\/p>\n<p>The EcoBuzz Economics Challenge<\/p>\n<p>Ideas in Ink is an online writing competition by EcoBuzz-Economics Magazine of the Department of Economics, Gargi College, inviting college students to explore economics through creativity, critical thinking, and everyday observations.<\/p>\n<p><strong>Categories:<\/strong><\/p>\n<ul>\n<li>Economics in Fiction: Explore an economic concept through a fictional world from a movie, series, book, or game. Example: Monopoly in Willy Wonka. Format: 800&ndash;1,200 words | PDF<\/li>\n<li>One Page, One Book: Distill the key ideas of an economics or economics-related book into one creative page using text, diagrams, flowcharts or mind maps. Example: The Psychology of Money. Format: 1 page | PDF\/JPG\/PNG<\/li>\n<li>The Student Economic Voice: Write an opinion piece responding to an economic question, issue or debate of your choice. Example: Is AI more likely to create jobs or destroy them? Format: 500&ndash;1,000 words | PDF<\/li>\n<li>Economics Through the Lens: Capture an everyday moment that tells an economic story without saying a word, accompanied by a 50-word explanation. Format: 1 photograph + 50-word explanation | JPG\/PNG + PDF<\/li>\n<\/ul>\n<p><strong>Rules &amp; Guidelines:<\/strong><\/p>\n<ul>\n<li>Open to all college students.<\/li>\n<li>The competition is entirely online.<\/li>\n<li>Participants may enter one, multiple, or all four categories of their choice.<\/li>\n<li>All submissions must be original and unpublished.<\/li>\n<li>Plagiarism will result in disqualification.<\/li>\n<li>Use of AI-generated content is strictly prohibited.<\/li>\n<li>External sources may be used for research, but proper references and citations must be provided wherever applicable.<\/li>\n<li>Participants must adhere to the specified word\/page limits and submission formats.<\/li>\n<li>The decision of the judging panel will be final.<\/li>\n<\/ul>\n<p><strong>Recognition:<\/strong><\/p>\n<ul>\n<li>Top entries in each category will receive e-certificates.<\/li>\n<li>Selected top entries will be published in the EcoBuzz 2026&ndash;27 Edition.<\/li>\n<\/ul>\n<p><strong>Important Details:<\/strong><\/p>\n<ul>\n<li>Final Submission Deadline: 20 October 2026<\/li>\n<li>Mode: Online submission through Unstop<\/li>\n<li>Eligibility: College students<\/li>\n<\/ul>\n<p>Put your ideas on paper. Leave your mark in ink.<\/p>","overall_prizes":"E-certificates ","regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":4177795,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-01T21:55:57+05:30","updated_at":"2026-10-02T00:24:36+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"t46niEm","hashtags":null,"participation_certificate":1,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":null,"checked":null,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":94,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-01 23:22:57","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"cl