{"data":{"status":true,"competition":{"id":1764670,"visibility":"public","theme_colour":"pink_un","paid":0,"title":"Flow in Flux","festival_id":520805,"organization_id":967,"web_url":null,"start_date":"2026-10-02T00:00:00+05:30","end_date":"2026-10-18T09:00:00+05:30","location":null,"type":"competitions","public_url":"competitions\/flow-in-flux-shunya-2026-netaji-subhas-university-of-technology-nsut-delhi-1764670","region":"online","details":"<p><strong>Flowinflux:<\/strong><\/p>\n<p><strong>Design. Create. Compete. Survive the night.<\/strong><\/p>\n<p>Get ready for <strong>FLOWINFLUX<\/strong>, the flagship 24-hour Designathon at <strong>SHUNYA 2026<\/strong>, hosted by <strong>GDG NSUT<\/strong>.<\/p>\n<p>1 Problem statement, 4 design track options, choose your design domain!<\/p>\n<p>Put your creativity, problem-solving, and design skills to the ultimate test across:<\/p>\n<ul>\n<li>UI\/UX Design<\/li>\n<li>Branding &amp; Visual Identity<\/li>\n<li>Game Design<\/li>\n<li>Product Design<\/li>\n<\/ul>\n<p><strong>The 24-Hour Design Sprint:<\/strong><\/p>\n<p>Take your ideas from an initial concept to a complete, polished design within 24 hours.<\/p>\n<p>Work with your team, explore your chosen design direction, refine every detail, and build something that stands out. The challenge isn't just about making something that looks good. It's about creating an experience that is thoughtful, functional, original, and memorable.<\/p>\n<p>The competition continues overnight on campus, giving you the time and space to push your ideas further, experiment with different approaches, and turn your concepts into something you're proud to present.<\/p>\n<p>At the end of the challenge, present your work in front of the judges and compete for the top spot.<\/p>\n<p>Projects will be evaluated on <strong>creativity, design quality, originality, execution, problem-solving, and presentation.<\/strong><\/p>\n<p><strong>24 hours. One design challenge. Endless possibilities.<\/strong><\/p>\n<p>Are you ready to FLOW into the INFLUX?<\/p>\n<p><strong>Event Details:<\/strong><\/p>\n<ul>\n<li>Venue: NSUT, New Delhi<\/li>\n<li>Duration: 24 Hours<\/li>\n<li>Tracks: UI\/UX Design &bull; Branding &bull; Game Design &bull; Product Design<\/li>\n<li>Date: 17-18 October 2026<\/li>\n<li>Team Size: 1-3 participants<\/li>\n<li>Eligibility: Open to all college students<\/li>\n<\/ul>\n<p>Register now and bring your best ideas to <strong>FLOWINFLUX at SHUNYA 2026<\/strong>.<\/p>","overall_prizes":"Prizes will consists of cash prize + vouchers + goodies","regn_open":1,"regn_type":1,"regn_url":null,"regn_email":"","registration_clicks":0,"user_id":26779957,"moderation_status":1,"overall_leaderboard":0,"reject_reason":null,"display_date":null,"created_at":"2026-10-02T08:19:37+05:30","updated_at":"2026-10-05T11:11:04+05:30","communication_sent":null,"certificate_at":null,"remarks":null,"branding":0,"disable_auto_rounds":null,"certificate_config":null,"subtype":"general_competition","combined_leaderboard":null,"source":null,"short_id":"yPLrAXd","hashtags":null,"participation_certificate":1,"winner_certificate_at":null,"listed":1,"self_moderated":2,"prizes_release_days":30,"checked":null,"display_title":null,"show_discussions_only_user":1,"show_reviews_only_user":1,"show_score_card":0,"players_count":31,"referral_leaderboard_show":0,"is_ad_free":0,"enable_gamify_leaderboard":0,"tpo_college_id":null,"publish_at":"2026-10-02 08:24:36","auto_shortlist_trigger":false,"enable_ai_discussion":false,"total_unlock_teams":0,"enable_hiring_automation":false,"auto_send_participation_certificate":true,"closed_at":null,"linkedInEventId":"","teams":[],"players":[],"logoUrl":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/75x75\/uploadedManual-6ac11d31c56e4_fnf_logo_1.jpg","logoUrl2":"https:\/\/d8it4huxumps7.cloudfront.net\/uploads\/images\/150x150\/uploadedManual-6ac11d31c56e4_fnf_logo_1.jpg","regnRequirements":{"id":2496293,"opportunity_id":1764670,"festival_id":null,"max_tea